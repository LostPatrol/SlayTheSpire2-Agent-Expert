diff --git a/STS2AIAgent/Game/GameStateService.PowerRulesText.cs b/STS2AIAgent/Game/GameStateService.PowerRulesText.cs
new file mode 100644
index 0000000..7ac970f
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.PowerRulesText.cs
@@ -0,0 +1,49 @@
+// Format applied Power rules through the native live tooltip rather than static defaults.
+using System.Text.RegularExpressions;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    // Residual selectors include SmartFormat suffixes such as {Amount:abs()}.
+    private static readonly Regex UnresolvedPowerVariable = new(
+        @"\{([A-Za-z_][A-Za-z0-9_]*)(?=[:.}\[])", RegexOptions.Compiled);
+
+    /// <summary>Keep the existing restriction-text consumer on the same live rules path.</summary>
+    private static string? GetPowerRulesText(PowerModel power)
+    {
+        return GetPowerRulesDetails(power).Text;
+    }
+
+    /// <summary>Bind public instance variables; keep raw text and explicit incompleteness on failure.</summary>
+    private static (string? Text, bool Complete, string[] UnresolvedVariables) GetPowerRulesDetails(PowerModel power)
+    {
+        string? text = null;
+        var complete = false;
+        try
+        {
+            // Native SmartDescription selects the template but does not bind its variables.
+            var localized = power.HasSmartDescription ? power.SmartDescription : power.Description;
+            text = localized.GetRawText();
+            power.DynamicVars.AddTo(localized);
+            localized.Add("Amount", power.Amount);
+            if (power.Owner != null) localized.Add("OwnerName", power.Owner.Name);
+            var formatted = localized.GetFormattedText();
+            if (!string.IsNullOrWhiteSpace(formatted))
+            {
+                text = formatted;
+                // Native formatting can return the unresolved template without throwing.
+                complete = !text.Contains('{') && !text.Contains('}');
+            }
+        }
+        catch (Exception)
+        {
+            // Tooltip failure must not stop observation or turn missing parameters into defaults.
+        }
+        if (string.IsNullOrWhiteSpace(text)) text = null;
+        var unresolved = UnresolvedPowerVariable.Matches(text ?? string.Empty)
+            .Select(match => match.Groups[1].Value).Distinct(StringComparer.Ordinal).ToArray();
+        return (text, complete, unresolved);
+    }
