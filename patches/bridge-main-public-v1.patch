+                  "enchantment":{"enchantment_id":"SWIFT","name":"Swift","description":"Draw 1 card.",
+                    "amount":1,"display_amount":1,"hidden_instance":99},
+                  "unplayable_reason_text":"Bound: You can only play 1 Bound card each turn.",
+                  "unplayable_preventer_type":"Hidden.InternalType"}]
+                """);
