--- /dev/null
+++ b/STS2AIAgent/Game/NativeDrawKnowledgeObserver.cs
@@ -0,0 +1,469 @@
+// Track rule-derived draw knowledge from native public commands without reading hidden order.
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Hooks;
+using MegaCrit.Sts2.Core.Logging;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2AIAgent.Game;
+
+internal static class NativeDrawKnowledgeObserver
+{
+    // Keys follow the native combat lifetime, not the player's longer run lifetime.
+    private static readonly ConditionalWeakTable<object, Knowledge> States = new();
+    // Native async Add overloads may nest; tickets prevent a completed call clearing a newer one.
+    private static readonly ConditionalWeakTable<CardModel, Addition> Additions = new();
+    // Task completions can release tickets from a pool thread while native callbacks use the game thread.
+    private static readonly object Gate = new();
+    // Initialization is idempotent; an incomplete hook set never produces a certificate.
+    private static int _installed;
+    private static bool _hooksComplete;
+
+    /// <summary>Copy only event-derived bands; members of each band remain unordered.</summary>
+    internal sealed record Snapshot(bool Available, string? Reason, string? Kind,
+        CardModel[][] Bands, CardModel[] Inserted, CardModel[][] DiscardBands);
+
+    /// <summary>Retain references for membership only; no native hidden sequence is copied.</summary>
+    private sealed class Knowledge
+    {
+        internal bool Available;
+        internal string? Reason = "shuffle_not_observed";
+        internal string? Kind;
+        internal readonly HashSet<CardModel> Draw = new();
+        internal readonly List<List<CardModel>> Bands = new();
+        internal readonly HashSet<CardModel> Inserted = new();
+        internal readonly List<List<CardModel>> Discard = new();
+        internal readonly HashSet<CardModel> ShuffleIncoming = new();
+        internal readonly Dictionary<CardModel, Departure> PendingDepartures = new();
+        internal int ActiveOperations;
+        internal bool RandomizePending;
+        internal bool ShuffleInFlight;
+    }
+
+    /// <summary>Bind one actual Add invocation to its declared public insertion mode.</summary>
+    private sealed record Addition(CardModel Card, CardPilePosition Position, Knowledge? Owner, bool SequenceVisible);
+
+    /// <summary>A specific removal needs its own native draw event; another card's draw cannot certify it.</summary>
+    private sealed class Departure(bool topCompatible)
+    {
+        internal readonly bool TopCompatible = topCompatible;
+        internal bool HandTransitionObserved;
+        internal bool Ambiguous;
+    }
+
+    /// <summary>Install passive hooks once; partial installation is explicitly unavailable.</summary>
+    internal static void Initialize()
+    {
+        if (Interlocked.Exchange(ref _installed, 1) != 0) return;
+        try
+        {
+            var harmony = new Harmony("STS2AIAgent.NativeDrawKnowledgeObserver");
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.ModifyShuffleOrder))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeShuffle)));
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.AfterShuffle))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterShuffle)));
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.AfterCardChangedPiles))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(ChangedPiles)));
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.AfterCardDrawn))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(CardDrawn)));
+            harmony.Patch(typeof(CardPileCmd).GetMethod(nameof(CardPileCmd.Shuffle))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeShuffleCommand)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterShuffleCommand)));
+            foreach (var method in typeof(CardPileCmd).GetMethods(BindingFlags.Public | BindingFlags.Static)
+                         .Where(method => method.Name == nameof(CardPileCmd.Add)))
+                harmony.Patch(method, prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeAdd)),
+                    postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterAdd)));
+            harmony.Patch(typeof(CardPile).GetMethod(nameof(CardPile.RemoveInternal))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeRemove)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterSynchronousOperation)));
+            harmony.Patch(typeof(CardPile).GetMethod(nameof(CardPile.AddInternal))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeInternalAdd)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterSynchronousOperation)));
+            harmony.Patch(typeof(CardPile).GetMethod(nameof(CardPile.MoveToTopInternal))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeFixedMove)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterFixedMove)));
+            harmony.Patch(typeof(CardPile).GetMethod(nameof(CardPile.MoveToBottomInternal))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeFixedMove)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterFixedMove)));
+            harmony.Patch(typeof(CardPile).GetMethod(nameof(CardPile.RandomizeOrderInternal))!,
+                prefix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(BeforeRandomize)),
+                postfix: new HarmonyMethod(typeof(NativeDrawKnowledgeObserver), nameof(AfterRandomize)));
+            _hooksComplete = true;
+        }
+        catch (Exception error)
+        {
+            Log.Warn($"[STS2AIAgent] Public draw knowledge unavailable: {error.GetType().Name}");
+        }
+    }
+
+    /// <summary>Read membership equality as a coverage check, never using a pile's sequence.</summary>
+    internal static Snapshot Read(Player? player)
+    {
+        lock (Gate)
+        {
+            if (!_hooksComplete || player?.PlayerCombatState is not { } combat)
+                return new(false, "observer_unavailable", null, [], [], []);
+            var state = States.GetValue(combat, _ => new Knowledge());
+            if (state.ShuffleInFlight)
+                return new(false, "native_pile_operation_in_progress", state.Kind, [], [], []);
+            if (state.RandomizePending)
+                return new(false, "randomize_without_observed_rule_hook", state.Kind, [], [], []);
+            if (state.PendingDepartures.Count > 0)
+                return new(false, "draw_departure_not_classified", state.Kind, [], [], []);
+            var drawMatches = state.Draw.SetEquals(combat.DrawPile.Cards);
+            var discardMatches = state.Discard.SelectMany(band => band).ToHashSet().SetEquals(combat.DiscardPile.Cards);
+            if ((!drawMatches || !discardMatches) && state.ActiveOperations > 0)
+                return new(false, "native_pile_operation_in_progress", state.Kind, [], [], []);
+            if (!drawMatches) Invalidate(state, "unobserved_draw_membership_change");
+            if (!discardMatches)
+                Invalidate(state, "unobserved_discard_membership_change");
+            var ranked = state.Bands.SelectMany(band => band).ToArray();
+            var discarded = state.Discard.SelectMany(band => band).ToArray();
+            if (ranked.Distinct().Count() != ranked.Length || ranked.Any(card => !state.Draw.Contains(card))
+                || state.Inserted.Any(card => !state.Draw.Contains(card) || ranked.Contains(card))
+                || discarded.Length != combat.DiscardPile.Cards.Count)
+                Invalidate(state, "observed_band_membership_inconsistent");
+            return new(state.Available, state.Reason, state.Kind,
+                state.Available ? state.Bands.Select(band => band.ToArray()).ToArray() : [],
+                state.Available ? state.Inserted.ToArray() : [],
+                state.Available ? state.Discard.Select(band => band.ToArray()).ToArray() : []);
+        }
+    }
+
+    /// <summary>Derive receiver bands from witnessed chronology, ignoring the supplied shuffled list order.</summary>
+    private static void BeforeShuffle(object[] __args)
+    {
+        try
+        {
+            var player = __args.OfType<Player>().Single();
+            var cards = __args.OfType<List<CardModel>>().Single();
+            var initial = __args.OfType<bool>().Single();
+            if (player.PlayerCombatState is not { } combat) return;
+            lock (Gate)
+            {
+                var state = States.GetValue(combat, _ => new Knowledge());
+                state.RandomizePending = false;
+                var draw = combat.DrawPile.Cards.ToHashSet();
+                var discard = combat.DiscardPile.Cards.ToHashSet();
+                var pool = cards.ToHashSet();
+                var receivers = new List<List<CardModel>>();
+                var covered = new HashSet<CardModel>();
+                if (!initial && state.Available && state.PendingDepartures.Count == 0 && state.Draw.SetEquals(draw)
+                    && state.Discard.SelectMany(band => band).ToHashSet().SetEquals(discard)
+                    && !state.Inserted.Any(IsPerfectFit))
+                {
+                    foreach (var band in state.Bands)
+                    {
+                        var members = band.Where(card => draw.Contains(card) && IsPerfectFit(card)).ToList();
+                        if (members.Count > 0) { receivers.Add(members); covered.UnionWith(members); }
+                    }
+                    var unknown = draw.Where(card => IsPerfectFit(card) && !covered.Contains(card)).ToList();
+                    if (unknown.Count > 0) receivers.Add(unknown);
+                    receivers.AddRange(state.Discard.Select(band => band.Where(IsPerfectFit).ToList())
+                        .Where(band => band.Count > 0));
+                }
+                else if (!initial && (draw.Count != 0 || discard.Any(IsPerfectFit)))
+                {
+                    Invalidate(state, "shuffle_receiver_order_unwitnessed");
+                    return;
+                }
+                state.Draw.Clear(); state.Draw.UnionWith(pool);
+                state.Bands.Clear(); state.Inserted.Clear(); state.Discard.Clear();
+                state.PendingDepartures.Clear(); state.ShuffleInFlight = true;
+                state.ShuffleIncoming.Clear(); state.ShuffleIncoming.UnionWith(discard);
+                if (!initial)
+                {
+                    receivers.Reverse();
+                    state.Bands.AddRange(receivers.Select(band => band.Where(pool.Contains).ToList()).Where(band => band.Count > 0));
+                }
+                state.Available = true; state.Reason = null;
+                state.Kind = initial ? "initial_shuffle" : "combat_reshuffle";
+            }
+        }
+        catch { _hooksComplete = false; /* Never retain a stale certificate after an observer failure. */ }
+    }
+
+    /// <summary>End the declared shuffle transfer window before later ordinary insertions.</summary>
+    private static void AfterShuffle(object[] __args)
+    {
+        lock (Gate)
+            if (__args.OfType<Player>().FirstOrDefault()?.PlayerCombatState is { } combat
+                && States.TryGetValue(combat, out var state))
+            { state.ShuffleIncoming.Clear(); state.ShuffleInFlight = false; }
+    }
+
+    /// <summary>Capture the actual Add mode; nested overloads retain the same declared semantic.</summary>
+    private static void BeforeAdd(object[] __args, out Addition[]? __state)
+    {
+        __state = null;
+        var positions = __args.OfType<CardPilePosition>().ToArray();
+        if (positions.Length != 1) return;
+        // Never advance a lazy native iterator; stable indexed batches cover real hand discards.
+        var cards = __args[0] switch
+        {
+            CardModel card => new[] { card },
+            IList<CardModel> list => Enumerable.Range(0, list.Count).Select(index => list[index]).ToArray(),
+            _ => Array.Empty<CardModel>()
+        };
+        if (cards.Length == 0) return;
+        var sequenceVisible = cards.Length == 1 || cards.All(card => card.Pile?.Type is PileType.Hand or PileType.Play);
+        lock (Gate)
+        {
+            __state = cards.Select(card =>
+            {
+                var owner = card.Owner?.PlayerCombatState is { } combat ? States.GetValue(combat, _ => new Knowledge()) : null;
+                if (owner != null) owner.ActiveOperations++;
+                var ticket = new Addition(card, positions[0], owner, sequenceVisible);
+                Additions.Remove(card); Additions.Add(card, ticket);
+                return ticket;
+            }).ToArray();
+        }
+    }
+
+    /// <summary>Clear only this completed command's ticket, without awaiting or replacing its native Task.</summary>
+    private static void AfterAdd(Task __result, Addition[]? __state)
+    {
+        if (__state == null) return;
+        var tickets = __state;
+        _ = __result.ContinueWith(_ =>
+        {
+            lock (Gate)
+            {
+                foreach (var ticket in tickets)
+                {
+                    if (ticket.Owner != null) ticket.Owner.ActiveOperations--;
+                    if (Additions.TryGetValue(ticket.Card, out var current) && ReferenceEquals(current, ticket))
+                        Additions.Remove(ticket.Card);
+                }
+            }
+        }, CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default);
+    }
+
+    /// <summary>Record a reorder boundary, requiring a subsequent real rule hook before certification.</summary>
+    private static void BeforeRandomize(CardPile __instance, Player player, out Knowledge? __state)
+    {
+        __state = null;
+        lock (Gate)
+            if (__instance.Type == PileType.Draw && player.PlayerCombatState is { } combat)
+            {
+                __state = States.GetValue(combat, _ => new Knowledge());
+                __state.RandomizePending = true; __state.ShuffleInFlight = true; __state.ActiveOperations++;
+            }
+    }
+
+    /// <summary>The public synchronous reorder return commits the hook result, including initial shuffle.</summary>
+    private static void AfterRandomize(Knowledge? __state)
+    {
+        if (__state != null) lock (Gate)
+        { __state.ShuffleInFlight = false; __state.ActiveOperations--; }
+    }
+
+    /// <summary>Remove memberships at the lowest public removal API, even when no command hook follows.</summary>
+    private static void BeforeRemove(CardPile __instance, CardModel card, out Knowledge? __state)
+    {
+        __state = null;
+        lock (Gate)
+        {
+            if (card.Owner?.PlayerCombatState is not { } combat) return;
+            var state = States.GetValue(combat, _ => new Knowledge());
+            __state = state; state.ActiveOperations++;
+            if (__instance.Type == PileType.Draw)
+                DepartDraw(state, card);
+            else if (state.PendingDepartures.TryGetValue(card, out var departure)) departure.Ambiguous = true;
+            if (__instance.Type == PileType.Discard) Remove(state.Discard, card);
+        }
+    }
+
+    /// <summary>Never interpret a low-level index as public knowledge of a random insertion slot.</summary>
+    private static void BeforeInternalAdd(CardPile __instance, CardModel card, out Knowledge? __state)
+    {
+        __state = null;
+        lock (Gate)
+        {
+            if (__instance.Type is not (PileType.Draw or PileType.Discard)
+                || card.Owner?.PlayerCombatState is not { } combat) return;
+            var state = States.GetValue(combat, _ => new Knowledge());
+            __state = state; state.ActiveOperations++;
+            if (!Additions.TryGetValue(card, out _) && !state.ShuffleIncoming.Contains(card))
+                Invalidate(state, "low_level_insertion_mode_unobserved");
+        }
+    }
+
+    /// <summary>Bind a direct fixed move to its explicit API semantic, not a physical index.</summary>
+    private static void BeforeFixedMove(CardModel card, MethodBase __originalMethod, out Addition? __state)
+    {
+        __state = null;
+        lock (Gate)
+        {
+            if (Additions.TryGetValue(card, out _)) return;
+            var owner = card.Owner?.PlayerCombatState is { } combat ? States.GetValue(combat, _ => new Knowledge()) : null;
+            if (owner != null) owner.ActiveOperations++;
+            __state = new Addition(card, __originalMethod.Name == nameof(CardPile.MoveToTopInternal)
+                ? CardPilePosition.Top : CardPilePosition.Bottom, owner, true);
+            Additions.Add(card, __state);
+        }
+    }
+
+    /// <summary>Direct same-pile fixed moves may have no AfterCardChangedPiles callback.</summary>
+    private static void AfterFixedMove(CardPile __instance, CardModel card, MethodBase __originalMethod, Addition? __state)
+    {
+        lock (Gate)
+        {
+            if (card.Owner?.PlayerCombatState is { } combat)
+            {
+                var state = States.GetValue(combat, _ => new Knowledge());
+                var top = __originalMethod.Name == nameof(CardPile.MoveToTopInternal);
+                if (__instance.Type == PileType.Draw)
+                {
+                    if (state.Inserted.Count > 0) Invalidate(state, "fixed_insertion_after_random_insertion");
+                    state.Inserted.Remove(card); Remove(state.Bands, card); state.Draw.Add(card);
+                    InsertFixed(state, card, top);
+                }
+                if (__instance.Type == PileType.Discard)
+                {
+                    Remove(state.Discard, card);
+                    if (top) state.Discard.Insert(0, new List<CardModel> { card });
+                    else state.Discard.Add(new List<CardModel> { card });
+                }
+            }
+            if (__state != null && Additions.TryGetValue(card, out var current) && ReferenceEquals(current, __state))
+                Additions.Remove(card);
+            if (__state?.Owner is { } owner) owner.ActiveOperations--;
+        }
+    }
+
+    /// <summary>Guard intermediate shuffle reads; this scope never classifies a card as a top draw.</summary>
+    private static void BeforeShuffleCommand(Player player, out Knowledge? __state)
+    {
+        __state = null;
+        lock (Gate)
+            if (player.PlayerCombatState is { } combat)
+            { __state = States.GetValue(combat, _ => new Knowledge()); __state.ActiveOperations++; }
+    }
+
+    /// <summary>Release the passive shuffle scope after its real native task completes.</summary>
+    private static void AfterShuffleCommand(Task __result, Knowledge? __state)
+    {
+        if (__state == null) return;
+        var state = __state;
+        _ = __result.ContinueWith(_ => { lock (Gate) state.ActiveOperations--; },
+            CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default);
+    }
+
+    /// <summary>Finish a low-level synchronous observation window without changing native behavior.</summary>
+    private static void AfterSynchronousOperation(Knowledge? __state)
+    {
+        if (__state != null) lock (Gate) __state.ActiveOperations--;
+    }
+
+    /// <summary>Defer random-insertion posterior classification until this exact card's draw event arrives.</summary>
+    private static void DepartDraw(Knowledge state, CardModel card)
+    {
+        if (!state.Draw.Contains(card)) return;
+        if (state.Inserted.Count > 0)
+        {
+            if (state.PendingDepartures.TryGetValue(card, out var previous)) previous.Ambiguous = true;
+            else state.PendingDepartures.Add(card, new Departure(state.Inserted.Contains(card)
+                || state.Bands.Count == 0 || state.Bands[0].Contains(card)));
+        }
+        state.Draw.Remove(card); state.Inserted.Remove(card); Remove(state.Bands, card);
+    }
+
+    /// <summary>Only the real per-card native draw event closes a compatible Draw-to-Hand departure.</summary>
+    private static void CardDrawn(CardModel card)
+    {
+        lock (Gate)
+        {
+            if (card.Owner?.PlayerCombatState is not { } combat || !States.TryGetValue(combat, out var state)
+                || !state.PendingDepartures.TryGetValue(card, out var departure)) return;
+            if (!departure.HandTransitionObserved || departure.Ambiguous || card.Pile?.Type != PileType.Hand) return;
+            state.PendingDepartures.Remove(card);
+            if (!departure.TopCompatible) Invalidate(state, "draw_event_violates_certified_band");
+        }
+    }
+
+    /// <summary>Represent fixed positions without assuming an order for the remaining base cards.</summary>
+    private static void InsertFixed(Knowledge state, CardModel card, bool top)
+    {
+        if (top) state.Bands.Insert(0, new List<CardModel> { card });
+        else
+        {
+            var covered = state.Bands.SelectMany(band => band).ToHashSet();
+            var middle = state.Draw.Where(member => member != card && !covered.Contains(member)).ToList();
+            if (middle.Count > 0) state.Bands.Add(middle);
+            state.Bands.Add(new List<CardModel> { card });
+        }
+    }
+
+    /// <summary>Update every actual departure immediately, including a draw followed by return in one action.</summary>
+    private static void ChangedPiles(object[] __args)
+    {
+        try
+        {
+            var card = __args.OfType<CardModel>().Single();
+            var oldPile = __args.OfType<PileType>().Single();
+            if (card.Owner?.PlayerCombatState is not { } combat) return;
+            lock (Gate)
+            {
+                var state = States.GetValue(combat, _ => new Knowledge());
+                var destination = card.Pile?.Type;
+                var mode = Additions.TryGetValue(card, out var addition) ? addition.Position.ToString() : null;
+                if (oldPile == PileType.Draw)
+                {
+                    DepartDraw(state, card);
+                }
+                if (state.PendingDepartures.TryGetValue(card, out var departure))
+                {
+                    if (oldPile == PileType.Draw && destination == PileType.Hand && !departure.HandTransitionObserved)
+                        departure.HandTransitionObserved = true;
+                    else departure.Ambiguous = true;
+                }
+                if (oldPile == PileType.Discard) Remove(state.Discard, card);
+                if (destination == PileType.Draw)
+                {
+                    if (state.ShuffleIncoming.Remove(card)) return;
+                    state.Draw.Add(card);
+                    if (addition?.SequenceVisible == false && mode != "Random")
+                    { Invalidate(state, "batch_source_order_unwitnessed"); return; }
+                    if (mode == "Random") state.Inserted.Add(card);
+                    else if (mode is "Top" or "Bottom")
+                    {
+                        if (state.Inserted.Count > 0) Invalidate(state, "fixed_insertion_after_random_insertion");
+                        InsertFixed(state, card, mode == "Top");
+                    }
+                    else Invalidate(state, "draw_insertion_mode_unobserved");
+                }
+                if (destination == PileType.Discard)
+                {
+                    if (addition?.SequenceVisible == false)
+                    { Invalidate(state, "batch_source_order_unwitnessed"); return; }
+                    if (mode == "Top") state.Discard.Insert(0, new List<CardModel> { card });
+                    else if (mode == "Bottom") state.Discard.Add(new List<CardModel> { card });
+                    else Invalidate(state, "discard_insertion_mode_unobserved");
+                }
+            }
+        }
+        catch { _hooksComplete = false; /* Failure disables only this optional knowledge surface. */ }
+    }
+
+    /// <summary>Remove a real departure from every band before a later return can reuse its old rank.</summary>
+    private static void Remove(List<List<CardModel>> bands, CardModel card)
+    {
+        foreach (var band in bands) band.Remove(card);
+        bands.RemoveAll(band => band.Count == 0);
+    }
+
+    /// <summary>Recognize the public enchantment identity without exposing any hidden order.</summary>
+    private static bool IsPerfectFit(CardModel card) => card.Enchantment?.Id.Entry == "PERFECT_FIT";
+
+    /// <summary>Preserve an honest coverage failure until a subsequently witnessed clean shuffle.</summary>
+    private static void Invalidate(Knowledge state, string reason)
+    {
+        if (state.Available || state.Reason == "shuffle_not_observed") state.Reason = reason;
+        state.Available = false;
+    }
+}
