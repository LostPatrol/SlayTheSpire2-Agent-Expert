new file mode 100644
index 0000000..7405e20
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.SimulationInternal.cs
@@ -0,0 +1,170 @@
+// Synchronize the simulator from native truth using the linked Mentor serializer and legacy private fields.
+// This transport is isolated from the language model's public observation.
+using System.Reflection;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Combat.History.Entries;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Monsters;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Capture public and private lanes synchronously in one game-thread invocation.</summary>
+    public static DecisionSnapshotPayload BuildInternalDecisionSnapshotPayload()
+    {
+        var snapshot = BuildDecisionSnapshotPayload();
+        snapshot.simulation_internal = BuildSimulationInternalPayload();
+        return snapshot;
+    }
+
+    /// <summary>Report partial availability explicitly; never fabricate missing RNG or AI state.</summary>
+    private static object BuildSimulationInternalPayload()
+    {
+        var run = RunManager.Instance.DebugOnlyGetState();
+        var combat = CombatManager.Instance.DebugOnlyGetState();
+        var player = GetLocalPlayer(run);
+        var availability = new Dictionary<string, string>();
+        var unavailable = new List<string> { "enemy_state_machine_graph", "unlisted_enemy_private_variables" };
+        object? rng = null;
+        object? drawOrder = null;
+        object? enemies = null;
+        object? mentorState = null;
+        availability["rng"] = run == null ? "not_in_run" : "unavailable";
+        if (run != null)
+        {
+            try
+            {
+                // The master seed is the numeric run seed, never the human-facing StringSeed.
+                var r = run.Rng;
+                var prng = player?.PlayerRng;
+                if (prng == null || run.Players.Count != 1)
+                    throw new InvalidOperationException("single_player_rng_required");
+                rng = new
+                {
+                    run_seed = r.Seed,
+                    counters = new Dictionary<string, int>
+                    {
+                        ["up_front"] = r.UpFront.Counter,
+                        ["shuffle"] = r.Shuffle.Counter,
+                        ["combat_card_generation"] = r.CombatCardGeneration.Counter,
+                        ["combat_potion_generation"] = r.CombatPotionGeneration.Counter,
+                        ["combat_card_selection"] = r.CombatCardSelection.Counter,
+                        ["combat_energy_costs"] = r.CombatEnergyCosts.Counter,
+                        ["combat_targets"] = r.CombatTargets.Counter,
+                        ["monster_ai"] = r.MonsterAi.Counter,
+                        ["niche"] = r.Niche.Counter,
+                        ["combat_orbs"] = r.CombatOrbGeneration.Counter,
+                        ["rewards"] = prng.Rewards.Counter,
+                        ["shops"] = prng.Shops.Counter,
+                        ["transformations"] = prng.Transformations.Counter
+                    }
+                };
+                availability["rng"] = "available";
+            }
+            catch { unavailable.Add("rng"); }
+        }
+        availability["draw_order"] = "not_in_combat";
+        availability["enemy_state"] = "not_in_combat";
+        availability["enemy_private_variables"] = "allowlist_only";
+        availability["mentor_state"] = "not_in_combat";
+        if (combat != null && player?.PlayerCombatState != null)
+        {
+            // The upstream embedded builder omits its changing state_id; the outer snapshot token binds it.
+            var mentorBoard = SpireMentor.SimCombatStateBuilder.BuildEmbeddedCombatState(player);
+            if (mentorBoard != null)
+                mentorBoard["draw_knowledge"] = BuildSimulationDrawKnowledge(player);
+            mentorState = mentorBoard;
+            availability["mentor_state"] = mentorState == null ? "unavailable" : "available";
+            if (mentorState == null) unavailable.Add("mentor_state");
+            try
+            {
+                // Native pile order is top first (SimStateExtractor.SerializePile).
+                drawOrder = player.PlayerCombatState.DrawPile.Cards.Select(BuildInternalDrawCard).ToArray();
+                availability["draw_order"] = "available";
+            }
+            catch { availability["draw_order"] = "unavailable"; unavailable.Add("draw_order"); }
+            try
+            {
+                enemies = combat.Enemies.Select((enemy, index) => BuildInternalEnemy(enemy, index)).ToArray();
+                availability["enemy_state"] = "available";
+            }
+            catch { availability["enemy_state"] = "unavailable"; unavailable.Add("enemy_state"); }
+        }
+        return new
+        {
+            schema_version = 1,
+            read_access = "internal",
+            rng,
+            draw_order = drawOrder,
+            draw_order_direction = "top_first",
+            enemies,
+            mentor_state = mentorState,
+            availability,
+            unavailable_fields = unavailable
+        };
+    }
+
+    /// <summary>Identify native instances by the same visible features the public adapter uses.</summary>
+    private static object BuildInternalDrawCard(CardModel card)
+    {
+        return new
+        {
+            known_instance_id = PublicInstanceIdentity<CardModel>.GetIfObserved(card),
+            card_id = card.Id.Entry,
+            upgraded = card.IsUpgraded,
+            upgrade_level = card.CurrentUpgradeLevel,
+            base_cost = card.EnergyCost.Canonical,
+            vars = card.DynamicVars.Values.ToDictionary(v => v.Name.ToLowerInvariant(), v => (int)v.BaseValue),
+            dynamic_values = BuildCardDynamicValuePayloads(card),
+            affliction = BuildCardAfflictionPayload(card),
+            enchantment = BuildCardEnchantmentPayload(card),
+            effective_keywords = GetEffectiveCardKeywords(card)
+        };
+    }
+
+    /// <summary>Read actual selected moves, complete history, and source-allowlisted private counters.</summary>
+    private static object BuildInternalEnemy(Creature creature, int index)
+    {
+        var monster = creature.Monster ?? throw new InvalidOperationException("monster_unavailable");
+        var moves = CombatManager.Instance.History.Entries.OfType<MonsterPerformedMoveEntry>()
+            .Where(entry => entry.Monster == monster).Select(entry => entry.Move.Id).ToArray();
+        var hidden = new Dictionary<string, object?>();
+        var missing = new List<string>();
+        // These exact fields are sourced from upstream AppendMonsterHiddenState, not discovery.
+        if (monster is Fabricator)
+            ReadInternalMonsterField(monster, ReflectedGameMembers.Field(typeof(Fabricator), "_lastSpawned"),
+                "fabricator_last_spawned", hidden, missing);
+        if (monster is KnowledgeDemon)
+            ReadInternalMonsterField(monster, ReflectedGameMembers.Field(typeof(KnowledgeDemon), "_curseOfKnowledgeCounter"),
+                "curse_of_knowledge_counter", hidden, missing);
+        return new
+        {
+            instance_id = PublicInstanceIdentity<Creature>.Get(creature),
+            index,
+            monster_id = monster.Id.Entry,
+            move_state = monster.NextMove?.Id,
+            next_move_id = monster.NextMove?.Id,
+            move_history = moves,
+            move_count = moves.Length,
+            hidden_state = hidden,
+            unavailable_fields = missing
+        };
+    }
+
+    /// <summary>Read only existing upstream allowlisted members, recording missing members explicitly.</summary>
+    private static void ReadInternalMonsterField(MonsterModel monster, FieldInfo? field, string wireName,
+        Dictionary<string, object?> values, List<string> missing)
+    {
+        try
+        {
+            if (field == null)
+                throw new MissingFieldException();
+            var value = field.GetValue(monster);
+            values[wireName] = value is MonsterModel last ? last.Id.Entry : value;
+        }
+        catch { missing.Add(wireName); }
+    }
+}
