diff --git a/STS2AIAgent/Game/GameStateService.SelectionContext.cs b/STS2AIAgent/Game/GameStateService.SelectionContext.cs
new file mode 100644
index 0000000..5a13ef2
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.SelectionContext.cs
@@ -0,0 +1,196 @@
+// Describe visible selection causes and physical cards without inventing a suspended continuation.
+using Godot;
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Nodes.Cards;
+using MegaCrit.Sts2.Core.Nodes.Combat;
+using MegaCrit.Sts2.Core.Nodes.CommonUi;
+using MegaCrit.Sts2.Core.Nodes.Screens;
+using MegaCrit.Sts2.Core.Nodes.Screens.CardSelection;
+using MegaCrit.Sts2.Core.Nodes.Screens.ScreenContext;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Normalize existing target hints alongside their public selection context.</summary>
+    private static string? NormalizeTargetHint(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return null;
+        }
+
+        var normalized = value.Trim().ToLowerInvariant();
+        if (normalized.Contains("enemy", StringComparison.Ordinal))
+        {
+            return "enemy";
+        }
+
+        if (normalized.Contains("player", StringComparison.Ordinal) || normalized.Contains("self", StringComparison.Ordinal))
+        {
+            return "player";
+        }
+
+        return normalized;
+    }
+
+    /// <summary>Advertise the same concrete skip control that the guarded executor consumes.</summary>
+    private static void AppendSelectionSkipAction(IScreenContext? screen, List<ActionDescriptor> descriptors)
+    {
+        if (GetSelectionSkipButton(screen) != null)
+            descriptors.Add(new ActionDescriptor { name = "skip_selection", requires_target = false, requires_index = false });
+    }
+
+    /// <summary>Use the real visible enabled generated-choice skip button, never a viewer back action.</summary>
+    public static NChoiceSelectionSkipButton? GetSelectionSkipButton(IScreenContext? screen)
+    {
+        if (screen is not NChooseACardSelectionScreen selection)
+            return null;
+        var buttons = FindDescendants<NChoiceSelectionSkipButton>(selection)
+            .Where(button => GodotObject.IsInstanceValid(button) && button.IsVisibleInTree() && button.IsEnabled)
+            .Take(2).ToArray();
+        return buttons.Length == 1 ? buttons[0] : null;
+    }
+
+    /// <summary>Require the exact native UI enchantment to appear on a displayed card preview.</summary>
+    private static string? GetVisibleSelectionEnchantment(IScreenContext? screen)
+    {
+        var enchantment = PublicSelectionContext.ReadEnchantment(screen);
+        if (enchantment == null || screen is not NDeckEnchantSelectScreen enchantScreen)
+            return null;
+        return FindDescendants<NCard>(enchantScreen).Any(card => GodotObject.IsInstanceValid(card)
+            && card.IsVisibleInTree() && card.Model?.Enchantment?.Id == enchantment.Id)
+            ? enchantment.Id.Entry : null;
+    }
+
+    /// <summary>Read the same preferences already used for native hand/grid selection bounds.</summary>
+    private static CardSelectorPrefs? GetPublicSelectionPrefs(IScreenContext? screen)
+    {
+        if (TryGetCombatHandSelection(screen, out var hand) && hand != null)
+            return TryGetCombatHandSelectionPrefs(hand);
+        return screen is NCardGridSelectionScreen && ReflectionMemberAccessor.TryGetValue(screen, "_prefs") is CardSelectorPrefs prefs
+            ? prefs : null;
+    }
+
+    /// <summary>Resolve only native prompt identities, never translated descriptions or guessed card effects.</summary>
+    private static string? GetPublicSelectionOperation(CardSelectorPrefs? prefs) =>
+        prefs?.Prompt?.LocEntryKey?.Split('.').LastOrDefault() switch
+        {
+            "TO_UPGRADE" => "upgrade", "TO_TRANSFORM" => "transform", "TO_ENCHANT" => "enchant",
+            "TO_DISCARD" => "discard", "TO_EXHAUST" => "exhaust", "TO_REMOVE" => "remove",
+            "TO_RETAIN" => "retain", "TO_OBTAIN" => "obtain", _ => null
+        };
+
+    /// <summary>Attribute a source only when the exact captured model is a currently visible local play card.</summary>
+    private static SelectionSourcePayload BuildPublicSelectionSource(CardSelectorPrefs? prefs)
+    {
+        var context = PublicSelectionContext.Read(prefs);
+        var state = CombatManager.Instance.DebugOnlyGetState();
+        var player = GetLocalPlayer(state);
+        if (context?.Source != null && context.Source.TryGetTarget(out var model) && model is CardModel card
+            && ReferenceEquals(card.Owner, player) && player?.PlayerCombatState?.PlayPile.Cards
+                .Any(visible => ReferenceEquals(visible, card)) == true)
+        {
+            var targetIndex = card.CurrentTarget == null ? -1 : state!.Enemies.ToList()
+                .FindIndex(enemy => ReferenceEquals(enemy, card.CurrentTarget));
+            return new SelectionSourcePayload
+            {
+                availability = "matched_native_prefs_visible_play_card",
+                entry_point = context.EntryPoint,
+                kind = "card",
+                model_id = card.Id.Entry,
+                instance_id = PublicInstanceIdentity<CardModel>.Observe(card, "card"),
+                upgraded = card.IsUpgraded,
+                target_index = targetIndex < 0 ? null : targetIndex
+            };
+        }
+        return new SelectionSourcePayload
+        {
+            availability = context == null ? "unavailable" : "captured_source_not_bound_to_visible_play_card",
+            entry_point = context?.EntryPoint
+        };
+    }
+
+    /// <summary>Expose ordered indices only for publicly ordered hand/play piles; draw order remains private.</summary>
+    private static int? GetPublicCardSourceIndex(CardModel card)
+    {
+        if (card.Pile == null || card.Pile.Type.ToString() is not ("Hand" or "Play"))
+            return null;
+        var index = card.Pile.Cards.ToList().FindIndex(candidate => ReferenceEquals(candidate, card));
+        return index < 0 ? null : index;
+    }
+
+    /// <summary>Preserve the actual visible play pile with the same per-instance features used for choices.</summary>
+    private static object[] BuildAgentPlayPilePayload(CombatState? combatState, HashSet<string> glossaryTerms)
+    {
+        var pile = GetLocalPlayer(combatState)?.PlayerCombatState?.PlayPile;
+        return pile?.Cards.Select((card, index) => BuildSelectionCardPayload(card, index, false))
+            .Select(card => BuildAgentChoiceCardPayload(card.index, card.card_id, card.name, card.upgraded,
+                card.energy_cost, card.star_cost, card.costs_x, card.star_costs_x,
+                GetPreferredCardRulesText(card.rules_text, card.resolved_rules_text), glossaryTerms, false,
+                card.card_type, card.rarity, card.dynamic_values, card.affliction, card.enchantment,
+                card.effective_keywords, card.instance_id, card.source_pile, card.source_index, card.selectable, card.fetch_played_this_turn))
+            .ToArray() ?? Array.Empty<object>();
+    }
+
+    /// <summary>Describe displayed card choices and native confirmation requirements.</summary>
+    private static object? BuildAgentSelectionPayload(SelectionPayload? selection, HashSet<string> glossaryTerms)
+    {
+        if (selection == null)
+        {
+            return null;
+        }
+
+        CollectGlossaryTerms(glossaryTerms, selection.prompt);
+
+        return new
+        {
+            kind = selection.kind,
+            operation = selection.operation,
+            enchantment_id = selection.enchantment_id,
+            enchantment_capture = selection.enchantment_capture,
+            can_skip = selection.can_skip,
+            prompt_key = selection.prompt_key,
+            cancelable = selection.cancelable,
+            underlying_screen = selection.underlying_screen,
+            source_capture = selection.source_context.availability,
+            source = selection.source_context.entry_point,
+            source_kind = selection.source_context.kind,
+            source_model = selection.source_context.model_id,
+            source_instance_id = selection.source_context.instance_id,
+            source_upgraded = selection.source_context.upgraded,
+            source_target_index = selection.source_context.target_index,
+            source_energy_paid = selection.source_context.energy_paid,
+            source_stars_paid = selection.source_context.stars_paid,
+            prompt = selection.prompt,
+            min = selection.min_select,
+            max = selection.max_select,
+            selected = selection.selected_count,
+            confirm = selection.can_confirm,
+            requires_confirmation = selection.requires_confirmation,
+            cards = selection.cards.Select(card => BuildAgentChoiceCardPayload(
+                card.index, card.card_id, card.name, card.upgraded, card.energy_cost, card.star_cost,
+                card.costs_x, card.star_costs_x, GetPreferredCardRulesText(card.rules_text, card.resolved_rules_text),
+                glossaryTerms, card.selected, card.card_type, card.rarity, card.dynamic_values,
+                card.affliction, card.enchantment, card.effective_keywords, card.instance_id,
+                card.source_pile, card.source_index, card.selectable, card.fetch_played_this_turn)).ToArray()
+        };
+    }
+}
+
+internal sealed class SelectionSourcePayload
+{
+    public string availability { get; init; } = "unavailable";
+    public string? entry_point { get; init; }
+    public string? kind { get; init; }
+    public string? model_id { get; init; }
+    public string? instance_id { get; init; }
+    public bool? upgraded { get; init; }
+    public int? target_index { get; init; }
+    // Already-paid costs cannot be reconstructed from a card's current cost quote.
+    public int? energy_paid { get; init; }
+    public int? stars_paid { get; init; }
+}
