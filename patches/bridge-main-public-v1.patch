--- /dev/null
+++ b/STS2AIAgent/Game/PublicRulesText.cs
@@ -0,0 +1,32 @@
+// Convert native tooltip markup into readable public rules without leaking texture paths.
+using System.Text.RegularExpressions;
+
+namespace STS2AIAgent.Game;
+
+internal static class PublicRulesText
+{
+    // Images are semantic text: stripping only their tags leaves internal resource paths behind.
+    private static readonly Regex ImageResource = new(@"(?:res|uid)://[^\s\[\]<>""。！？；，]+?\.(?:png|webp|svg|jpg)(?:\?[^\s\[\]<>""。！？；，]*)?", RegexOptions.IgnoreCase | RegexOptions.Compiled);
+    // Native tooltips use BBCode-style color, image, and emphasis tags.
+    private static readonly Regex Markup = new(@"\[(?:/?[^\]]+)\]", RegexOptions.Compiled);
+    // Newlines and spacing in tooltips have no additional rules meaning.
+    private static readonly Regex Whitespace = new(@"\s+", RegexOptions.Compiled);
+
+    /// <summary>Keep visible numbers and image meaning while removing presentation markup.</summary>
+    public static string Normalize(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
+        var normalized = ImageResource.Replace(value, ImageLabel);
+        normalized = Markup.Replace(normalized, string.Empty);
+        return Whitespace.Replace(normalized, " ").Trim();
+    }
+
+    /// <summary>Each energy texture is one energy; unknown images retain their visible identity.</summary>
+    private static string ImageLabel(Match match)
+    {
+        var fileName = match.Value.Split('/').Last().Split('?')[0];
+        return fileName.EndsWith("_energy_icon.png", StringComparison.OrdinalIgnoreCase)
+            ? "⚡"
+            : $"〔图标:{Path.GetFileNameWithoutExtension(fileName)}〕";
+    }
+}
