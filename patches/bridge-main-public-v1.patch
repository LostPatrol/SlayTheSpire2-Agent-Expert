+    /// <summary>Locate one projected card after constructing an explicit public path.</summary>
+    private static JsonObject ProjectCard(JsonObject source, string[] segments)
+    {
+        JsonNode current = FairDecisionProtocol.Project(source);
+        foreach (var segment in segments)
+            current = current[segment]!;
