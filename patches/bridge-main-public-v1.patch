+    /// <summary>Choice attribution, real play cards and physical option mapping are public and token-bound.</summary>
+    public static void VisibleSelectionEvidenceIsPublicAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"CARD_SELECTION","session":{"mode":"singleplayer","phase":"run"},
+             "available_actions":["select_deck_card","confirm_selection"],
+             "combat":{"hand":[{"i":0,"instance_id":"card-1","card_id":"STRIKE_IRONCLAD"}],
+                 "play":[{"i":0,"instance_id":"card-7","card_id":"BURNING_PACT","upgraded":true,"source_pile":"Play","source_index":0,"private_uid":77}]},
+             "selection":{"kind":"combat_hand_select","operation":"exhaust","prompt_key":"TO_EXHAUST",
+                 "cancelable":false,"underlying_screen":"COMBAT","source_capture":"matched_native_prefs_visible_play_card",
+                 "source":"FromHand","source_kind":"card","source_model":"BURNING_PACT","source_instance_id":"card-7",
+                 "source_upgraded":true,"source_target_index":null,"source_energy_paid":null,"source_stars_paid":null,
+                 "source_rng":123,"min":1,"max":1,"selected":0,"requires_confirmation":false,
+                 "cards":[{"i":5,"instance_id":"card-1","card_id":"STRIKE_IRONCLAD","source_pile":"Hand",
+                     "source_index":0,"selectable":null,"selected":false,"private_uid":42}]}}
+            """)!.AsObject();
+        var projected = FairDecisionProtocol.Project(source);
+        Assert.Equal("card-7", projected["combat"]!["play"]![0]!["instance_id"]!.GetValue<string>());
+        Assert.False(projected["combat"]!["play"]![0]!.AsObject().ContainsKey("private_uid"));
+        Assert.Equal("BURNING_PACT", projected["selection"]!["source_model"]!.GetValue<string>());
+        Assert.True(projected["selection"]!.AsObject().ContainsKey("source_energy_paid"));
+        Assert.Null(projected["selection"]!["source_energy_paid"]);
+        Assert.Null(projected["selection"]!["cards"]![0]!["selectable"]);
+        Assert.False(projected["selection"]!.AsObject().ContainsKey("source_rng"));
+        Assert.False(projected["selection"]!["cards"]![0]!.AsObject().ContainsKey("private_uid"));
+        var token = FairDecisionProtocol.Token(projected);
+        foreach (var mutate in new Action<JsonObject>[] {
+            row => row["selection"]!["prompt_key"] = "TO_DISCARD",
+            row => row["selection"]!["source_instance_id"] = "card-8",
+            row => row["selection"]!["source_upgraded"] = false,
+            row => row["selection"]!["source_target_index"] = 1,
+            row => row["selection"]!["cards"]![0]!["instance_id"] = "card-2",
+            row => row["selection"]!["cards"]![0]!["source_index"] = 1,
+            row => row["selection"]!["cards"]![0]!["selected"] = true,
+            row => row["combat"]!["play"]![0]!["card_id"] = "OTHER_VISIBLE_CARD" })
+        {
+            var changed = source.DeepClone().AsObject();
+            mutate(changed);
+            Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changed)));
+        }
+    }
+
+    /// <summary>Unreviewed screens, versions, and multiplayer never fall back to raw observations.</summary>
+    public static void ForeignSnapshotsHaveNoActions()
+    {
+        foreach (var json in new[] {
+            """{"version":12,"screen":"COMBAT","session":{"mode":"singleplayer"}}""",
+            """{"version":11,"screen":"NEW_SCREEN","session":{"mode":"singleplayer"}}""",
+            """{"version":11,"screen":"COMBAT","session":{"mode":"multiplayer"}}""",
+            """{"version":"invalid","screen":{},"run_id":"secret"}""" })
+        {
+            var state = FairDecisionProtocol.Project(JsonNode.Parse(json));
+            Assert.False(state["supported"]!.GetValue<bool>(), "Unreviewed snapshots must stop guarded execution.");
+            Assert.Equal(0, state["available_actions"]!.AsArray().Count);
+            Assert.False(state.ContainsKey("run_id"), "Raw fields must never be a fallback.");
+        }
+    }
+
+    /// <summary>One ID keeps its ongoing and completed result, and cannot name a second command.</summary>
+    public static void ActionIdsRetainTheirOriginalReceipt()
+    {
+        var ledger = new FairActionLedger<string>();
+        var entry = ledger.Begin("action-1", "play:0:token");
+        Assert.Equal("in_progress", ledger.Find("action-1", "play:0:token")!.Status);
+        entry.Result = "original-result";
+        entry.Status = "completed";
+        Assert.Equal("original-result", ledger.Find("action-1", "play:0:token")!.Result);
+        try
+        {
+            ledger.Find("action-1", "play:1:token");
+            throw new InvalidOperationException("Reusing an ID for a different command must fail.");
+        }
+        catch (ApiException error) { Assert.Equal("action_id_conflict", error.Code); }
+        entry.Error = new InvalidOperationException("uncertain outcome");
+        entry.Status = "outcome_unknown";
+        Assert.True(ledger.Find("action-1")!.Error != null, "Uncertain outcomes must retain the used ID.");
+    }
+
+    /// <summary>A successful real action invalidates old tokens even when the public picture returns unchanged.</summary>
+    public static void AcceptedActionsPreventPublicStateAba()
+    {
+        var compact = JsonNode.Parse("""{"version":11,"screen":"MAIN_MENU","session":{"mode":"singleplayer"}}""");
+        var before = FairDecisionProtocol.Project(compact);
+        FairDecisionProtocol.AdvanceActionRevision();
+        var after = FairDecisionProtocol.Project(compact);
+        Assert.False(FairDecisionProtocol.Token(before) == FairDecisionProtocol.Token(after),
+            "A prior action's token must not work after returning to the identical public scene.");
+        Assert.Equal(FairDecisionProtocol.Token(after), FairDecisionProtocol.Token(FairDecisionProtocol.Project(compact)));
+    }
+}
