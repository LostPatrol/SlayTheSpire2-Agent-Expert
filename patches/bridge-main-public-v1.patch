diff --git a/STS2AIAgent.Tests/DrawKnowledgeContractTests.cs b/STS2AIAgent.Tests/DrawKnowledgeContractTests.cs
new file mode 100644
index 0000000..91dcfc6
--- /dev/null
+++ b/STS2AIAgent.Tests/DrawKnowledgeContractTests.cs
@@ -0,0 +1,60 @@
+// Verify the public event-knowledge contract and its observation-token boundary.
+using System.Text.Json.Nodes;
+using STS2AIAgent.Game;
+
+namespace STS2AIAgent.Tests;
+
+internal static class DrawKnowledgeContractTests
+{
+    /// <summary>Retain ordered bands, unordered multiplicity and public identities, excluding hidden state.</summary>
+    public static void CertificateIsExplicitPublicAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"COMBAT","session":{"mode":"singleplayer","phase":"run"},
+             "available_actions":[],"combat":{"draw_knowledge":{"schema_version":1,"available":true,
+              "reason":null,"source":"native_public_hook_observer","kind":"combat_reshuffle","rng":55,
+              "bands":[{"cards":[{"card_ids":["BASH"],"card_count":1,"known_instance_ids":["card-1"],
+                "upgraded":false,"energy_cost":2,"private_uid":7,"enchantment":{"enchantment_id":"PERFECT_FIT","amount":1},
+                "dynamic_values":[{"name":"Damage","current_value":8,"hidden_roll":42}]}]},
+                {"cards":[{"card_ids":["STRIKE_IRONCLAD"],"card_count":2,"known_instance_ids":[]}]}],
+              "inserted":[{"card_ids":["DEFEND_IRONCLAD"],"card_count":1,"known_instance_ids":[]}],
+              "discard_bands":[{"cards":[{"card_ids":["BASH"],"card_count":1,"known_instance_ids":[]}]}]}}}
+            """)!.AsObject();
+        var projected = FairDecisionProtocol.Project(source);
+        var knowledge = projected["combat"]!["draw_knowledge"]!.AsObject();
+        Assert.True(knowledge["available"]!.GetValue<bool>());
+        Assert.Equal(2, knowledge["bands"]!.AsArray().Count);
+        var row = knowledge["bands"]![0]!["cards"]![0]!;
+        Assert.Equal(1, row["card_count"]!.GetValue<int>());
+        Assert.Equal("card-1", row["known_instance_ids"]![0]!.GetValue<string>());
+        Assert.Equal("PERFECT_FIT", row["enchantment"]!["enchantment_id"]!.GetValue<string>());
+        Assert.False(knowledge.ContainsKey("rng"));
+        Assert.False(row.AsObject().ContainsKey("private_uid"));
+        Assert.False(row["dynamic_values"]![0]!.AsObject().ContainsKey("hidden_roll"));
+        var originalToken = FairDecisionProtocol.Token(projected);
+        foreach (var change in new Action<JsonObject>[]
+        {
+            value => value["available"] = false,
+            value => value["reason"] = "shuffle_receiver_order_unwitnessed",
+            value => value["bands"]![0]!["cards"]![0]!["card_count"] = 2,
+            value => value["bands"]![0]!["cards"]![0]!["known_instance_ids"]![0] = "card-2",
+            value => value["bands"]![0]!["cards"]![0]!["dynamic_values"]![0]!["current_value"] = 10,
+            value => value["inserted"]![0]!["card_count"] = 2,
+            value => value["discard_bands"]![0]!["cards"]![0]!["card_ids"]![0] = "STRIKE_IRONCLAD",
+            value => { var bands = value["bands"]!.AsArray(); var first = bands[0]!.DeepClone();
+                bands.RemoveAt(0); bands.Add(first); }
+        })
+        {
+            var changed = source.DeepClone().AsObject();
+            change(changed["combat"]!["draw_knowledge"]!.AsObject());
+            Assert.False(originalToken == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changed)));
+        }
+        var observer = AgentSourceFixture.Read("STS2AIAgent/Game/NativeDrawKnowledgeObserver.cs");
+        Assert.False(observer.Contains(".Observe(", StringComparison.Ordinal));
+        Assert.False(observer.Contains("Rng", StringComparison.Ordinal));
+        Assert.Contains("cards.ToHashSet()", observer);
+        Assert.Contains("unobserved_draw_membership_change", observer);
+        Assert.Contains("draw_departure_not_classified", observer);
+        Assert.Contains("nameof(Hook.AfterCardDrawn)", observer);
+    }
+}
diff --git a/STS2AIAgent.Tests/FairDecisionProtocolTests.cs b/STS2AIAgent.Tests/FairDecisionProtocolTests.cs
new file mode 100644
index 0000000..5c5dff0
--- /dev/null
+++ b/STS2AIAgent.Tests/FairDecisionProtocolTests.cs
@@ -0,0 +1,522 @@
+// Offline checks for the actual public projection and process-lifetime action ledger.
+using System.Text.Json.Nodes;
+using STS2AIAgent.Game;
+using STS2AIAgent.Server;
+
+namespace STS2AIAgent.Tests;
+
+internal static class FairDecisionProtocolTests
+{
+    /// <summary>Previously public identities stay attached to full pile-group features and invalidate tokens.</summary>
+    public static void KnownPileIdentitiesArePublicAndTokenBound()
+    {
+        foreach (var path in new[] { "combat.draw", "combat.discard", "combat.exhaust", "run.piles.draw", "run.piles.discard", "run.piles.exhaust" })
+        {
+            var source = JsonNode.Parse("""
+                {"version":11,"screen":"COMBAT","session":{"mode":"singleplayer","phase":"run"},"available_actions":[]}
+                """)!.AsObject();
+            var parent = source;
+            var names = path.Split('.');
+            foreach (var name in names[..^1])
+            {
+                parent[name] = new JsonObject();
+                parent = parent[name]!.AsObject();
+            }
+            parent[names[^1]] = JsonNode.Parse("""
+                [{"card_ids":["STRIKE_IRONCLAD"],"card_count":3,"energy_cost":0,"upgraded":false,
+                  "known_instance_ids":["card-11","card-23"],"hidden_instance_ids":["never-public"]}]
+                """);
+            var result = FairDecisionProtocol.Project(source);
+            JsonNode node = result;
+            foreach (var name in names) node = node[name]!;
+            Assert.Equal(2, node[0]!["known_instance_ids"]!.AsArray().Count);
+            Assert.False(node[0]!.AsObject().ContainsKey("hidden_instance_ids"));
+            var token = FairDecisionProtocol.Token(result);
+            parent[names[^1]]![0]!["hidden_instance_ids"]![0] = "different-hidden";
+            Assert.Equal(token, FairDecisionProtocol.Token(FairDecisionProtocol.Project(source)));
+            parent[names[^1]]![0]!["known_instance_ids"]![1] = "card-24";
+            Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(source)));
+        }
+    }
+
+    /// <summary>Reward identities, current room coordinates and generated-choice controls are public and token-bound.</summary>
+    public static void RewardAndCurrentLocationFactsArePublicAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"REWARD","session":{"mode":"singleplayer","phase":"run"},
+             "available_actions":["claim_reward","discard_potion","skip_selection"],
+             "run":{"map_coord":{"row":4,"col":2,"hidden_next":9},"act_floor":5,
+                 "relic_ids":["VAJRA","ANCHOR"],"relic_is_melted":[false,true],"relic_statuses":["Active",null]},
+             "selection":{"can_skip":true,"enchantment_id":"SWIFT","enchantment_capture":"matched_native_ui_model_and_visible_card_preview"},
+             "reward":{"rewards":[{"i":3,"reward_type":"Potion","claimable":true,"visible":true,"successfully_selected":false,"potion_id":"BLOCK_POTION",
