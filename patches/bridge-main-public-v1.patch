+        if (!knowledge.Available)
+            return new { observed = false };
+        var draw = player.PlayerCombatState!.DrawPile.Cards.ToArray();
+        var discard = player.PlayerCombatState.DiscardPile.Cards.ToArray();
+
+        // Positions only bind instances; priority order comes exclusively from the public observer.
+        /// <summary>Serialize unordered membership in the same pile used by the native exporter.</summary>
+        int[] Indices(CardModel[] cards, CardModel[] pile)
+        {
+            return cards.Select(card => Array.FindIndex(pile, member => ReferenceEquals(member, card)))
+                .Order().ToArray();
+        }
+
+        return new
+        {
+            observed = true,
+            groups = knowledge.Bands.Select(cards => Indices(cards, draw)).ToArray(),
+            inserted = Indices(knowledge.Inserted, draw),
+            discard_groups = knowledge.DiscardBands.Select(cards => Indices(cards, discard)).ToArray()
+        };
+    }
+
+    /// <summary>Expose only rule knowledge; no card sequence is read from the live native draw pile.</summary>
+    private static object BuildPublicDrawKnowledge(CombatState? combat, HashSet<string> glossaryTerms)
+    {
+        var knowledge = NativeDrawKnowledgeObserver.Read(GetLocalPlayer(combat));
+        return new
+        {
+            schema_version = 1,
+            available = knowledge.Available,
+            reason = knowledge.Reason,
+            source = "native_public_hook_observer",
+            kind = knowledge.Kind,
+            bands = knowledge.Bands.Select(cards => new
+                { cards = BuildAgentCardStacks(cards, glossaryTerms, PileType.Draw) }).ToArray(),
+            inserted = BuildAgentCardStacks(knowledge.Inserted, glossaryTerms, PileType.Draw),
+            discard_bands = knowledge.DiscardBands.Select(cards => new
+                { cards = BuildAgentCardStacks(cards, glossaryTerms, PileType.Discard) }).ToArray()
+        };
+    }
+}
