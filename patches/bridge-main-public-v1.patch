+    /// <summary>Invoke only methods from the exact packaged assembly, including its real public projector.</summary>
+    private sealed class Producer
+    {
+        // Reflection is limited to our own producer; game assemblies are dependency resolution only.
+        private readonly Assembly _assembly;
+        private readonly Type _service;
+        private readonly Type _protocol;
+
+        /// <summary>Bind the real packaged producer identities without constructing native game objects.</summary>
+        internal Producer(Assembly assembly)
+        {
+            _assembly = assembly;
+            _service = Type("GameStateService"); _protocol = Type("FairDecisionProtocol");
+        }
+
+        /// <summary>Create the actual raw DTO type using its declared serializer contract.</summary>
+        private object Dto(string name, JsonNode value) => JsonSerializer.Deserialize(value.ToJsonString(), Type(name), JsonOptions)!;
+
+        /// <summary>Resolve a type only inside the owned bridge assembly.</summary>
+        private Type Type(string name) => _assembly.GetType("STS2AIAgent.Game." + name, throwOnError: true)!;
+
+        /// <summary>Call one exact producer method and preserve inner failures for diagnosis.</summary>
+        private object? Call(string method, params object?[] arguments)
+        {
+            try { return _service.GetMethod(method, BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic)!.Invoke(null, arguments); }
+            catch (TargetInvocationException ex) { throw ex.InnerException ?? ex; }
+        }
+
+        /// <summary>Project full typed raw scene DTOs through the production view and native public gate.</summary>
+        internal JsonObject Project(JsonObject raw, JsonObject? pileWitness = null, JsonObject? playSource = null)
+        {
+            var dto = Dto("GameStatePayload", raw);
+            // Read the real DTO property rather than projecting hand-written compact JSON.
+            object? Property(string name) => dto.GetType().GetProperty(name)!.GetValue(dto);
+            var method = _service.GetMethod("BuildAgentViewPayload", BindingFlags.Static | BindingFlags.NonPublic)!;
+            var properties = new Dictionary<string, string> { ["nativeProfileId"] = "native_profile_id", ["runId"] = "run_id",
+                ["availableActions"] = "available_actions", ["eventPayload"] = "event", ["gameOver"] = "game_over",
+                ["characterSelect"] = "character_select", ["multiplayerLobby"] = "multiplayer_lobby", ["crystalSphere"] = "crystal_sphere" };
+            var args = method.GetParameters().Select(parameter => parameter.Name is "combatState" or "runState" ? null
+                : Property(properties.GetValueOrDefault(parameter.Name!, parameter.Name!))).ToArray();
+            object? compact;
+            try { compact = method.Invoke(null, args); }
+            catch (TargetInvocationException ex) { throw ex.InnerException ?? ex; }
+            var node = JsonSerializer.SerializeToNode(compact)!.AsObject();
+            if (pileWitness != null)
+            {
+                foreach (var pile in new[] { "draw", "discard", "exhaust" })
+                {
+                    var rows = new JsonArray();
+                    foreach (var card in pileWitness["combat"]![pile]!.AsArray().OfType<JsonObject>()) rows.Add(Card(card));
+                    var cards = JsonSerializer.Deserialize(rows.ToJsonString(), Type("DeckCardPayload").MakeArrayType(), JsonOptions)!;
+                    var stacker = _service.GetMethods(BindingFlags.Static | BindingFlags.NonPublic).Single(candidate =>
+                        candidate.Name == "BuildAgentCardStacks" && candidate.GetParameters().Length == 2
+                        && candidate.GetParameters()[0].ParameterType.GenericTypeArguments.Single().Name == "DeckCardPayload");
+                    var stacks = JsonSerializer.SerializeToNode(stacker.Invoke(null, new[] { cards, new HashSet<string>() }))!;
+                    node["combat"]![pile] = stacks;
+                    node["run"]!["piles"]![pile] = stacks.DeepClone();
+                }
+            }
+            if (playSource != null)
+            {
+                var card = Dto("SelectionCardPayload", Card(playSource));
+                // Bind the actual production card compactor from typed source metadata.
+                object? C(string name) => card.GetType().GetProperty(name)!.GetValue(card);
+                var played = Call("BuildAgentChoiceCardPayload", C("index"), C("card_id"), C("name"), C("upgraded"),
+                    C("energy_cost"), C("star_cost"), C("costs_x"), C("star_costs_x"), C("rules_text"),
+                    new HashSet<string>(), false, C("card_type"), C("rarity"), C("dynamic_values"), C("affliction"),
+                    C("enchantment"), C("effective_keywords"), null, "Play", 0, null);
+                node["combat"]!["play"] = new JsonArray(JsonSerializer.SerializeToNode(played));
+            }
+            dto.GetType().GetProperty("agent_view")!.SetValue(dto, node);
+            return (JsonObject)Call("BuildPublicStatePayload", dto)!;
+        }
+
+        /// <summary>Use the exact packaged token function after the final whitelist/gate projection.</summary>
+        internal string Token(JsonObject projected) => (string)_protocol.GetMethod("Token", BindingFlags.Static | BindingFlags.Public)!.Invoke(null, new object[] { projected })!;
+    }
+}
