+        var (runHp, runMaximum) = Hp(run["hp"]!);
+        raw["run"]!["current_hp"] = runHp;
+        raw["run"]!["max_hp"] = runMaximum;
+        var player = source["combat"]!["player"]!;
+        var (hp, maximum) = Hp(player["hp"]!);
+        var enemies = new JsonArray();
+        foreach (var enemy in source["combat"]!["enemies"]!.AsArray().OfType<JsonObject>())
+        {
+            Assert.Equal(0, enemy["powers"]!.AsArray().Count);
+            var (current, max) = Hp(enemy["hp"]!);
+            var intents = new JsonArray();
+            foreach (var intent in enemy["intents"]!.AsArray().OfType<JsonObject>())
+            {
+                var item = intent.DeepClone().AsObject();
+                item["index"] = item["i"]?.DeepClone(); item.Remove("i");
+                intents.Add(item);
+            }
+            enemies.Add(new JsonObject { ["index"] = enemy["i"]!.DeepClone(), ["enemy_id"] = enemy["enemy_id"]!.DeepClone(),
+                ["name"] = enemy["name"]!.DeepClone(), ["current_hp"] = current, ["max_hp"] = max,
+                ["block"] = enemy["block"]!.DeepClone(), ["is_alive"] = true, ["is_hittable"] = true, ["intents"] = intents });
+        }
+        Assert.Equal(0, player["powers"]!.AsArray().Count);
+        var hand = new JsonArray();
+        foreach (var card in source["combat"]!["hand"]!.AsArray().OfType<JsonObject>())
+        {
+            var row = Card(card); row.Remove("card_type"); row.Remove("rarity");
+            row["playable"] = card["playable"]?.DeepClone() ?? false;
+            row["can_play_result"] = card["playable"]?.DeepClone() ?? false;
+            hand.Add(row);
+        }
+        raw["combat"] = new JsonObject
+        {
+            ["player"] = new JsonObject { ["current_hp"] = hp, ["max_hp"] = maximum,
+                ["block"] = player["block"]!.DeepClone(), ["energy"] = player["energy"]!.DeepClone(),
