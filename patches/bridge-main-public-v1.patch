diff --git a/STS2AIAgent.Tests/PublicBlockHistoryContractTests.cs b/STS2AIAgent.Tests/PublicBlockHistoryContractTests.cs
new file mode 100644
index 0000000..4c36748
--- /dev/null
+++ b/STS2AIAgent.Tests/PublicBlockHistoryContractTests.cs
@@ -0,0 +1,57 @@
+// Bind native card-only block history to public completed-play indices without private counters.
+using System.Text.Json.Nodes;
+using STS2AIAgent.Game;
+
+namespace STS2AIAgent.Tests;
+
+internal static class PublicBlockHistoryContractTests
+{
+    /// <summary>Keep multiple gains from one public play, explicit coverage and turn boundaries in the token.</summary>
+    public static void PositiveCardBlockHistoryIsPublicAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"COMBAT","session":{"mode":"singleplayer","phase":"run"},
+             "combat":{"public_card_play_history":{"plays":[{"sequence":2,"known_instance_id":"card-1"}]},
+              "public_card_block_history":{"available":true,"complete":true,
+               "scope":"current_combat","source":"native_local_card_block_gains","private_counter":7,
+               "entries":[{"this_turn":true,"card_play_index":2,"amount":5,"native_uid":15},
+                          {"this_turn":true,"card_play_index":2,"amount":3}]}}}
+            """)!.AsObject();
+        var projected = FairDecisionProtocol.Project(source);
+        var history = projected["combat"]!["public_card_block_history"]!.AsObject();
+        Assert.True(history["complete"]!.GetValue<bool>());
+        Assert.Equal(2, history["entries"]!.AsArray().Count);
+        Assert.Equal(2, history["entries"]![0]!["card_play_index"]!.GetValue<int>());
+        Assert.Equal(2, history["entries"]![1]!["card_play_index"]!.GetValue<int>());
+        Assert.False(history.ContainsKey("private_counter"));
+        Assert.False(history["entries"]![0]!.AsObject().ContainsKey("native_uid"));
+        Assert.Equal("card-1", projected["combat"]!["public_card_play_history"]!["plays"]![0]!["known_instance_id"]!.GetValue<string>());
+        var token = FairDecisionProtocol.Token(projected);
+        foreach (var change in new Action<JsonObject>[]
+        {
+            value => value["available"] = false,
+            value => value["complete"] = false,
+            value => value["entries"]![0]!["this_turn"] = false,
+            value => value["entries"]![0]!["card_play_index"] = 3,
+            value => value["entries"]![0]!["amount"] = 8
+        })
+        {
+            var changed = source.DeepClone().AsObject();
+            change(changed["combat"]!["public_card_block_history"]!.AsObject());
+            Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changed)));
+        }
+        var native = AgentSourceFixture.Read("STS2AIAgent/Game/GameStateService.BlockHistory.cs");
+        Assert.Contains("gained.Amount <= 0", native);
+        Assert.Contains("gained.Props.IsCardOrMonsterMove()", native);
+        Assert.Contains("ReferenceEquals(gained.Receiver, player.Creature)", native);
+        Assert.Contains("ReferenceEquals(finished, play)", native);
+        Assert.Contains("if (index < 0) { complete = false; continue; }", native);
+        Assert.False(native.Contains(".Observe(", StringComparison.Ordinal));
+        var plays = AgentSourceFixture.MethodBody(AgentSourceFixture.ReadStateService(), "BuildPublicCardPlayHistory");
+        Assert.Contains("GetIfObserved(play.Card)", plays);
+        Assert.False(plays.Contains(".Observe(", StringComparison.Ordinal));
+        var changedIdentity = source.DeepClone().AsObject();
+        changedIdentity["combat"]!["public_card_play_history"]!["plays"]![0]!["known_instance_id"] = null;
+        Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changedIdentity)));
+    }
+}
