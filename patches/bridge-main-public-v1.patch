+// Public-only receipt lookup for guarded external actions.
+using STS2AIAgent.Server;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameActionService
+{
+    // Retain IDs for the process lifetime; expiration must never make an old action executable again.
+    private static readonly FairActionLedger<ActionResponsePayload> ExternalActionReceipts = new();
+
+    /// <summary>Require the full guard envelope on the captured game thread.</summary>
+    private static void ValidateGuardedRequest(ActionRequest request)
+    {
+        if (string.IsNullOrWhiteSpace(request.action_id) || string.IsNullOrWhiteSpace(request.expected_observation_token))
+            throw new ApiException(400, "invalid_request", "Guarded actions require action_id and expected_observation_token together.");
+        if (!GameThread.IsCurrentThread)
+            throw new ApiException(409, "wrong_thread", "Guarded action admission must run on the game thread.");
+    }
+
+    /// <summary>Return a public-only receipt; absence after a bridge restart requires reconciliation.</summary>
+    public static object GetExternalActionReceipt(string actionId)
+    {
+        var receipt = ExternalActionReceipts.Find(actionId)
+            ?? throw new ApiException(404, "receipt_not_found", "No receipt exists in this bridge process.");
+        return new
+        {
+            action_id = actionId, status = receipt.Status, stable = receipt.Result?.stable ?? false,
+            public_state = receipt.Result?.public_state,
+            public_observation_token = receipt.Result?.public_observation_token,
+            error_code = (receipt.Error as ApiException)?.Code
+        };
+    }
+}
