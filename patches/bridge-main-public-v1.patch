+/// <summary>Process-lifetime, game-thread-owned idempotency records, independent of transport.</summary>
+internal sealed class FairActionLedger<T> where T : class
+{
+    // Never evict an ID while this bridge process can still receive its retries.
+    private readonly Dictionary<string, Entry> _entries = new(StringComparer.Ordinal);
+
+    /// <summary>Find an existing request, rejecting reuse of its ID for another command.</summary>
+    public Entry? Find(string id, string? signature = null)
+    {
+        if (!_entries.TryGetValue(id, out var entry)) return null;
+        if (signature != null && signature != entry.Signature)
+            throw new ApiException(409, "action_id_conflict", "This action_id already belongs to a different request.");
+        return entry;
+    }
+
+    /// <summary>Reserve before dispatch and before the first await.</summary>
+    public Entry Begin(string id, string signature)
+    {
+        var entry = new Entry(signature);
+        _entries.Add(id, entry);
+        return entry;
+    }
+
+    internal sealed class Entry
+    {
+        /// <summary>Start one in-progress receipt for a canonical command.</summary>
+        public Entry(string signature) { Signature = signature; }
+
+        public string Signature { get; }
+        public string Status { get; set; } = "in_progress";
+        public T? Result { get; set; }
+        public Exception? Error { get; set; }
+    }
+}
