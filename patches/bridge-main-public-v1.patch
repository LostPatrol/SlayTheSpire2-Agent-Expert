+// Verify that public history statistics and independent completed-play metadata survive projection and bind tokens.
+using System.Text.Json.Nodes;
+using STS2AIAgent.Game;
+
+namespace STS2AIAgent.Tests;
+
+internal static class PublicCombatStatsProtocolTests
+{
+    /// <summary>Fetch's nullable per-instance fact survives every live-card projection and changes public tokens.</summary>
+    public static void FetchHistoryPredicateIsNullableAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"COMBAT","session":{"mode":"singleplayer","phase":"run"},
+             "combat":{"hand":[{"card_id":"FETCH","fetch_played_this_turn":true}],
+              "play":[{"card_id":"FETCH","fetch_played_this_turn":false}],
+              "draw":[{"card_ids":["FETCH"],"fetch_played_this_turn":null}],
+              "discard":[{"card_ids":["FETCH"],"fetch_played_this_turn":true}],
+              "exhaust":[{"card_ids":["FETCH"],"fetch_played_this_turn":false}],
+              "draw_knowledge":{"bands":[{"cards":[{"card_ids":["FETCH"],"fetch_played_this_turn":true}]}],
+               "inserted":[{"card_ids":["FETCH"],"fetch_played_this_turn":false}],
+               "discard_bands":[{"cards":[{"card_ids":["FETCH"],"fetch_played_this_turn":null}]}]}},
+             "selection":{"cards":[{"card_id":"FETCH","fetch_played_this_turn":true}]}}
+            """)!.AsObject();
+        var projected = FairDecisionProtocol.Project(source);
+        Assert.True(projected["combat"]!["hand"]![0]!["fetch_played_this_turn"]!.GetValue<bool>());
+        Assert.False(projected["combat"]!["play"]![0]!["fetch_played_this_turn"]!.GetValue<bool>());
+        Assert.True(projected["combat"]!["draw"]![0]!.AsObject().ContainsKey("fetch_played_this_turn"));
+        Assert.Null(projected["combat"]!["draw"]![0]!["fetch_played_this_turn"]);
+        var token = FairDecisionProtocol.Token(projected);
+        foreach (var array in new[] { projected["combat"]!["hand"], projected["combat"]!["play"],
+            projected["combat"]!["draw"], projected["combat"]!["discard"], projected["combat"]!["exhaust"],
+            projected["combat"]!["draw_knowledge"]!["bands"]![0]!["cards"],
+            projected["combat"]!["draw_knowledge"]!["inserted"],
+            projected["combat"]!["draw_knowledge"]!["discard_bands"]![0]!["cards"], projected["selection"]!["cards"] })
+        {
+            var row = array![0]!.AsObject();
+            Assert.True(row.ContainsKey("fetch_played_this_turn"));
+            var original = row["fetch_played_this_turn"]?.DeepClone();
+            row["fetch_played_this_turn"] = original == null ? false : null;
+            Assert.False(token == FairDecisionProtocol.Token(projected));
+            row["fetch_played_this_turn"] = original;
+        }
+        var state = AgentSourceFixture.ReadStateService();
+        var predicate = AgentSourceFixture.MethodBody(state, "GetPublicFetchPlayedThisTurn");
+        Assert.Contains("ReferenceEquals(entry.CardPlay.Card, card)", predicate, StringComparison.Ordinal);
+        Assert.Contains("entry.HappenedThisTurn(combat)", predicate, StringComparison.Ordinal);
+        Assert.Contains("fetch_played_this_turn?.ToString()", state, StringComparison.Ordinal);
+    }
+
+    /// <summary>Known zero, unknown null and stable target hit rows remain distinct public observations.</summary>
+    public static void KnownZeroAndUnknownStatisticsAreDistinctAndTokenBound()
+    {
+        var source = JsonNode.Parse("""
+            {"version":11,"screen":"COMBAT","session":{"mode":"singleplayer","phase":"run"},"combat":{
+              "powered_hits_by_target_this_turn":[{"instance_id":"enemy-2","hits":2,"hidden_index":9}],
+              "ally_powered_hits_by_target_this_turn":[],"doom_applied_this_turn":false,
+              "generated_cards_this_combat":null,"energy_wasted_this_combat":null,"unspent_energy_at_turn_end_sum":null,
+              "public_card_play_history":{"available":true,"complete":true,"plays":[{
+                  "sequence":0,"card_id":"SHIV","was_ethereal":false,"energy_spent":0,"energy_value":0,"stars_spent":null}]}}}
+            """)!.AsObject();
+        var combat = source["combat"]!.AsObject();
+        var counters = new[] { "energy_spent_this_turn", "hp_loss_events_this_turn", "hp_loss_events_this_combat",
+            "cards_exhausted_this_turn", "cards_discarded_this_turn", "cards_drawn_by_effect_this_turn",
+            "status_cards_drawn_this_turn", "cards_drawn_this_combat", "lightning_orbs_channeled_this_combat",
+            "stars_gained_this_turn", "osty_attacks_this_turn" };
+        foreach (var key in counters) combat[key] = 0;
+        var projected = FairDecisionProtocol.Project(source);
+        var token = FairDecisionProtocol.Token(projected);
+        foreach (var key in counters)
+        {
+            Assert.Equal(0, projected["combat"]![key]!.GetValue<int>());
+            var changed = source.DeepClone().AsObject(); changed["combat"]![key] = null;
+            Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changed)));
+        }
+        Assert.False(projected["combat"]!["powered_hits_by_target_this_turn"]![0]!.AsObject().ContainsKey("hidden_index"));
+        Assert.True(projected["combat"]!["generated_cards_this_combat"] is null);
+        foreach (var change in new Action<JsonObject>[] {
+            row => row["combat"]!["doom_applied_this_turn"] = true,
+            row => row["combat"]!["powered_hits_by_target_this_turn"]![0]!["instance_id"] = "enemy-3",
+            row => row["combat"]!["powered_hits_by_target_this_turn"]![0]!["hits"] = 3,
+            row => row["combat"]!["ally_powered_hits_by_target_this_turn"] = null,
+            row => row["combat"]!["generated_cards_this_combat"] = 0,
+            row => row["combat"]!["energy_wasted_this_combat"] = 0,
+            row => row["combat"]!["unspent_energy_at_turn_end_sum"] = 0,
+            row => row["combat"]!["public_card_play_history"]!["plays"]![0]!["was_ethereal"] = true,
+            row => row["combat"]!["public_card_play_history"]!["plays"]![0]!["energy_spent"] = 1,
+            row => row["combat"]!["public_card_play_history"]!["plays"]![0]!["energy_value"] = 1,
+            row => row["combat"]!["public_card_play_history"]!["plays"]![0]!["stars_spent"] = 0 })
+        {
+            var changed = source.DeepClone().AsObject(); change(changed);
+            Assert.False(token == FairDecisionProtocol.Token(FairDecisionProtocol.Project(changed)));
+        }
+    }
+}
diff --git a/STS2AIAgent.Tests/PublicInstanceIdentityTests.cs b/STS2AIAgent.Tests/PublicInstanceIdentityTests.cs
new file mode 100644
index 0000000..cfff051
--- /dev/null
+++ b/STS2AIAgent.Tests/PublicInstanceIdentityTests.cs
@@ -0,0 +1,47 @@
+// Check stable public labels and explicit observation without native game runtime assemblies.
+using STS2AIAgent.Game;
+
+namespace STS2AIAgent.Tests;
+
+internal static class PublicInstanceIdentityTests
+{
+    /// <summary>Looking up a hidden instance never creates or marks a public label.</summary>
+    public static void ObservationIsExplicitAndHiddenLookupHasNoSideEffects()
+    {
+        var hidden = new object();
+        Assert.Null(PublicInstanceIdentity<object>.GetIfObserved(hidden));
+        var privateLabel = PublicInstanceIdentity<object>.Get(hidden, "card");
+        Assert.Null(PublicInstanceIdentity<object>.GetIfObserved(hidden));
+        Assert.Equal(privateLabel, PublicInstanceIdentity<object>.Observe(hidden, "card"));
+        Assert.Equal(privateLabel, PublicInstanceIdentity<object>.GetIfObserved(hidden));
+        var unseen = new object();
+        Assert.Null(PublicInstanceIdentity<object>.GetIfObserved(unseen));
+        var visibleLabel = PublicInstanceIdentity<object>.Observe(unseen, "card");
+        Assert.True(visibleLabel.StartsWith("card-", StringComparison.Ordinal));
+        Assert.Equal(visibleLabel, PublicInstanceIdentity<object>.GetIfObserved(unseen));
+        Assert.False(visibleLabel == privateLabel);
+        var source = AgentSourceFixture.ReadStateService();
+        Assert.Contains("GetIfObserved(card)", source);
+        Assert.Contains("card.Pile?.Type == expectedPile.Value", source);
+        Assert.False(AgentSourceFixture.Read("STS2AIAgent/Game/GameStateService.SimulationInternal.cs").Contains(".Observe(", StringComparison.Ordinal));
+    }
+
+    /// <summary>Identical-looking objects retain distinct labels when their display slots change.</summary>
+    public static void LabelsSurviveReorderingAndNeverMergeDifferentObjects()
+    {
+        var first = new object();
+        var second = new object();
+        var firstId = PublicInstanceIdentity<object>.Get(first);
+        var secondId = PublicInstanceIdentity<object>.Get(second);
+        Assert.False(firstId == secondId);
+        var reordered = new[] { second, first };
+        Assert.Equal(secondId, PublicInstanceIdentity<object>.Get(reordered[0]));
+        Assert.Equal(firstId, PublicInstanceIdentity<object>.Get(reordered[1]));
+        Assert.False(firstId == PublicInstanceIdentity<object>.Get(new object()));
+        Assert.False(secondId == PublicInstanceIdentity<object>.Get(new object()));
+        var card = new object();
+        var cardId = PublicInstanceIdentity<object>.Get(card, "card");
+        Assert.True(cardId.StartsWith("card-", StringComparison.Ordinal));
+        Assert.Equal(cardId, PublicInstanceIdentity<object>.Get(card, "card"));
+    }
+}
