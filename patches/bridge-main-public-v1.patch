+    /// <summary>Hash canonical public JSON only; no seed, hidden identity, or timestamp enters this token.</summary>
+    public static string Token(JsonObject publicState) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(publicState.ToJsonString()))).ToLowerInvariant();
+
+    /// <summary>Copy reviewed objects and scalar leaves in schema order, rejecting unexpected nested shapes.</summary>
+    private static JsonObject ProjectObject(JsonObject source, string path)
+    {
+        var result = new JsonObject();
+        foreach (var field in Fields[path].Split(' ', StringSplitOptions.RemoveEmptyEntries))
+        {
+            if (!source.TryGetPropertyValue(field, out var value)) continue;
+            var childPath = path.Length == 0 ? field : path + "." + field;
+            if (childPath == "glossary" && value is JsonObject glossary)
+            {
+                // Glossary labels are localized; only explanation strings can cross this map boundary.
+                var terms = new JsonObject();
+                foreach (var term in glossary)
+                    if (term.Value is JsonValue text && text.TryGetValue<string>(out var explanation))
+                        terms[term.Key] = explanation;
+                result[field] = terms;
+            }
+            else if (childPath == "crystal_sphere.hidden_cells" && value is JsonArray cells)
+            {
+                // Board cover coordinates are visible; per-item covered geometry is never copied.
+                result[field] = new JsonArray(cells.OfType<JsonArray>()
+                    .Where(cell => cell.Count == 2 && cell.All(coordinate =>
+                        coordinate is JsonValue number && number.TryGetValue<int>(out _)))
+                    .Select(cell => (JsonNode?)cell.DeepClone()).ToArray());
+            }
+            else if (Fields.ContainsKey(childPath))
+            {
+                if (value is JsonObject child) result[field] = ProjectObject(child, childPath);
+            }
+            else if (Fields.ContainsKey(childPath + "[]"))
+            {
+                if (value is JsonArray array)
+                    result[field] = new JsonArray(array.OfType<JsonObject>()
+                        // An unrevealed item's dimensions can disclose its identity for free.
+                        .Where(item => childPath != "crystal_sphere.items" ||
+                            item["revealed"] is JsonValue revealed && revealed.TryGetValue<bool>(out var visible) && visible)
+                        .Select(item => (JsonNode?)ProjectObject(item, childPath + "[]")).ToArray());
+            }
+            else if (value is null || value is JsonValue)
+            {
+                result[field] = value?.DeepClone();
+            }
+            else if (value is JsonArray leaves && leaves.All(item => item is null || item is JsonValue))
+            {
+                result[field] = leaves.DeepClone();
+            }
+        }
+        return result;
+    }
