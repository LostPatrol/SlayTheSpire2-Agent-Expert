new file mode 100644
index 0000000..5bb89a2
--- /dev/null
+++ b/STS2AIAgent/Game/FairDecisionProtocol.cs
@@ -0,0 +1,278 @@
+// Public-only projection and observation tokens for the external single-player controller.
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using STS2AIAgent.Server;
+
+namespace STS2AIAgent.Game;
+
+internal static class FairDecisionProtocol
+{
+    // Increment when the public projection or guarded execution contract changes.
+    public const int Version = 1;
+
+    // Observation metadata evolves independently of the guarded-action wire protocol.
+    public const int ObservationSchemaVersion = 2;
+
+    // A random process identity lets a controller detect that in-memory receipts were lost.
+    public static string InstanceId { get; } = Guid.NewGuid().ToString("N");
+
+    // Count successful guarded dispatches so returning to an identical public scene cannot reuse a token.
+    private static long _actionRevision;
+
+    /// <summary>Advance only after an accepted guarded handler returns, never for hidden state changes.</summary>
+    public static void AdvanceActionRevision() => _actionRevision++;
+
+    // Only reviewed single-player screens admit guarded actions.
+    private static readonly HashSet<string> Screens = new(StringComparer.Ordinal)
+    {
+        "MAIN_MENU", "CHARACTER_SELECT", "COMBAT", "MAP", "REWARD", "CARD_SELECTION",
+        "SHOP", "FAKE_MERCHANT", "REST", "EVENT", "CHEST", "GAME_OVER", "MODAL",
+        "BUNDLE_SELECTION", "CAPSTONE_SELECTION", "UNLOCK", "CARDS_VIEW", "CARD_PILE", "CRYSTAL_SPHERE"
+    };
+
+    // Strategy-bearing reward macros and debug/multiplayer operations are intentionally absent.
+    private static readonly HashSet<string> Actions = new(StringComparer.Ordinal)
+    {
+        "end_turn", "play_card", "continue_run", "continue_game_over", "open_character_select",
