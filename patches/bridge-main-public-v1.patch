@@ -0,0 +1,103 @@
+// Observe public selection causes without replacing selectors or changing native choices.
+// The passive CardSelectCmd prefix follows Spire Mentor's MIT SimCardSelectContext pattern.
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.GameActions.Multiplayer;
+using MegaCrit.Sts2.Core.Logging;
+using MegaCrit.Sts2.Core.Localization;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Nodes.Screens.CardSelection;
+using MegaCrit.Sts2.Core.Nodes.Screens.ScreenContext;
+
+namespace STS2AIAgent.Game;
+
+internal static class PublicSelectionContext
+{
+    // Preferences are a value type; their real Prompt reference plus public bounds bind UI evidence.
+    private static readonly ConditionalWeakTable<LocString, Context> Contexts = new();
+    // Bind a UI model only to the real returned screen; snapshots require visible preview agreement.
+    private static readonly ConditionalWeakTable<NDeckEnchantSelectScreen, WeakReference<EnchantmentModel>> Enchantments = new();
+    // Mod initialization may be called more than once in the same process.
+    private static int _installed;
+
+    /// <summary>Retain the causal model weakly; snapshots separately verify that the source is public.</summary>
+    internal sealed record Context(string EntryPoint, WeakReference<AbstractModel>? Source,
+        int MinSelect, int MaxSelect, bool Cancelable, bool ManualConfirmation, string PromptTable, string PromptKey);
+
+    /// <summary>Install capture-only prefixes; an unavailable optional capture never disables the bridge.</summary>
+    internal static void Initialize()
+    {
+        if (Interlocked.Exchange(ref _installed, 1) != 0)
+            return;
+        var harmony = new Harmony("STS2AIAgent.PublicSelectionContext");
+        foreach (var method in typeof(CardSelectCmd).GetMethods(BindingFlags.Public | BindingFlags.Static)
+                     .Where(method => method.GetParameters().Any(parameter => parameter.ParameterType == typeof(CardSelectorPrefs))))
+        {
+            try { harmony.Patch(method, prefix: new HarmonyMethod(typeof(PublicSelectionContext), nameof(Capture))); }
+            catch (Exception ex)
+            {
+                Log.Warn($"[STS2AIAgent] Optional public selection capture unavailable: {method.Name}: {ex.GetType().Name}");
+            }
+        }
+        try
+        {
+            var show = typeof(NDeckEnchantSelectScreen).GetMethods(BindingFlags.Public | BindingFlags.Static)
+                .Single(method => method.Name == "ShowScreen" && method.GetParameters()
+                    .Any(parameter => parameter.ParameterType == typeof(EnchantmentModel)));
+            harmony.Patch(show, postfix: new HarmonyMethod(typeof(PublicSelectionContext), nameof(CaptureEnchantment)));
+        }
+        catch (Exception ex)
+        {
+            Log.Warn($"[STS2AIAgent] Optional public enchantment capture unavailable: {ex.GetType().Name}");
+        }
+    }
+
+    /// <summary>Observe only the enchantment passed into the actual visible selection UI.</summary>
+    private static void CaptureEnchantment(object[] __args, NDeckEnchantSelectScreen __result)
+    {
+        if (__result == null || __args.OfType<EnchantmentModel>().FirstOrDefault() is not { } enchantment)
+            return;
+        Enchantments.Remove(__result);
+        Enchantments.Add(__result, new WeakReference<EnchantmentModel>(enchantment));
+    }
+
+    /// <summary>Return UI evidence for subsequent visible-preview verification, without pending state reads.</summary>
+    internal static EnchantmentModel? ReadEnchantment(IScreenContext? screen)
+    {
+        return screen is NDeckEnchantSelectScreen enchant && Enchantments.TryGetValue(enchant, out var weak)
+            && weak.TryGetTarget(out var model) ? model : null;
+    }
+
+    /// <summary>Match the real Prompt identity and native public preference values, never a boxed struct.</summary>
+    internal static Context? Read(CardSelectorPrefs? prefs)
+    {
+        if (!prefs.HasValue || prefs.Value.Prompt is not { } prompt || !Contexts.TryGetValue(prompt, out var context))
+            return null;
+        var current = prefs.Value;
+        return context.MinSelect == current.MinSelect && context.MaxSelect == current.MaxSelect
+            && context.Cancelable == current.Cancelable && context.ManualConfirmation == current.RequireManualConfirmation
+            && context.PromptTable == prompt.LocTable && context.PromptKey == prompt.LocEntryKey ? context : null;
+    }
+
+    /// <summary>Record the declared source, falling back to the game's public choice-context attribution.</summary>
+    private static void Capture(object?[]? __args, MethodBase __originalMethod)
+    {
+        try
+        {
+            var prefs = __args?.OfType<CardSelectorPrefs>().FirstOrDefault();
+            if (!prefs.HasValue || prefs.Value.Prompt is not { } prompt)
+                return;
+            var source = __args!.OfType<AbstractModel>().FirstOrDefault()
+                ?? __args!.OfType<PlayerChoiceContext>().FirstOrDefault()?.LastInvolvedModel;
+            var current = prefs.Value;
+            Contexts.Remove(prompt);
+            Contexts.Add(prompt, new Context(__originalMethod.Name,
+                source == null ? null : new WeakReference<AbstractModel>(source), current.MinSelect, current.MaxSelect,
+                current.Cancelable, current.RequireManualConfirmation, prompt.LocTable, prompt.LocEntryKey));
+        }
+        catch { /* Observation must not interrupt native card selection. */ }
+    }
+}
