+// Export actual packaged producer contracts from typed raw DTOs without starting the game.
+using System.Reflection;
+using System.Runtime.Loader;
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.Json.Serialization;
+
+namespace STS2AIAgent.Tests;
+
+internal static class PublicProducerContractExporter
+{
+    // Explicit export mode is separate from the normal 905-test regression entry point.
+    internal const string OutputVariable = "STS2_BRIDGE_CONTRACT_EXPORT_DIR";
+    // Preserve readable evidence while rejecting misspelled raw DTO property names.
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        WriteIndented = true,
+        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow
+    };
+
+    /// <summary>Load the already packaged DLL and call its actual DTO compactors and public projector.</summary>
+    internal static void Export(string destination)
+    {
+        var root = Path.GetFullPath(Path.Combine(AgentSourceFixture.Root, "../.."));
+        var output = Path.GetFullPath(destination);
+        var allowed = Path.GetFullPath(Path.Combine(root, "agent/codex/network-alignment-20261030/bridge"));
+        Assert.True(output.Equals(allowed, StringComparison.OrdinalIgnoreCase)
+            || output.StartsWith(allowed + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase));
+        var inputPath = Environment.GetEnvironmentVariable("STS2_BRIDGE_CONTRACT_INPUT")
+            ?? Path.Combine(root, "agent/codex/network-alignment-20261030/audit/selection-contract-input.json");
+        var dllPath = Environment.GetEnvironmentVariable("STS2_BRIDGE_CONTRACT_DLL")
+            ?? Path.Combine(AgentSourceFixture.Root, "build/mods/STS2AIAgent/STS2AIAgent.dll");
+        var machine = JsonNode.Parse(File.ReadAllText(Path.Combine(root, "configs/machine.json")))!;
+        var gameData = Path.Combine(machine["game_root"]!.GetValue<string>(), "data_sts2_windows_x86_64");
+        // Resolve dependencies without constructing or starting the native game.
+        Assembly? Resolver(AssemblyLoadContext context, AssemblyName name)
+        {
+            var path = Path.Combine(gameData, name.Name + ".dll");
+            return File.Exists(path) ? context.LoadFromAssemblyPath(path) : null;
+        }
+        AssemblyLoadContext.Default.Resolving += Resolver;
+        try
+        {
+            var assembly = AssemblyLoadContext.Default.LoadFromAssemblyPath(Path.GetFullPath(dllPath));
+            var producer = new Producer(assembly);
+            Directory.CreateDirectory(output);
+            ExportNativePublicApi(output);
+            var witness = JsonNode.Parse(File.ReadAllText(inputPath))!.AsObject();
+            var identity = new JsonObject
+            {
+                ["scope"] = "synthetic_typed_raw_dto_contract_not_native_capture",
+                ["bridge_dll"] = Path.GetFullPath(dllPath),
+                ["bridge_dll_sha256"] = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(dllPath))),
+                ["witness_path"] = Path.GetFullPath(inputPath),
+                ["witness_sha256"] = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(inputPath))),
+                ["production_methods"] = new JsonArray("BuildAgentViewPayload", "BuildAgentSelectionPayload",
+                    "BuildAgentChoiceCardPayload", "BuildAgentCardStacks", "BuildPublicStatePayload", "FairDecisionProtocol.Token"),
+                ["native_world"] = "absent; public piles use the production raw-DTO stack compactor",
+                ["keyword_source"] = "independent frozen core inspect: Pact/Strike/Defend all have an empty effective keyword set"
+            };
+            Directory.CreateDirectory(output);
+            if (Environment.GetEnvironmentVariable("STS2_BRIDGE_CONTRACT_REWARD_MULTIROW_ONLY") == "1")
+            {
+                foreach (var (name, raw) in NativePublicOfferScenes(root).Where(scene => scene.Name.StartsWith("reward-multirow-", StringComparison.Ordinal)))
+                {
+                    var projected = producer.Project(raw);
+                    AssertScene(name, projected);
+                    var metadata = identity.DeepClone().AsObject();
+                    metadata.Remove("witness_path"); metadata.Remove("witness_sha256"); metadata.Remove("keyword_source");
+                    var playerSource = Path.Combine(root, "agent/codex/network-alignment-20261030/bridge/native-public-offers-probe.json");
+                    metadata["public_player_source"] = playerSource;
+                    metadata["public_player_source_sha256"] = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(playerSource)));
+                    metadata["production_methods"] = new JsonArray("BuildAgentViewPayload", "BuildAgentRewardPayload",
+                        "BuildAgentRunPayload", "BuildAgentCardStacks", "BuildPublicStatePayload", "FairDecisionProtocol.Token");
+                    metadata["native_world"] = "absent; typed synthetic reward queue and UI controls";
+                    metadata["case_scope"] = "synthetic_typed_multirow_reward_queue_on_native_public_player_context_not_native_UI_capture";
+                    metadata["ui_scope"] = "visible/claimable are controlled input variants; no actual reward button scene captured";
+                    metadata["controlled_potion_slot_count"] = 2;
+                    metadata["comparison_scope"] = "Core atomic potion swap may be compared only after both native-shaped steps; intermediate frame is virtual";
+                    Write(output, name, producer, metadata, raw, projected);
+                }
+                Console.WriteLine($"Exported 2 actual producer multirow contracts to {output}");
+                return;
+            }
+            var current = witness["current"]!.AsObject();
+            var selectionRaw = RawPosition(current, "CARD_SELECTION");
+            selectionRaw["selection"] = RawSelection(current["selection"]!.AsObject(), witness["before"]!["combat"]!["hand"]![0]!.AsObject());
+            var selection = producer.Project(selectionRaw, current, witness["before"]!["combat"]!["hand"]![0]!.AsObject());
+            Assert.Equal(1, selection["selection"]!["min"]!.GetValue<int>());
+            Assert.Equal(1, selection["selection"]!["max"]!.GetValue<int>());
+            Assert.False(selection["selection"]!.AsObject().ContainsKey("min_select"));
+            Assert.False(selection["selection"]!["requires_confirmation"]!.GetValue<bool>());
+            Assert.False(selection["selection"]!["confirm"]!.GetValue<bool>());
+            Assert.Equal(14, selection["selection"]!["cards"]![0]!["i"]!.GetValue<int>());
+            Assert.Equal(11, selection["selection"]!["cards"]![1]!["i"]!.GetValue<int>());
+            Assert.Equal("BURNING_PACT", selection["combat"]!["play"]![0]!["card_id"]!.GetValue<string>());
+            Assert.Equal("80/80", selection["combat"]!["player"]!["hp"]!.GetValue<string>());
+            Write(output, "selection", producer, identity, selectionRaw, selection,
+                current["public_history"] as JsonObject);
+            var confirmRaw = selectionRaw.DeepClone().AsObject();
+            confirmRaw["selection"]!["requires_confirmation"] = true;
+            confirmRaw["selection"]!["selected_count"] = 1;
+            confirmRaw["selection"]!["can_confirm"] = true;
+            confirmRaw["selection"]!["cards"]![0]!["selected"] = true;
+            var confirm = producer.Project(confirmRaw, current, witness["before"]!["combat"]!["hand"]![0]!.AsObject());
+            Assert.True(confirm["selection"]!["requires_confirmation"]!.GetValue<bool>());
+            Assert.True(confirm["selection"]!["confirm"]!.GetValue<bool>());
+            Assert.Equal(1, confirm["selection"]!["selected"]!.GetValue<int>());
+            Assert.True(confirm["selection"]!["cards"]![0]!["selected"]!.GetValue<bool>());
+            Assert.False(producer.Token(selection) == producer.Token(confirm));
+            var confirmIdentity = identity.DeepClone().AsObject();
+            confirmIdentity["case_scope"] = "manual_confirmation_shape_only_without_reachable_core_claim";
+            Write(output, "selection-confirmation", producer, confirmIdentity, confirmRaw, confirm);
+            var combatRaw = RawPosition(witness["before"]!.AsObject(), "COMBAT");
+            Write(output, "combat", producer, identity, combatRaw, producer.Project(combatRaw, witness["before"]!.AsObject()));
+            foreach (var (name, raw) in OtherScenes().Concat(NativePublicOfferScenes(root)))
+            {
+                var projected = producer.Project(raw);
+                AssertScene(name, projected);
+                var shapeIdentity = identity.DeepClone().AsObject();
+                shapeIdentity["case_scope"] = "isolated_scene_shape_without_reachable_core_or_policy_success_claim";
+                if (name.EndsWith("-complete", StringComparison.Ordinal))
+                {
+                    var offers = Path.Combine(root, "agent/codex/network-alignment-20261030/bridge/native-public-offers-probe.json");
+                    shapeIdentity["case_scope"] = "strict_native_public_graph_and_offers_to_typed_dto_no_native_ui_capture";
+                    shapeIdentity["public_offer_source"] = offers;
+                    shapeIdentity["public_offer_source_sha256"] = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(offers)));
+                }
+                if (name.StartsWith("reward-native-model-", StringComparison.Ordinal))
+                {
+                    shapeIdentity["native_reward_source"] = Path.Combine(root,
+                        "agent/codex/network-alignment-20261030/bridge/reward-gates-v1/native-reward-readback.json");
+                    shapeIdentity["ui_scope"] = "claimable/visible are controlled UI variants; no native button IsEnabled or scene capture";
+                }
+                Write(output, name, producer, shapeIdentity, raw, projected);
+            }
+            Console.WriteLine($"Exported 17 actual producer contracts to {output}");
+        }
+        finally { AssemblyLoadContext.Default.Resolving -= Resolver; }
+    }
+
+    /// <summary>Record public native UI metadata only; never inspect method bodies or hidden pending values.</summary>
+    private static void ExportNativePublicApi(string output)
+    {
+        var native = Assembly.Load("sts2");
+        var contracts = new JsonObject();
+        foreach (var name in new[] { "NDeckEnchantSelectScreen", "NChooseACardSelectionScreen", "CardSelectorPrefs", "NCard",
+                     "NRewardButton", "Reward", "PotionReward", "RelicReward" })
+        {
+            var type = native.GetExportedTypes().Single(candidate => candidate.Name == name);
+            const BindingFlags flags = BindingFlags.Public | BindingFlags.Instance | BindingFlags.Static | BindingFlags.DeclaredOnly;
+            contracts[name] = new JsonObject
+            {
+                ["type"] = type.FullName,
+                ["properties"] = new JsonArray(type.GetProperties(flags).Select(member => (JsonNode?)$"{member.PropertyType.FullName} {member.Name}").ToArray()),
+                ["fields"] = new JsonArray(type.GetFields(flags).Select(member => (JsonNode?)$"{member.FieldType.FullName} {member.Name}").ToArray()),
+                ["constructors"] = new JsonArray(type.GetConstructors().Select(member => (JsonNode?)member.ToString()).ToArray()),
+                ["methods"] = new JsonArray(type.GetMethods(flags).Where(member => !member.IsSpecialName).Select(member => (JsonNode?)member.ToString()).ToArray())
+            };
+        }
+        File.WriteAllText(Path.Combine(output, "native-public-ui-api.json"), contracts.ToJsonString(JsonOptions));
+        var declarations = typeof(GameStateServiceRelocationContractTests).GetMethod("Declarations", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var hashes = new JsonObject();
+        foreach (var file in new[] { "GameStateService.cs", "GameStateService.Run.cs", "GameStateService.Rewards.cs", "GameStateService.Potions.cs", "GameStateService.Combat.cs" })
+        {
+            var members = (Dictionary<string, string>)declarations.Invoke(null, new object[] { AgentSourceFixture.Read("STS2AIAgent/Game/" + file) })!;
+            foreach (var name in new[] { "EnumerateAvailableActions", "BuildAvailableActionNames", "BuildRunPayload", "BuildSelectionPayload", "BuildRewardOptionPayload", "CanDiscardPotionsInCurrentScreen", "BuildHandCardPayload", "BuildSelectionCardPayload" })
+                if (members.TryGetValue(name, out var text)) hashes[name] = Convert.ToHexString(SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
+        }
+        File.WriteAllText(Path.Combine(output, "intentional-declaration-hashes.json"), hashes.ToJsonString(JsonOptions));
+        var declaration = typeof(PredicateRelocationContractTests).GetMethod("DeclarationText", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var predicate = (string)declaration.Invoke(null, new object[] { AgentSourceFixture.Read("STS2AIAgent/Game/GameStateService.Predicates.cs"), "CanClaimReward", 0 })!;
+        File.WriteAllText(Path.Combine(output, "intentional-predicate-hash.txt"), Convert.ToHexString(
+            SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(predicate))).ToLowerInvariant());
+    }
+
+    /// <summary>Store raw inputs and produced wire outputs separately, with explicit synthetic provenance.</summary>
+    private static void Write(string output, string name, Producer producer, JsonObject identity,
+        JsonObject raw, JsonObject projected, JsonObject? history = null)
+    {
+        var envelope = new JsonObject
+        {
+            ["metadata"] = identity.DeepClone(), ["public_state"] = projected,
+            ["public_observation_token"] = producer.Token(projected)
+        };
+        if (history != null) envelope["public_history"] = history.DeepClone();
+        File.WriteAllText(Path.Combine(output, $"contract-{name}.json"), envelope.ToJsonString(JsonOptions));
+        File.WriteAllText(Path.Combine(output, $"contract-{name}-raw.json"), raw.ToJsonString(JsonOptions));
+    }
+
+    /// <summary>Assert public semantic keys against their independently declared typed raw inputs.</summary>
+    private static void AssertScene(string name, JsonObject projected)
+    {
+        if (name.StartsWith("reward-native-model-", StringComparison.Ordinal))
+        {
+            var row = projected["reward"]!["rewards"]![0]!;
+            var selected = name.EndsWith("already-claimed-same-reward-object", StringComparison.Ordinal);
+            Assert.Equal(selected, row["successfully_selected"]!.GetValue<bool>());
+            Assert.True(row["visible"]!.GetValue<bool>());
+            if (name.EndsWith("full-belt", StringComparison.Ordinal))
+            {
+                Assert.False(row["claimable"]!.GetValue<bool>());
+                Assert.False(row["potion_slot_available"]!.GetValue<bool>());
+                Assert.True(row["potion_procurement_allowed"]!.GetValue<bool>());
+            }
+        }
+        switch (name)
+        {
+            case "event":
+                Assert.Equal("NEOW.pages.INITIAL.options.ARCANE_SCROLL", projected["event"]!["options"]![0]!["option_id"]!.GetValue<string>());
+                Assert.Equal("ARCANE_SCROLL", projected["event"]!["options"]![0]!["preview_relic_ids"]![0]!.GetValue<string>());
+                Assert.Equal("失去{HpLoss}点生命。", projected["event"]!["options"]![0]!["description_template"]!.GetValue<string>());
+                Assert.Equal("失去7点生命。", projected["event"]!["options"]![0]!["description"]!.GetValue<string>());
+                Assert.Equal("events", projected["event"]!["options"]![0]!["description_loc_table"]!.GetValue<string>());
+                Assert.Equal("contract.description", projected["event"]!["options"]![0]!["description_loc_key"]!.GetValue<string>());
+                break;
+            case "map":
+                Assert.Equal(4, projected["map"]!["options"]![0]!["coord"]!["row"]!.GetValue<int>());
+                Assert.Equal(2, projected["map"]!["options"]![0]!["coord"]!["col"]!.GetValue<int>());
+                break;
+            case "shop":
+                Assert.Equal(77, projected["shop"]!["cards"]![0]!["price"]!.GetValue<int>());
+                Assert.True(projected["shop"]!["cards"]![0]!["stocked"]!.GetValue<bool>());
+                Assert.False(projected["shop"]!["cards"]![0]!["affordable"]!.GetValue<bool>());
+                Assert.Equal(199, projected["shop"]!["relics"]![0]!["price"]!.GetValue<int>());
+                Assert.Equal(55, projected["shop"]!["potions"]![0]!["price"]!.GetValue<int>());
+                break;
+            case "rest": Assert.Equal("SMITH", projected["rest"]!["options"]![0]!["option_id"]!.GetValue<string>()); break;
+            case "reward": Assert.Equal("STRIKE_IRONCLAD", projected["reward"]!["cards"]![0]!["card_id"]!.GetValue<string>()); break;
+            case "reward-relic":
+                Assert.Equal("VAJRA", projected["reward"]!["rewards"]![0]!["relic_id"]!.GetValue<string>());
+                Assert.Equal(3, projected["reward"]!["rewards"]![0]!["i"]!.GetValue<int>());
+                break;
+            case "reward-potion-swap":
+                Assert.Equal("BLOCK_POTION", projected["reward"]!["rewards"]![0]!["potion_id"]!.GetValue<string>());
+                Assert.False(projected["reward"]!["rewards"]![0]!["potion_slot_available"]!.GetValue<bool>());
+                Assert.True(projected["reward"]!["rewards"]![0]!["potion_procurement_allowed"]!.GetValue<bool>());
+                Assert.True(projected["run"]!["potions"]!.AsArray().All(slot => slot!["discard"]!.GetValue<bool>()));
+                break;
+            case "reward-multirow-relics":
+                Assert.Equal("ANCHOR", projected["reward"]!["rewards"]![0]!["relic_id"]!.GetValue<string>());
+                Assert.Equal("VAJRA", projected["reward"]!["rewards"]![1]!["relic_id"]!.GetValue<string>());
+                Assert.Equal(2, projected["run"]!["potions"]!.AsArray().Count);
