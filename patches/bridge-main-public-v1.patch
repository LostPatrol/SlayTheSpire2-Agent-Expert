+++ b/STS2AIAgent/Game/GameStateService.Events.cs
@@ -0,0 +1,130 @@
+// Capture current event text, stable option keys and explicit visible previews.
+using MegaCrit.Sts2.Core.Logging;
+using MegaCrit.Sts2.Core.Nodes.Rooms;
+using MegaCrit.Sts2.Core.Nodes.Screens.ScreenContext;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Copy current visible event options and explicit native relic previews in one frame.</summary>
+    private static EventPayload? BuildEventPayload(IScreenContext? currentScreen)
+    {
+        if (currentScreen is not NEventRoom)
+        {
+            return null;
+        }
+
+        try
+        {
+            var eventModel = RunManager.Instance.EventSynchronizer.GetLocalEvent();
+            if (eventModel == null)
+            {
+                return null;
+            }
+
+            var options = new List<EventOptionPayload>();
+
+            if (eventModel.IsFinished)
+            {
+                // Mirror NEventRoom.SetOptions(): synthesize a Proceed option
+                options.Add(new EventOptionPayload
+                {
+                    index = 0,
+                    text_key = "PROCEED",
+                    title = "Proceed",
+                    description = "",
+                    is_locked = false,
+                    is_proceed = true
+                });
+            }
+            else
+            {
+                var currentOptions = eventModel.CurrentOptions;
+                for (int i = 0; i < currentOptions.Count; i++)
+                {
+                    var opt = currentOptions[i];
+                    // Relic is the explicit option preview; do not resolve possible rewards from TextKey.
+                    var previewRelicId = SafeReadString(() => opt.Relic?.Id.Entry);
+                    options.Add(new EventOptionPayload
+                    {
+                        index = i,
+                        text_key = SafeReadString(() => opt.TextKey),
+                        label_loc_table = SafeReadString(() => opt.Title?.LocTable),
+                        label_loc_key = SafeReadString(() => opt.Title?.LocEntryKey),
+                        label_template = SafeReadString(() => opt.Title?.GetRawText()),
+                        description_loc_table = SafeReadString(() => opt.Description?.LocTable),
+                        description_loc_key = SafeReadString(() => opt.Description?.LocEntryKey),
+                        description_template = SafeReadString(() => opt.Description?.GetRawText()),
+                        title = SafeReadString(() => EventOptionLocalization.Format(
+                            opt.Title,
+                            locString => eventModel.DynamicVars.AddTo(locString),
+                            locString => locString.GetFormattedText())),
+                        description = SafeReadString(() => EventOptionLocalization.Format(
+                            opt.Description,
+                            locString => eventModel.DynamicVars.AddTo(locString),
+                            locString => locString.GetFormattedText())),
+                        is_locked = SafeReadBool(() => opt.IsLocked),
+                        is_proceed = SafeReadBool(() => opt.IsProceed),
+                        will_kill_player = GetEventOptionWillKillPlayer(eventModel, opt),
+                        has_relic_preview = !string.IsNullOrEmpty(previewRelicId),
+                        preview_relic_ids = string.IsNullOrEmpty(previewRelicId)
+                            ? Array.Empty<string>() : new[] { previewRelicId }
+                    });
+                }
+            }
+
+            return new EventPayload
+            {
+                event_id = SafeReadString(() => eventModel.Id?.Entry, "unknown"),
+                title = SafeReadString(() => eventModel.Title?.GetFormattedText()),
+                description = SafeReadString(() => eventModel.Description?.GetFormattedText()),
+                is_finished = SafeReadBool(() => eventModel.IsFinished),
+                options = options.ToArray()
+            };
+        }
+        catch (Exception ex)
+        {
+            Log.Warn($"[STS2AIAgent] Failed to build event payload on screen {currentScreen.GetType().FullName}: {ex}");
+            return null;
+        }
+    }
+
+    /// <summary>Keep visible event text and native option keys as separate structured fields.</summary>
+    private static object? BuildAgentEventPayload(EventPayload? eventPayload)
+    {
+        if (eventPayload == null)
+        {
+            return null;
+        }
+
+        return new
+        {
+            id = eventPayload.event_id,
+            title = eventPayload.title,
+            description = eventPayload.description,
+            finished = eventPayload.is_finished,
+            options = eventPayload.options.Select(option => new
+            {
+                i = option.index,
+                option_id = option.text_key,
+                text_key = option.text_key,
+                label_loc_table = option.label_loc_table,
+                label_loc_key = option.label_loc_key,
+                label_template = option.label_template,
+                description_loc_table = option.description_loc_table,
+                description_loc_key = option.description_loc_key,
+                description_template = option.description_template,
+                label = option.title,
+                description = option.description,
+                line = FormatEventOptionLine(option),
+                locked = option.is_locked,
+                proceed = option.is_proceed,
+                kill = option.will_kill_player,
+                has_relic_preview = option.has_relic_preview,
+                preview_relic_ids = option.preview_relic_ids
+            }).ToArray()
+        };
+    }
+}
