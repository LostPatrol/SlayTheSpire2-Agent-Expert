+// Supply host identity, logging and snapshot sequencing to the directly linked Mentor serializer.
+namespace SpireMentor;
+
+internal static class MainFile
+{
+    // Identify the embedding bridge without claiming to run Mentor's UI or automation mod.
+    public const string ModVersion = "STS2AIAgent-mentor-wire-v1";
+}
+
+internal static class Logger
+{
+    /// <summary>Send extraction diagnostics through the bridge's native game logger.</summary>
+    public static void Log(string message) => MegaCrit.Sts2.Core.Logging.Log.Info(message);
+}
+
+internal static class SimProtocolHelpers
+{
+    // The upstream builder drops this envelope identifier when embedding a private board.
+    private static long _stateId;
+
+    /// <summary>Allocate the original envelope sequence without adding any action transport.</summary>
+    public static long NextStateId() => Interlocked.Increment(ref _stateId);
+}
