+namespace STS2AIAgent.Tests;
+
+internal static class PublicRulesTextTests
+{
+    /// <summary>Both original image tags and older stripped observations retain two energy.</summary>
+    public static void PreservesEnergyAndPublicNumbers()
+    {
+        var icon = "res://images/packed/sprite_fonts/ironclad_energy_icon.png";
+        var tagged = $"失去[blue]3[/blue]点生命。 获得[img]{icon}[/img][img]{icon}[/img]。";
+        var legacy = $"失去3点生命。 获得{icon}{icon}。";
+        Assert.Equal("失去3点生命。 获得⚡⚡。", PublicRulesText.Normalize(tagged));
+        Assert.Equal(PublicRulesText.Normalize(tagged), PublicRulesText.Normalize(legacy));
+        Assert.Equal("〔图标:unfamiliar〕", PublicRulesText.Normalize("[img]res://icons/unfamiliar.png[/img]"));
+    }
+}
