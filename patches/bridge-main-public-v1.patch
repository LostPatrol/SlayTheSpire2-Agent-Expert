+    /// <summary>Project only the reviewed compact schema, retaining the native legal action intersection.</summary>
+    public static JsonObject Project(object? compact)
+    {
+        var source = JsonSerializer.SerializeToNode(compact) as JsonObject ?? new JsonObject();
+        var screen = source["screen"] is JsonValue screenValue && screenValue.TryGetValue<string>(out var name)
+            ? name : "UNKNOWN";
+        var supported = source["version"] is JsonValue version && version.TryGetValue<int>(out var number)
+            && number == 11 && Screens.Contains(screen)
+            && source["session"] is JsonObject session && session["mode"] is JsonValue mode
+            && mode.TryGetValue<string>(out var modeName) && modeName == "singleplayer";
+        if (!supported)
+        {
+            return new JsonObject { ["protocol_version"] = Version, ["screen"] = screen,
+                ["supported"] = false, ["available_actions"] = new JsonArray() };
+        }
+
+        var result = ProjectObject(source, "");
+        result["protocol_version"] = Version;
+        result["observation_schema_version"] = ObservationSchemaVersion;
+        result["action_revision"] = _actionRevision;
+        result["supported"] = true;
+        result["available_actions"] = new JsonArray((source["available_actions"] as JsonArray ?? new JsonArray())
+            .OfType<JsonValue>().Select(value => value.TryGetValue<string>(out var action) ? action : string.Empty)
+            .Where(Actions.Contains).Distinct(StringComparer.Ordinal).OrderBy(value => value, StringComparer.Ordinal)
+            .Select(value => (JsonNode?)JsonValue.Create(value)).ToArray());
+        return result;
+    }
