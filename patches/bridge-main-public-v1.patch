+// Observe the original public pre-turn-end boundary; never change native energy or infer missed turns.
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Hooks;
+using MegaCrit.Sts2.Core.Logging;
+
+namespace STS2AIAgent.Game;
+
+internal static class NativeTurnEnergyObserver
+{
+    // Weak combat keys keep the coverage and cumulative value scoped to the actual native fight.
+    private static readonly ConditionalWeakTable<ICombatState, Observation> States = new();
+    // Both public prefixes must be installed before any observation can be considered complete.
+    private static int _installed;
+    private static bool _hooksComplete;
+
+    /// <summary>Record actual combat birth, logical player turns and their observed boundary energy.</summary>
+    private sealed class Observation
+    {
+        internal Player? Owner;
+        internal bool Complete = true;
+        internal int Sum;
+        internal readonly HashSet<int> Turns = new();
+    }
+
+    /// <summary>Install passive original public Hook prefixes once; incomplete installation leaves values unknown.</summary>
+    internal static void Initialize()
+    {
+        if (Interlocked.Exchange(ref _installed, 1) != 0) return;
+        try
+        {
+            var harmony = new Harmony("STS2AIAgent.NativeTurnEnergyObserver");
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.BeforeCombatStart))!,
+                prefix: new HarmonyMethod(typeof(NativeTurnEnergyObserver), nameof(BeforeCombatStart)));
+            harmony.Patch(typeof(Hook).GetMethod(nameof(Hook.BeforeTurnEnd))!,
+                prefix: new HarmonyMethod(typeof(NativeTurnEnergyObserver), nameof(BeforeTurnEnd)));
+            _hooksComplete = true;
+        }
+        catch (Exception error)
+        {
+            Log.Warn($"[STS2AIAgent] Public turn-end energy unavailable: {error.GetType().Name}");
+        }
+    }
+
+    /// <summary>Return a complete from-birth sum or null; reading never fabricates a missed combat observation.</summary>
+    internal static int? Read(ICombatState? combatState, Player? player)
+    {
+        if (!_hooksComplete || combatState == null || player == null || !States.TryGetValue(combatState, out var state)
+            || !state.Complete || state.Owner != null && !ReferenceEquals(state.Owner, player)) return null;
+        state.Owner ??= player;
+        return state.Sum;
+    }
+
+    /// <summary>Only the actual public birth hook establishes full-combat coverage.</summary>
+    private static void BeforeCombatStart(ICombatState combatState)
+    {
+        try { States.GetValue(combatState, _ => new Observation()); }
+        catch (Exception error) { Log.Warn($"[STS2AIAgent] Public combat energy birth unavailable: {error.GetType().Name}"); }
+    }
+
+    /// <summary>Bank positive energy after Howl/post-play effects, before turn-end listeners, excluding terminal combat.</summary>
+    private static void BeforeTurnEnd(ICombatState combatState, CombatSide side)
+    {
+        if (!_hooksComplete || side != CombatSide.Player || !States.TryGetValue(combatState, out var state)) return;
+        try
+        {
+            var manager = CombatManager.Instance;
+            // Native can still call this hook after Howl wins; the original model does not bank that terminal turn.
+            if (manager == null || manager.IsOverOrEnding) return;
+            var player = GameStateService.GetLocalPlayer(combatState as CombatState);
+            if (!ReferenceEquals(manager.DebugOnlyGetState(), combatState) || player?.PlayerCombatState == null
+                || state.Owner != null && !ReferenceEquals(state.Owner, player)) { state.Complete = false; return; }
+            state.Owner ??= player;
+            // TurnNumber is the public logical player turn, so a resumed/repeated hook cannot charge it twice.
+            if (state.Turns.Add(player.PlayerCombatState.TurnNumber))
+                state.Sum = checked(state.Sum + Math.Max(player.PlayerCombatState.Energy, 0));
+        }
+        catch (Exception error)
+        {
+            state.Complete = false;
+            Log.Warn($"[STS2AIAgent] Public turn-end energy observation unavailable: {error.GetType().Name}");
+        }
+    }
+}
diff --git a/STS2AIAgent/Game/PublicInstanceIdentity.cs b/STS2AIAgent/Game/PublicInstanceIdentity.cs
new file mode 100644
index 0000000..3ca312f
--- /dev/null
+++ b/STS2AIAgent/Game/PublicInstanceIdentity.cs
@@ -0,0 +1,42 @@
+// Stable public labels for object identity, independent of gameplay fields and RNG.
+using System.Globalization;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace STS2AIAgent.Game;
+
+internal static class PublicInstanceIdentity<T> where T : class
+{
+    // Weak keys do not retain creatures after their native combat lifetime ends.
+    private static readonly ConditionalWeakTable<T, Identity> Identities = new();
+    // Labels are unique for this object type throughout the current bridge process.
+    private static long _nextIdentity;
+
+    /// <summary>Store only the generated public label, never native state.</summary>
+    private sealed record Identity(string Value)
+    {
+        // Only explicit public observations set this marker; lookup never creates a label.
+        internal int Observed;
+    }
+
+    /// <summary>Keep one label while indices shift; a different object always receives a new label.</summary>
+    internal static string Get(T instance, string prefix = "enemy") =>
+        Identities.GetValue(instance, value => Create(value, prefix)).Value;
+
+    /// <summary>Mark only an instance actually emitted on a public hand, play or selection surface.</summary>
+    internal static string Observe(T instance, string prefix = "card")
+    {
+        var identity = Identities.GetValue(instance, value => Create(value, prefix));
+        Volatile.Write(ref identity.Observed, 1);
+        return identity.Value;
+    }
+
+    /// <summary>Return a previously public identity without allocation or observation side effects.</summary>
+    internal static string? GetIfObserved(T instance) =>
+        Identities.TryGetValue(instance, out var identity) && Volatile.Read(ref identity.Observed) != 0
+            ? identity.Value : null;
+
+    /// <summary>Allocate monotonically without using game properties, hashes, or random streams.</summary>
+    private static Identity Create(T instance, string prefix) => new(prefix + "-" +
+        Interlocked.Increment(ref _nextIdentity).ToString(CultureInfo.InvariantCulture));
+}
