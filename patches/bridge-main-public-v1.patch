+    /// <summary>Retain witnessed HP values while accepting the core witness's structured numeric form.</summary>
+    private static (int Current, int Maximum) Hp(JsonNode hp)
+    {
+        if (hp is JsonObject pair) return (pair["current"]!.GetValue<int>(), pair["max"]!.GetValue<int>());
+        var parts = hp.GetValue<string>().Split('/');
+        return (int.Parse(parts[0]), int.Parse(parts[1]));
+    }
