diff --git a/STS2AIAgent/Game/GameStateService.BlockHistory.cs b/STS2AIAgent/Game/GameStateService.BlockHistory.cs
new file mode 100644
index 0000000..661b3c9
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.BlockHistory.cs
@@ -0,0 +1,54 @@
+// Export visible native card-sourced block history using the existing completed-play public indices.
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Combat.History.Entries;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Logging;
+using MegaCrit.Sts2.Core.ValueProps;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Distinguish real card block gains from associated power/relic effects without private counters.</summary>
+    private static object BuildPublicCardBlockHistory(CombatState? combatState)
+    {
+        const string source = "native_local_card_block_gains";
+        try
+        {
+            var player = GetLocalPlayer(combatState);
+            var history = CombatManager.Instance?.History;
+            if (player == null || history == null || combatState == null)
+                return new { available = false, complete = false, scope = "current_combat", source,
+                    entries = Array.Empty<object>() };
+            var native = history.Entries.ToArray();
+            var plays = new List<CardPlay>();
+            var complete = true;
+            // Match BuildPublicCardPlayHistory's exact completed-local-play sequence.
+            foreach (var finished in native.OfType<CardPlayFinishedEntry>())
+            {
+                if (finished.CardPlay?.Card?.Owner == null) { complete = false; continue; }
+                if (ReferenceEquals(finished.CardPlay.Card.Owner, player)) plays.Add(finished.CardPlay);
+            }
+            var rows = new List<object>();
+            foreach (var gained in native.OfType<BlockGainedEntry>())
+            {
+                if (gained.Amount <= 0 || !gained.Props.IsCardOrMonsterMove()
+                    || !ReferenceEquals(gained.Receiver, player.Creature)) continue;
+                var play = gained.CardPlay;
+                if (play?.Card?.Owner == null) { complete = false; continue; }
+                if (!ReferenceEquals(play.Card.Owner, player)) continue;
+                var index = plays.FindIndex(finished => ReferenceEquals(finished, play));
+                if (index < 0) { complete = false; continue; }
+                rows.Add(new { this_turn = gained.HappenedThisTurn(combatState),
+                    card_play_index = index, amount = gained.Amount });
+            }
+            return new { available = true, complete, scope = "current_combat", source, entries = rows.ToArray() };
+        }
+        catch (Exception error)
+        {
+            Log.Warn($"[STS2AIAgent] Public card block history unavailable: {error.GetType().Name}");
+            return new { available = false, complete = false, scope = "current_combat", source,
+                entries = Array.Empty<object>() };
+        }
+    }
+}
diff --git a/STS2AIAgent/Game/GameStateService.CardModifiers.cs b/STS2AIAgent/Game/GameStateService.CardModifiers.cs
new file mode 100644
index 0000000..9c9c5ae
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.CardModifiers.cs
@@ -0,0 +1,82 @@
+// Capture attached visible card overlays and explain native rule-based play restrictions.
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Read the attached affliction's public identity and dynamic tooltip.</summary>
+    private static CardAfflictionPayload? BuildCardAfflictionPayload(CardModel? card)
+    {
+        if (card?.Affliction is not { } affliction)
+            return null;
+        return new CardAfflictionPayload
+        {
+            affliction_id = SafeReadString(() => affliction.Id.Entry),
+            name = RawTextOrNull(() => affliction.Title),
+            description = RawTextOrNull(() => affliction.DynamicDescription),
+            amount = SafeReadNullableInt(() => affliction.Amount)
+        };
+    }
+
+    /// <summary>Read the attached enchantment's public identity and dynamic tooltip.</summary>
+    private static CardEnchantmentPayload? BuildCardEnchantmentPayload(CardModel? card)
+    {
+        if (card?.Enchantment is not { } enchantment)
+            return null;
+        return new CardEnchantmentPayload
+        {
+            enchantment_id = SafeReadString(() => enchantment.Id.Entry),
+            name = RawTextOrNull(() => enchantment.Title),
+            description = RawTextOrNull(() => enchantment.DynamicDescription),
+            amount = SafeReadNullableInt(() => enchantment.Amount),
+            display_amount = SafeReadNullableInt(() => enchantment.DisplayAmount)
+        };
+    }
+
+    /// <summary>Capture the complete current UI keyword set; null means capture failed.</summary>
+    private static string[]? GetEffectiveCardKeywords(CardModel? card)
+    {
+        if (card == null)
+            return null;
+        try
+        {
+            return card.Keywords.Where(keyword => keyword != CardKeyword.None)
+                .Select(keyword => keyword.ToString()).Distinct(StringComparer.Ordinal)
+                .OrderBy(keyword => keyword, StringComparer.Ordinal).ToArray();
+        }
+        catch (Exception ex) when (ex is InvalidOperationException or NullReferenceException)
+        {
+            return null;
+        }
+    }
+
+    /// <summary>Explain only preventers already visible on this card or in the public combat/run.</summary>
+    private static string? BuildCardUnplayableReasonText(CardModel card, UnplayableReason reason, AbstractModel? preventer)
+    {
+        if (!reason.HasFlag(UnplayableReason.BlockedByHook))
+            return null;
+        if (preventer is AfflictionModel affliction && ReferenceEquals(card.Affliction, affliction))
+            return JoinVisibleRestriction(RawTextOrNull(() => affliction.Title),
+                RawTextOrNull(() => affliction.DynamicDescription));
+        if (preventer is EnchantmentModel enchantment && ReferenceEquals(card.Enchantment, enchantment))
+            return JoinVisibleRestriction(RawTextOrNull(() => enchantment.Title),
+                RawTextOrNull(() => enchantment.DynamicDescription));
+        if (preventer is PowerModel power && power.IsVisible && card.CombatState is { } combat
+            && combat.Creatures.Any(creature => creature.Powers.Contains(power)))
+            return JoinVisibleRestriction(RawTextOrNull(() => power.Title), GetPowerRulesText(power));
+        if (preventer is RelicModel relic && card.Owner?.Relics.Contains(relic) == true)
+            return JoinVisibleRestriction(RawTextOrNull(() => relic.Title),
+                RawTextOrNull(() => relic.DynamicDescription));
+        return null;
+    }
+
+    /// <summary>Keep native rule wording without claiming hidden counters or prevention causes.</summary>
+    private static string? JoinVisibleRestriction(string? name, string? description)
+    {
+        if (string.IsNullOrWhiteSpace(description))
+            return string.IsNullOrWhiteSpace(name) ? null : $"Blocked by {name}.";
+        return string.IsNullOrWhiteSpace(name) ? description : $"{name}: {description}";
+    }
+}
