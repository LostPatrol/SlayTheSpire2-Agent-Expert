+    /// <summary>Keep real native public player/deck context while leaving unavailable native fields explicit.</summary>
+    private static JsonObject NativeRunRaw(JsonNode decision, JsonNode coord, string screen, JsonArray actions)
+    {
+        var raw = BaseRaw(screen, actions);
+        var run = raw["run"]!;
+        var player = decision["player"]!;
+        run["gold"] = player["gold"]!.DeepClone(); run["current_hp"] = player["hp"]!.DeepClone(); run["max_hp"] = player["max_hp"]!.DeepClone();
+        run["map_coord"] = coord.DeepClone(); run["act_floor"] = coord["row"]!.GetValue<int>() + 1;
+        run["floor"] = decision["context"]!["total_floor"]!.DeepClone();
+        run["boss_id"] = decision["context"]!["boss"]!["id"]!.DeepClone();
+        run["deck"] = new JsonArray(player["deck"]!.AsArray().Select((card, index) => (JsonNode?)NativeCard(card!, index, "cost")).ToArray());
+        run["relics"] = new JsonArray(player["relics"]!.AsArray().Select((relic, index) => (JsonNode?)new JsonObject
+            { ["index"] = index, ["relic_id"] = relic!["id"]!.DeepClone(), ["name"] = relic["name"]!.DeepClone(),
+                ["description"] = relic["description"]!.DeepClone(), ["stack"] = 1 }).ToArray());
+        run["potions"] = new JsonArray(Enumerable.Range(0, player["potion_slots"]!.GetValue<int>())
+            .Select(index => (JsonNode?)new JsonObject { ["index"] = index, ["occupied"] = false }).ToArray());
+        return raw;
+    }
