diff --git a/STS2AIAgent/Game/GameStateService.PublicCombatStats.cs b/STS2AIAgent/Game/GameStateService.PublicCombatStats.cs
new file mode 100644
index 0000000..51cedcb
--- /dev/null
+++ b/STS2AIAgent/Game/GameStateService.PublicCombatStats.cs
@@ -0,0 +1,173 @@
+// Derive public combat statistics from original native history, never from hidden counters or resource differences.
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Combat.History.Entries;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Logging;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Cards;
+using MegaCrit.Sts2.Core.Models.Powers;
+using MegaCrit.Sts2.Core.ValueProps;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Read Fetch's completed current-turn history for this actual card, without assigning hidden identities.</summary>
+    private static bool? GetPublicFetchPlayedThisTurn(CardModel? card)
+    {
+        if (card is not Fetch || !card.IsInCombat || card.CombatState is not CombatState combat)
+            return null;
+        try
+        {
+            var manager = CombatManager.Instance;
+            if (manager?.History == null || !ReferenceEquals(manager.DebugOnlyGetState(), combat)
+                || !ReferenceEquals(card.Owner, GetLocalPlayer(combat))) return null;
+            var finished = manager.History.Entries.OfType<CardPlayFinishedEntry>().ToArray();
+            // A malformed completed entry cannot establish the negative predicate.
+            if (finished.Any(entry => entry.CardPlay?.Card?.Owner == null)) return null;
+            return finished.Any(entry => ReferenceEquals(entry.CardPlay.Card, card) && entry.HappenedThisTurn(combat));
+        }
+        catch (Exception ex)
+        {
+            Log.Warn($"[STS2AIAgent] Public Fetch history unavailable: {ex.Message}");
+            return null;
+        }
+    }
+
+    /// <summary>Aggregate one current native history snapshot; null means unavailable, including unproved statistics.</summary>
+    private static PublicCombatStatsPayload BuildPublicCombatStats(CombatState? combatState)
+    {
+        var result = new PublicCombatStatsPayload();
+        try
+        {
+            var player = GetLocalPlayer(combatState);
+            var manager = CombatManager.Instance;
+            if (combatState == null || player == null || manager?.History == null
+                || !ReferenceEquals(manager.DebugOnlyGetState(), combatState)) return result;
+            var native = manager.History.Entries.ToArray();
+            var hero = player.Creature;
+            var ownHits = new Dictionary<Creature, int>();
+            var allyHits = new Dictionary<Creature, int>();
+            var energy = 0; var hpTurn = 0; var hpCombat = 0; var doom = false;
+            var exhaust = 0; var discard = 0; var effectDraw = 0; var statusDraw = 0; var draws = 0;
+            var lightning = 0; var stars = 0; var ostyAttacks = 0; var generated = 0;
+            foreach (var entry in native)
+            {
+                var thisTurn = entry.HappenedThisTurn(combatState);
+                switch (entry)
+                {
+                    case EnergySpentEntry spent when thisTurn && ReferenceEquals(spent.Actor, hero):
+                        energy += spent.Amount;
+                        break;
+                    case DamageReceivedEntry damage:
+                        // The rule counts positive-unblocked events, not HP points or net HP change.
+                        if (ReferenceEquals(damage.Receiver, hero) && damage.Result.UnblockedDamage > 0)
+                        { hpCombat++; if (thisTurn) hpTurn++; }
+                        // A blocked powered hit still counts. Targets use stable public identity, never dense slots.
+                        if (!thisTurn || damage.Dealer == null || damage.Receiver == null || !damage.Result.Props.IsPoweredAttack()) break;
+                        if (ReferenceEquals(damage.Dealer, hero)) AddPublicTargetHit(ownHits, damage.Receiver);
+                        else if (damage.Dealer.Side == hero.Side) AddPublicTargetHit(allyHits, damage.Receiver);
+                        break;
+                    case PowerReceivedEntry power when thisTurn && power.Power is DoomPower
+                        && power.Amount > 0 && ReferenceEquals(power.Applier, hero):
+                        doom = true;
+                        break;
+                    case CardExhaustedEntry exhausted when thisTurn && ReferenceEquals(exhausted.Card?.Owner, player):
+                        exhaust++;
+                        break;
+                    case CardDiscardedEntry discarded when thisTurn && ReferenceEquals(discarded.Card?.Owner, player):
+                        discard++;
+                        break;
+                    case CardDrawnEntry drawn when ReferenceEquals(drawn.Actor, hero):
+                        draws++;
+                        if (thisTurn)
+                        {
+                            if (!drawn.FromHandDraw) effectDraw++;
+                            if (drawn.Card.Type == CardType.Status) statusDraw++;
+                        }
+                        break;
+                    case OrbChanneledEntry channeled when ReferenceEquals(channeled.Actor?.Player, player)
+                        && channeled.Orb.Id.Entry == "LIGHTNING_ORB":
+                        lightning++;
+                        break;
+                    case StarsModifiedEntry gained when thisTurn && gained.Amount > 0 && ReferenceEquals(gained.Actor, hero):
+                        stars += gained.Amount;
+                        break;
+                    case CreatureAttackedEntry attacked when thisTurn && player.Osty != null && ReferenceEquals(attacked.Actor, player.Osty):
+                        // Native Rattle counts attack entries, not individual DamageResults or targets.
+                        ostyAttacks++;
+                        break;
+                    case CardGeneratedEntry created when ReferenceEquals(created.Creator, player):
+                        // Supermassive counts local creators in any pile, not every card owned by this player.
+                        generated++;
+                        break;
+                }
+            }
+            result.energy_spent_this_turn = energy;
+            result.hp_loss_events_this_turn = hpTurn;
+            result.hp_loss_events_this_combat = hpCombat;
+            result.doom_applied_this_turn = doom;
+            result.cards_exhausted_this_turn = exhaust;
+            result.cards_discarded_this_turn = discard;
+            result.cards_drawn_by_effect_this_turn = effectDraw;
+            result.status_cards_drawn_this_turn = statusDraw;
+            result.cards_drawn_this_combat = draws;
+            result.lightning_orbs_channeled_this_combat = lightning;
+            result.stars_gained_this_turn = stars;
+            result.osty_attacks_this_turn = ostyAttacks;
+            result.powered_hits_by_target_this_turn = PublicTargetHits(ownHits);
+            result.ally_powered_hits_by_target_this_turn = PublicTargetHits(allyHits);
+            result.generated_cards_this_combat = generated;
+            // This original-model statistic includes Ice Cream carry; it is not actual energy destruction.
+            result.unspent_energy_at_turn_end_sum = NativeTurnEnergyObserver.Read(combatState, player);
+            result.energy_wasted_this_combat = result.unspent_energy_at_turn_end_sum;
+            return result;
+        }
+        catch (Exception error)
+        {
+            Log.Warn($"[STS2AIAgent] Public combat statistics unavailable: {error.GetType().Name}");
+            return new PublicCombatStatsPayload();
+        }
+    }
+
+    /// <summary>Count one public powered damage receipt, including fully blocked hits.</summary>
+    private static void AddPublicTargetHit(Dictionary<Creature, int> hits, Creature target) =>
+        hits[target] = hits.GetValueOrDefault(target) + 1;
+
+    /// <summary>Export stable public target labels in deterministic order, independent of current enemy indices.</summary>
+    private static PublicCombatTargetHitsPayload[] PublicTargetHits(Dictionary<Creature, int> hits) =>
+        hits.Select(row => new PublicCombatTargetHitsPayload
+            { instance_id = PublicInstanceIdentity<Creature>.Get(row.Key), hits = row.Value })
+            .OrderBy(row => row.instance_id, StringComparer.Ordinal).ToArray();
+}
+
+/// <summary>Each nullable statistic has its native event unit and scope in its name; null is unknown.</summary>
+internal sealed class PublicCombatStatsPayload
+{
+    // Energy and stars are positive native receipt amounts; the remaining numeric values count events.
+    public int? energy_spent_this_turn { get; set; }
+    public int? hp_loss_events_this_turn { get; set; }
+    public int? hp_loss_events_this_combat { get; set; }
+    public bool? doom_applied_this_turn { get; set; }
+    public int? cards_exhausted_this_turn { get; set; }
+    public int? cards_discarded_this_turn { get; set; }
+    public int? cards_drawn_by_effect_this_turn { get; set; }
+    public int? status_cards_drawn_this_turn { get; set; }
+    public int? cards_drawn_this_combat { get; set; }
+    public int? lightning_orbs_channeled_this_combat { get; set; }
+    public int? stars_gained_this_turn { get; set; }
+    public int? osty_attacks_this_turn { get; set; }
+    public PublicCombatTargetHitsPayload[]? powered_hits_by_target_this_turn { get; set; }
+    public PublicCombatTargetHitsPayload[]? ally_powered_hits_by_target_this_turn { get; set; }
+    public int? generated_cards_this_combat { get; set; }
+    public int? energy_wasted_this_combat { get; set; }
+    public int? unspent_energy_at_turn_end_sum { get; set; }
+}
+
+/// <summary>A public receiver identity and the number of matching powered-hit receipts.</summary>
+internal sealed class PublicCombatTargetHitsPayload
+{
+    public string instance_id { get; init; } = string.Empty;
+    public int hits { get; init; }
+}
