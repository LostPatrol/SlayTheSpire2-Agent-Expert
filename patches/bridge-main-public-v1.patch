@@ -0,0 +1,21 @@
+// Native gate intersection for the reviewed external observation.
+using System.Text.Json.Nodes;
+
+namespace STS2AIAgent.Game;
+
+internal static partial class GameStateService
+{
+    /// <summary>Intersect reviewed observations with the native enabled-button requirement.</summary>
+    internal static JsonObject BuildPublicStatePayload(GameStatePayload state)
+    {
+        var publicState = FairDecisionProtocol.Project(state.agent_view);
+        // Upstream advertises end_turn before its button is ready; the external path must not bypass it.
+        if (publicState["available_actions"] is JsonArray actions
+            && state.combat?.action_readiness.native_end_turn_ready != true)
+        {
+            for (var index = actions.Count - 1; index >= 0; index--)
+                if (actions[index]?.GetValue<string>() == "end_turn") actions.RemoveAt(index);
+        }
+        return publicState;
+    }
+}
