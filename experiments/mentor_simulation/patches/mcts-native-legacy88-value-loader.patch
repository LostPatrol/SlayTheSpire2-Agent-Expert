+    /// Compare genuine legacy weights with an independent native-width matrix implementation.
+    #[test]
+    fn legacy_h16_native_width_matches_reference_and_ignores_appended_columns() {
+        let bytes=include_bytes!("../../../data/value_policy_net/h16.json");
+        let model=LearnedValueNet::from_legacy_prefix_weights_json(bytes).unwrap();
+        let json:WeightsJson=serde_json::from_slice(bytes).unwrap();
+        assert_eq!(model.input_dim(),LEGACY_INPUT_DIM);
+        for variant in 0..3 {
+            let mut state=CombatState::default();
+            state.player.current_hp=20+variant*10;
+            state.player.energy=variant as i8;
+            let raw=eval_features_wide(&state);
+            let mut hidden=(0..LEGACY_INPUT_DIM).map(|i|
+                (raw[i]-json.feature_mean[i])/json.feature_std[i]).collect::<Vec<_>>();
+            let matrices=[(&json.weights.w1,&json.weights.b1),(&json.weights.w2,&json.weights.b2),
+                (json.weights.w3.as_ref().unwrap(),json.weights.b3.as_ref().unwrap())];
+            for (matrix,bias) in matrices {
+                let mut next=bias.clone();
+                // Match scalar f32 accumulation order; no BLAS reduction or padded rows.
+                for (i,input) in hidden.iter().enumerate() {
+                    for (j,output) in next.iter_mut().enumerate() {*output+=input*matrix[i][j];}
+                }
+                next.iter_mut().for_each(|value|*value=value.max(0.0));
+                hidden=next;
+            }
+            let mut logit=json.weights.b_v[0];
+            for (i,input) in hidden.iter().enumerate() {logit+=input*json.weights.w_v[i][0];}
+            let probability=1.0/(1.0+(-logit).exp());
+            assert_eq!(model.evaluate(&state),map_win_to_score(probability));
+            let mut normalized=model.normalize(&state);
+            let original=model.forward_value(&normalized);
+            normalized[LEGACY_INPUT_DIM..].fill(1e20);
+            assert_eq!(model.forward_value(&normalized),original);
+        }
+    }
+
