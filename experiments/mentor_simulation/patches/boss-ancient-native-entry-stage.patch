+    /// The visible Ancient is a real new-act visit, after the boss reward.
+    #[test]
+    fn boss_ancient_entry_uses_rewarded_deck_and_real_room_once() {
+        use crate::card_effects::EffectResult;
+        use crate::events::EventId;
+        use crate::run_room_gen::{AncientId, GeneratedActRooms};
+        use crate::runstate::{Room, RoomType};
+
+        /// Offer one controlled boss card before the Ancient is generated.
+        fn cards(_rs: &mut RunState) -> Vec<crate::cards::CardId> {
+            vec![crate::cards::CardId::Bash]
+        }
+        /// Delegate the actual Ancient roll only after the chosen card lands.
+        fn offers(rs: &mut RunState) -> Vec<RelicId> {
+            assert_eq!(rs.act_index, 1);
+            assert_eq!(rs.master_deck.len(), 1);
+            assert_eq!(rs.master_deck[0].card_id, crate::cards::CardId::Bash);
+            assert_eq!(rs.current_event, None);
+            let rewards_before = rs.rng.rewards.counter();
+            let result = rs.roll_boss_relic_offers();
+            assert_eq!(rs.rng.rewards.counter(), rewards_before);
+            result
+        }
+        /// Model the one shared Rewards read made by an offered setup effect.
+        fn setup(rs: &mut RunState, _offers: &[RelicId]) {
+            assert_eq!(rs.act_index, 2);
+            assert_eq!((rs.current_hp, rs.max_hp), (999, 999));
+            assert_eq!(rs.current_event, Some(EventId::Orobas));
+            assert_eq!(rs.current_room.map(|r| r.room_type), Some(RoomType::Event));
+            *rs.relic_counters.entry(RelicId::DustyTome).or_default() += 1;
+            let _ = rs.rng.rewards.next_int_exclusive(0, 10);
+        }
+        /// Count the original per-act callback without changing its semantics.
+        fn act_entered(rs: &mut RunState, _act: u8) -> EffectResult {
+            *rs.relic_counters.entry(RelicId::LavaRock).or_default() += 1;
+            EffectResult::Resolved
+        }
+        /// Count the actual Ancient event-room entry.
+        fn room_entered(rs: &mut RunState, room: RoomType) -> EffectResult {
+            if room == RoomType::Event {
+                *rs.relic_counters.entry(RelicId::MawBank).or_default() += 1;
+            }
+            EffectResult::Resolved
+        }
+        crate::run_effects::register_after_act_entered(RelicId::LavaRock, act_entered);
+        crate::run_effects::register_after_room_entered(RelicId::MawBank, room_entered);
+        let callbacks = ContentCallbacks {
+            generate_card_reward_options: Some(cards),
+            generate_boss_relic_pool: Some(offers),
+            setup_boss_relic_ancient: Some(setup),
+            ..ContentCallbacks::default()
+        };
+        let mut rm = RunManager::new(0, CharacterId::Ironclad)
+            .with_content_callbacks(callbacks);
+        rm.run_state.master_deck.clear();
+        rm.run_state.max_hp = 999;
+        rm.run_state.current_hp = 930;
+        rm.run_state.generated_rooms = vec![GeneratedActRooms::default(); 3];
+        rm.run_state.generated_rooms[1].ancient = Some(AncientId::Orobas);
+        rm.run_state.current_room = Some(Room::new(RoomType::Boss));
+        rm.combat = Some(crate::CombatState {
+            is_over: true,
+            player_won: true,
+            ..crate::CombatState::default()
+        });
+        rm.set_phase(Phase::Combat);
+        assert_eq!(rm.exit_combat_and_transition(), ActionResult::Advanced);
+        assert_eq!(rm.phase(), Phase::CardReward);
+        assert_eq!((rm.run_state.act_index, rm.run_state.current_hp), (1, 930));
+        assert!(rm.boss_relic_options().is_empty());
+        assert_eq!(rm.run_state.current_event, None);
+        let rewards_before_entry = rm.run_state.rng.rewards.counter();
+        let floor_before_entry = rm.run_state.total_floor;
+        let history_before_entry = rm.run_state.map_point_history.len();
+
+        let _ = rm.take_action(RunAction::PickCardReward { idx: Some(0) });
+        assert_eq!(rm.phase(), Phase::BossRelic);
+        assert_eq!(rm.boss_relic_options().len(), 3);
+        let map = rm.run_state.current_act_map.as_ref().expect("new act map");
+        let start = map.point(map.start.expect("Ancient start point"));
+        assert_eq!(
+            rm.run_state.current_room.and_then(|r| r.map_coord),
+            Some(start.coord)
+        );
+        assert_eq!(rm.run_state.act_floor, 1);
+        assert_eq!(rm.run_state.total_floor, floor_before_entry + 1);
+        assert_eq!(rm.run_state.map_point_history.len(), history_before_entry + 1);
+        assert_eq!(
+            rm.run_state.map_point_history.last().map(|h| h.map_point_type),
+            Some(crate::map::MapPointType::Ancient)
+        );
+        assert_eq!(rm.run_state.acts[1].events_visited, 1);
+        assert!(rm.run_state.current_act_map.is_some());
+        assert!(!rm.pending_boss_act_advance);
+        assert_eq!(rm.run_state.rng.rewards.counter(), rewards_before_entry + 1);
+        assert_eq!(rm.run_state.relic_counters.get(&RelicId::LavaRock), Some(&1));
+        assert_eq!(rm.run_state.relic_counters.get(&RelicId::MawBank), Some(&1));
+
+        // Re-reading and rejecting an invalid pick must not repeat setup/entry.
+        let _ = rm.get_available_actions();
+        assert_eq!(rm.do_boss_relic_pick(3), ActionResult::InvalidForPhase);
+        rm.run_state.current_hp = 900;
+        let _ = rm.take_action(RunAction::PickBossRelic { idx: 0 });
+        assert_eq!(rm.phase(), Phase::MapChoice);
+        assert_eq!((rm.run_state.act_index, rm.run_state.current_hp), (2, 900));
+        assert_eq!(rm.run_state.current_event, None);
+        assert_eq!(rm.run_state.relic_counters.get(&RelicId::DustyTome), Some(&1));
+        assert_eq!(rm.run_state.relic_counters.get(&RelicId::LavaRock), Some(&1));
+        assert_eq!(rm.run_state.relic_counters.get(&RelicId::MawBank), Some(&1));
+        assert_eq!(rm.run_state.rng.rewards.counter(), rewards_before_entry + 1);
+        assert_eq!(rm.run_state.total_floor, floor_before_entry + 1);
+        assert_eq!(rm.run_state.map_point_history.len(), history_before_entry + 1);
+    }
