+/// Count each finished iteration from its immutable ResourceInfo quote, even when tracing is disabled.
+fn record_zero_cost_attack_finished(state: &mut CombatState, kind: cards::CardType, energy_value: i32) {
+    if kind == cards::CardType::Attack && energy_value == 0 {
+        state.combat_log.zero_cost_attacks_played_this_turn = state.combat_log
+            .zero_cost_attacks_played_this_turn.saturating_add(1);
+    }
+}
