+/// Keep real card dispatch active with a durable opponent and controlled hand/draw piles.
+fn feral_budget_fixture(mirror: bool) -> CombatState {
+    crate::cards::dispatch::ensure_installed();
+    let (mut state, _) = fresh_state(CardId::GoForTheEyes, 3, 0);
+    state.cards.clear();
+    state.player.play.clear();
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.energy = 20;
+    state.player.max_energy = 20;
+    state.phase = sts2_core::CombatPhase::PlayerPlayPhase;
+    state.creatures[0].current_hp = 1000;
+    state.creatures[0].max_hp = 1000;
+    if mirror {
+        state.init_player_creature();
+    }
+    state
+}
+
+/// Insert an actual registered card; extra iterations use the existing replay-count machinery.
+fn feral_budget_card(state: &mut CombatState, id: CardId, replay: i32, draw: bool) -> sts2_core::CardUid {
+    let mut card = crate::cards::spec_index::card_pod_from_id(id, false).expect("registered card");
+    card.uid = sts2_core::CardUid::new(state.cards.len() as u32 + 1).expect("non-zero card uid");
+    card.base_replay_count = replay;
+    let uid = card.uid;
+    state.cards.push(card);
+    if draw {
+        state.player.draw.push(uid);
+    } else {
+        state.player.hand.push(uid);
+    }
+    uid
+}
+
+/// Observe the owned instance rather than assuming its mirror/legacy storage location.
+fn feral_budget_counter(state: &CombatState) -> i32 {
+    state.player_power_uids().iter().filter_map(|uid| state.powers.get_by_id(uid.0))
+        .find(|power| power.kind == PowerKind::Feral).expect("Feral installed").counter
+}
+
+/// Base and Echo iterations count separately; active Feral consumes only actual series returns.
+#[test]
+fn repair51_feral_active_replays_separate_finished_history_from_return_budget() {
+    for (base_replay, echo, expected_finished) in [(1, false, 2), (0, true, 2), (1, true, 3)] {
+        for recording in [false, true] {
+            let mut state = feral_budget_fixture(true);
+            if recording {
+                // Late opt-in records rows without claiming this constructed root covers combat birth.
+                state.combat_log.event_log.set_public_history_recording(true);
+            }
+            let player = state.player.creature_uid.expect("player mirror");
+            sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Feral, 2);
+            if echo {
+                sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::EchoForm, 1);
+            }
+            let eyes = feral_budget_card(&mut state, CardId::GoForTheEyes, base_replay, false);
+            let claw = feral_budget_card(&mut state, CardId::Claw, 0, false);
+            let _ = sts2_core::combat_loop::play_card(&mut state, 0, Some(0));
+            assert!(state.player.hand.contains(&eyes));
+            assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, expected_finished);
+            assert_eq!(feral_budget_counter(&state), 1);
+            if recording {
+                assert_eq!(state.combat_log.event_log.public_history().unwrap().plays.len(), expected_finished as usize);
+            }
+            let index = state.player.hand.iter().position(|uid| *uid == claw).unwrap();
+            let _ = sts2_core::combat_loop::play_card(&mut state, index as u8, Some(0));
+            assert!(state.player.hand.contains(&claw));
+            assert_eq!(feral_budget_counter(&state), 2);
+            let index = state.player.hand.iter().position(|uid| *uid == claw).unwrap();
+            let _ = sts2_core::combat_loop::play_card(&mut state, index as u8, Some(0));
+            assert!(state.player.discard.contains(&claw));
+            assert_eq!(feral_budget_counter(&state), 2, "a discarded attack consumes no return");
+            assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, expected_finished + 2);
+        }
+    }
+}
+
+/// Fresh Feral seeds all prior finished zero quotes; restacking preserves its existing budget.
+#[test]
+fn repair51_feral_fresh_seed_and_restack_preserve_distinct_native_counts() {
+    for mirror in [false, true] {
+        let mut state = feral_budget_fixture(mirror);
+        feral_budget_card(&mut state, CardId::GoForTheEyes, 1, false);
+        let _ = sts2_core::combat_loop::play_card(&mut state, 0, Some(0));
+        assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 2);
+        feral_budget_card(&mut state, CardId::Feral, 0, mirror);
+        if mirror {
+            // Native auto-acquired Feral initializes from the same completed history as a hand play.
+            assert!(sts2_core::combat_loop::auto_play_card_from_draw_top(&mut state, false));
+        } else {
+            let _ = sts2_core::combat_loop::play_card(&mut state, 0, None);
+        }
+        assert_eq!(feral_budget_counter(&state), 2);
+        feral_budget_card(&mut state, CardId::Feral, 0, false);
+        let _ = sts2_core::combat_loop::play_card(&mut state, 0, None);
+        assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 2);
+        assert_eq!(feral_budget_counter(&state), 2);
+        let claw = feral_budget_card(&mut state, CardId::Claw, 0, false);
+        let _ = sts2_core::combat_loop::play_card(&mut state, 0, Some(0));
+        assert!(state.player.discard.contains(&claw));
+        assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 3);
+        assert_eq!(feral_budget_counter(&state), 2);
+        assert_eq!(play_feral(&mut state, None), EffectResult::Resolved);
+        assert_eq!(feral_budget_counter(&state), 2, "restack does not reseed from newer history");
+        let claw = feral_budget_card(&mut state, CardId::Claw, 0, false);
+        let _ = sts2_core::combat_loop::play_card(&mut state, 0, Some(0));
+        assert!(state.player.hand.contains(&claw));
+        assert_eq!(feral_budget_counter(&state), 3);
+    }
+}
+
+/// A real player turn resets the completed history and Feral's owned-side return counter.
+#[test]
+fn repair51_feral_turn_start_resets_history_and_active_budget() {
+    let mut state = feral_budget_fixture(true);
+    let player = state.player.creature_uid.expect("player mirror");
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Feral, 1);
+    feral_budget_card(&mut state, CardId::Claw, 0, false);
+    let _ = sts2_core::combat_loop::play_card(&mut state, 0, Some(0));
+    assert_eq!(feral_budget_counter(&state), 1);
+    assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 1);
+    let _ = sts2_core::combat_loop::start_player_turn(&mut state);
+    assert_eq!(feral_budget_counter(&state), 0);
+    assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 0);
+}
+
+/// Auto-play is free to execute, but only its immutable zero quote counts or returns through Feral.
+#[test]
+fn repair51_feral_auto_replays_preserve_quote_before_self_cost_mutation() {
+    let mut state = feral_budget_fixture(true);
+    let player = state.player.creature_uid.expect("player mirror");
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Feral, 2);
+    let momentum = feral_budget_card(&mut state, CardId::MomentumStrike, 1, true);
+    assert!(sts2_core::combat_loop::auto_play_card_from_draw_top(&mut state, false));
+    assert_eq!(state.cards[momentum.get() as usize - 1].cost, 0);
+    assert!(state.player.discard.contains(&momentum));
+    assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 0, "all replays retain the original one-energy quote");
+    assert_eq!(feral_budget_counter(&state), 0);
+    let eyes = feral_budget_card(&mut state, CardId::GoForTheEyes, 1, true);
+    assert!(sts2_core::combat_loop::auto_play_card_from_draw_top(&mut state, false));
+    assert!(state.player.hand.contains(&eyes));
+    assert_eq!(state.combat_log.zero_cost_attacks_played_this_turn, 2);
+    assert_eq!(feral_budget_counter(&state), 1);
+    assert_eq!(state.player.energy, 20);
+}
