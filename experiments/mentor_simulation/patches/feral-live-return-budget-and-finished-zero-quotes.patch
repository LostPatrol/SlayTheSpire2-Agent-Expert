+/// Read the live Feral instance; its return budget is distinct from completed attack history.
+fn feral_returns_left(state: &CombatState) -> i32 {
+    state.player_power_uids().iter().filter_map(|uid|state.powers.get_by_id(uid.0))
+        .find(|power|power.kind == crate::PowerKind::Feral)
+        .map_or(0,|power|power.amount.saturating_sub(power.counter).max(0))
+}
+
+/// Only a real Feral result-pile override consumes its live budget; restacking preserves this counter.
+fn consume_feral_return(state: &mut CombatState) {
+    for uid in state.player_power_uids() {
+        if let Some(power) = state.powers.get_mut_by_id(uid.0).filter(|power|power.kind == crate::PowerKind::Feral) {
+            power.counter = power.counter.saturating_add(1);
+        }
+    }
+}
