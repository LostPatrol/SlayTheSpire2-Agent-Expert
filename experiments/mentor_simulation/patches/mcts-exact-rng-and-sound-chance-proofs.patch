+                *edge == EdgeAction::Other(Action::EndTurn)).expect("forced end turn expanded");
+            let actual = search.tree.node(*child).realized.as_deref().unwrap();
+            assert_eq!(actual.player.hand, expected.player.hand);
+            assert_eq!(actual.run_rng, expected.run_rng);
+            realized_hashes.push(sts2_core::state_hash(actual));
+        }
+        assert!(realized_hashes.windows(2).any(|pair| pair[0] != pair[1]),
+            "changing true RNG must change the realized continuation");
