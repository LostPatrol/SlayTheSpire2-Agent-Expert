+        let mut realized_hashes = Vec::new();
+        for cursor in [0, 3, 7] {
+            let mut world = state.clone();
+            for _ in 0..cursor { let _ = world.run_rng.shuffle.next_int(0, 100); }
+            let mut expected = world.clone();
+            let _ = core_apply(&mut expected, Action::EndTurn);
+            let mut search = Mcts::new(world, chance_cfg(13, 2)).with_exact_rng(true);
+            let _ = search.search();
