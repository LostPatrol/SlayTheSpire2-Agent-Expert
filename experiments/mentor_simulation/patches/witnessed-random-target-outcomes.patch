+/// Preserve the RNG draw and condition only on the actual positive-support target set.
+pub fn condition_random_enemy_target(
+    state: &mut CombatState,
+    sampled: CreatureUid,
+    support: &[CreatureUid],
+) -> CreatureUid {
+    let Some(observations) = state.replay_observations.as_mut() else {
+        return sampled;
+    };
+    if observations.error.is_some() {
+        return sampled;
+    }
+    let Some(prefix) = &observations.target_prefix else {
+        return sampled;
+    };
+    let Some(&target) = prefix.get(observations.targets_consumed) else {
+        observations.next_target_support = Some(support.to_vec());
+        observations.error = Some("observed_target_prefix_needs_branch");
+        return sampled;
+    };
+    if !support.contains(&target) {
+        observations.error = Some("observed_target_outside_positive_support");
+        return sampled;
+    }
+    observations.targets_consumed += 1;
+    target
 }
 
