+/// Native Anger and Boost generate into Discard; a locally owned card with null creator does not count.
+#[test]
+fn public_history_generation_counts_local_creator_in_discard_not_owner() {
+    let mut state = fixture();
+    real_card(&mut state, CardId::Anger, sts2_core::cards::PileKind::Hand);
+    real_card(
+        &mut state,
+        CardId::BoostAway,
+        sts2_core::cards::PileKind::Hand,
+    );
+    real_card(
+        &mut state,
+        CardId::Supermassive,
+        sts2_core::cards::PileKind::Hand,
+    );
+    assert_eq!(supermassive_damage(&state), 5);
+    sts2_core::apply(
+        &mut state,
+        sts2_core::Action::PlayCard {
+            hand_index: 0,
+            target: Some(0),
+        },
+    );
+    assert_eq!(supermassive_damage(&state), 8);
+    sts2_core::apply(
+        &mut state,
+        sts2_core::Action::PlayCard {
+            hand_index: 0,
+            target: None,
+        },
+    );
+    assert_eq!(supermassive_damage(&state), 11);
+    let dazed = sts2_content::cards::spec_index::card_pod_from_id(CardId::Dazed, false).unwrap();
+    sts2_core::card_effects::spawn_card_into_pile_with_origin(
+        &mut state,
+        dazed,
+        sts2_core::card_effects::PileKind::Discard,
+        false,
+    );
+    assert_eq!(supermassive_damage(&state), 11);
+    let generated: Vec<_> = state
+        .combat_log
+        .event_log
+        .rows()
+        .iter()
+        .filter_map(|row| {
+            if let sts2_core::event_log::EventLogEntry::CardGenerated {
+                pile, by_player, ..
+            } = row.entry
+            {
+                Some((pile, by_player))
+            } else {
+                None
+            }
+        })
+        .collect();
+    assert_eq!(
+        generated,
+        vec![("discard", true), ("discard", true), ("discard", false)]
+    );
+    assert_eq!(state.count_player_generated_cards_this_combat(), 2);
+}
