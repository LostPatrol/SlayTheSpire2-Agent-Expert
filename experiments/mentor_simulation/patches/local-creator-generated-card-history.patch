+/// Record one committed generation; only the explicit local creator counts, regardless of destination.
+pub fn record_generated_card(state: &mut CombatState, uid: CardUid, creator_is_local: bool) {
+    let Some(card) = state.cards.get(uid.get() as usize - 1) else {
+        return;
+    };
+    let (card_id, upgraded) = (card.card_id, card.upgraded);
+    if creator_is_local {
+        state.player.generated_cards_this_combat =
+            state.player.generated_cards_this_combat.saturating_add(1);
+    }
+    if crate::event_log::armed(state) {
+        // Observe the committed destination only; arena allocation alone is not a generation event.
+        let pile = if state.player.hand.contains(&uid) {
+            "hand"
+        } else if state.player.draw.contains(&uid) {
+            "draw"
+        } else if state.player.discard.contains(&uid) {
+            "discard"
+        } else if state.player.exhaust.contains(&uid) {
+            "exhaust"
+        } else if state.player.play.contains(&uid) {
+            "play"
+        } else {
+            return;
+        };
+        crate::event_log::record(
+            state,
+            crate::event_log::EventLogEntry::CardGenerated {
+                card: card_id,
+                upgraded,
+                pile,
+                by_player: creator_is_local,
+            },
+        );
+    }
+}
