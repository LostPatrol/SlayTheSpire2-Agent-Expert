+/// Hand overflow, batch routing and both transform APIs record exactly one committed local generation.
+#[test]
+fn public_history_generation_records_overflow_routes_and_transforms_once() {
+    let mut state = fixture();
+    while state.player.hand.len() < sts2_core::cards::HAND_LIMIT {
+        real_card(
+            &mut state,
+            CardId::DefendIronclad,
+            sts2_core::cards::PileKind::Hand,
+        );
+    }
+    let fresh = || sts2_content::cards::spec_index::card_pod_from_id(CardId::Dazed, false).unwrap();
+    let null =
+        sts2_core::card_effects::spawn_card_into_hand_with_origin(&mut state, fresh(), false);
+    assert!(state.player.discard.contains(&null));
+    assert_eq!(state.count_player_generated_cards_this_combat(), 0);
+    sts2_core::card_effects::spawn_card_into_hand_with_origin(&mut state, fresh(), true);
+    assert_eq!(state.count_player_generated_cards_this_combat(), 1);
+    let allocated = real_card(&mut state, CardId::Dazed, sts2_core::cards::PileKind::Draw);
+    state.player.draw.retain(|uid| *uid != allocated);
+    assert_eq!(
+        state.count_player_generated_cards_this_combat(),
+        1,
+        "arena allocation alone cannot count"
+    );
+    sts2_core::card_effects::route_generated_into_hand(&mut state, &[allocated]);
+    assert_eq!(state.count_player_generated_cards_this_combat(), 2);
+    let old = state.player.hand[0];
+    state.transform_card(old, fresh()).unwrap();
+    assert_eq!(state.count_player_generated_cards_this_combat(), 3);
+    let old = state.player.hand[1];
+    sts2_core::card_effects::transform_card_in_place(&mut state, old, fresh()).unwrap();
+    assert_eq!(state.count_player_generated_cards_this_combat(), 4);
+    let records = state
+        .combat_log
+        .event_log
+        .rows()
+        .iter()
+        .filter(|row| {
+            matches!(
+                row.entry,
+                sts2_core::event_log::EventLogEntry::CardGenerated { .. }
+            )
+        })
+        .count();
+    assert_eq!(records, 5);
+}
