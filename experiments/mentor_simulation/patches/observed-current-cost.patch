+        use crate::cards::{Card, CardId, VarKey};
+        let mut state = CombatState::default();
+        state.player.current_hp = 80;
+        state.player.max_hp = 80;
+        state.init_player_creature();
+        let player = state.player.creature_uid.expect("player creature");
+        crate::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Tangled, 2);
+        let mut card = Card::pod_defaults();
+        assert_eq!(effective_card_cost_inst(&state, &card, card.uid), 3);
+        card.set_combat_var(VarKey::ObservedEnergyCost, 1);
+        assert_eq!(effective_card_cost_inst(&state, &card, card.uid), 0);
+        card.set_combat_var(VarKey::ObservedEnergyCost, 3);
+        assert_eq!(effective_card_cost_inst(&state, &card, card.uid), 2);
+        card.set_combat_var(VarKey::ObservedEnergyCost, 0);
+        assert_eq!(effective_card_cost_inst(&state, &card, card.uid), 3);
