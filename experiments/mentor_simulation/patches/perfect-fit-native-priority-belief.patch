+//! PerfectFit receiver order and public draw-order knowledge.
+//! Priority bands have a known order; members of one band remain unordered.
+//! Unsupported conditional orders stop belief search instead of inventing ranks.
+
+use crate::cards::{Card, EnchantmentId};
+use crate::dotnet_rng::Rng;
+use crate::{CardUid, PlayerCombatState};
+use smallvec::SmallVec;
+
+/// A nonterminal limitation of the finite draw-order representation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum UnsupportedDrawOrder {
+    UnwitnessedPriority,
+    NonTopRemovalAfterInsertion,
+    ConditionalOrderQuery,
+    InsertedPerfectFitReshuffle,
+    UnknownDiscardInsertion,
+    MissingPreactionSnapshot,
+}
+
+impl UnsupportedDrawOrder {
+    /// Decode a persisted diagnostic without treating an unknown code as supported.
+    pub fn from_code(code: &str) -> Option<Self> {
+        [
+            Self::UnwitnessedPriority,
+            Self::NonTopRemovalAfterInsertion,
+            Self::ConditionalOrderQuery,
+            Self::InsertedPerfectFitReshuffle,
+            Self::UnknownDiscardInsertion,
+            Self::MissingPreactionSnapshot,
+        ]
+        .into_iter()
+        .find(|r| r.code() == code)
+    }
+    /// Stable diagnostic identity, separate from terminal or depth cutoffs.
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::UnwitnessedPriority => "perfect_fit_priority_unwitnessed",
+            Self::NonTopRemovalAfterInsertion => "priority_non_top_removal_after_insertion",
+            Self::ConditionalOrderQuery => "priority_conditional_order_query",
+            Self::InsertedPerfectFitReshuffle => "priority_inserted_perfect_fit_reshuffle",
+            Self::UnknownDiscardInsertion => "priority_unknown_discard_insertion",
+            Self::MissingPreactionSnapshot => "priority_cutoff_without_preaction_snapshot",
+        }
+    }
+}
+
+/// Optional public order constraints, including PerfectFit and certified top/bottom placements.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct DrawKnowledge {
+    /// A real initial shuffle or explicit public certificate established this draw law.
+    pub observed: bool,
+    /// Earlier bands precede later bands; one band's internal order is unknown.
+    pub groups: Vec<SmallVec<[CardUid; 4]>>,
+    /// Uniform random-position insertions interleave with the original base.
+    pub inserted: SmallVec<[CardUid; 4]>,
+    /// Tracks base removals that would require a richer conditional posterior.
+    pub base: SmallVec<[CardUid; 32]>,
+    /// Public discard chronology: outer order is known, inner order is not.
+    pub discard_groups: Vec<SmallVec<[CardUid; 4]>>,
+    /// Low-level shuffle already applied the hook before any subsequent draw.
+    pub prepared: bool,
+    /// Honest-search cutoff reason; never a game-terminal marker.
+    pub unsupported: Option<UnsupportedDrawOrder>,
+}
+
+/// Allocate knowledge only for the rare enchanted-card path.
+fn knowledge_mut(player: &mut PlayerCombatState) -> &mut DrawKnowledge {
+    player.draw_knowledge.get_or_insert_with(Default::default)
+}
+
+/// Initialize rollback coverage even when the first priority is created mid-action.
+pub fn initialize_for_search(player: &mut PlayerCombatState, cards: &[Card]) {
+    if cards
+        .iter()
+        .any(|c| c.has_enchantment(EnchantmentId::PerfectFit))
+    {
+        let _ = knowledge_mut(player);
+    }
+}
+
+/// Mark the aggregate root discard order as unknown, without reading a private order.
+pub fn set_unknown_discard(player: &mut PlayerCombatState, cards: &[Card]) {
+    initialize_for_search(player, cards);
+    if player.draw_knowledge.is_some() {
+        let discard: SmallVec<[CardUid; 4]> = player.discard.iter().copied().collect();
+        knowledge_mut(player).discard_groups = if discard.is_empty() {
+            vec![]
+        } else {
+            vec![discard]
+        };
+    }
+}
+
+/// Install only publicly certified bands; a singleton alone certifies an exact rank.
+pub fn set_priority_groups(
+    player: &mut PlayerCombatState,
+    groups: Vec<Vec<CardUid>>,
+) -> Result<(), &'static str> {
+    let mut seen = SmallVec::<[CardUid; 32]>::new();
+    for uid in groups.iter().flatten() {
+        if !player.draw.contains(uid) || seen.contains(uid) {
+            return Err("priority groups must contain distinct cards currently in draw");
+        }
+        seen.push(*uid);
+    }
+    let base = player.draw.clone();
+    let knowledge = knowledge_mut(player);
+    knowledge.groups = groups
+        .into_iter()
+        .filter(|g| !g.is_empty())
+        .map(|g| g.into_iter().collect())
+        .collect();
+    knowledge.base = base;
+    knowledge.inserted.clear();
+    knowledge.unsupported = None;
+    knowledge.prepared = false;
+    knowledge.observed = true;
+    normalize(player);
+    Ok(())
+}
+
+/// Validate a set of public group members against a single physical pile.
+fn validate_groups(groups: &[Vec<CardUid>], pile: &[CardUid]) -> Result<(), &'static str> {
+    let mut seen = SmallVec::<[CardUid; 32]>::new();
+    for uid in groups.iter().flatten() {
+        if !pile.contains(uid) || seen.contains(uid) {
+            return Err("group members must be distinct and in the named pile");
+        }
+        seen.push(*uid);
+    }
+    Ok(())
+}
+
+/// Install explicit free insertions without sampling their hidden physical slots.
+pub fn set_random_insertions(
+    player: &mut PlayerCombatState,
+    inserted: Vec<CardUid>,
+) -> Result<(), &'static str> {
+    validate_groups(&[inserted.clone()], &player.draw)?;
+    if player.draw_knowledge.as_ref().is_some_and(|k| {
+        inserted
+            .iter()
+            .any(|u| k.groups.iter().any(|g| g.contains(u)))
+    }) {
+        return Err("random insertions must not overlap priority bands");
+    }
+    let base = player
+        .draw
+        .iter()
+        .copied()
+        .filter(|u| !inserted.contains(u))
+        .collect();
+    let k = knowledge_mut(player);
+    k.inserted = inserted.into_iter().collect();
+    k.base = base;
+    normalize(player);
+    Ok(())
+}
+
+/// Preserve certified discard chronology; unknown groups remain internally unordered.
+pub fn set_discard_groups(
+    player: &mut PlayerCombatState,
+    groups: Vec<Vec<CardUid>>,
+) -> Result<(), &'static str> {
+    validate_groups(&groups, &player.discard)?;
+    knowledge_mut(player).discard_groups = groups
+        .into_iter()
+        .filter(|g| !g.is_empty())
+        .map(|g| g.into_iter().collect())
+        .collect();
+    Ok(())
+}
+
+/// Install one complete public certificate without borrowing any materialized hidden order.
+pub fn set_root_knowledge(
+    player: &mut PlayerCombatState,
+    groups: Vec<Vec<CardUid>>,
+    inserted: Vec<CardUid>,
+    discard_groups: Vec<Vec<CardUid>>,
+) -> Result<(), &'static str> {
+    validate_groups(&groups, &player.draw)?;
+    validate_groups(&[inserted.clone()], &player.draw)?;
+    validate_groups(&discard_groups, &player.discard)?;
+    if inserted
+        .iter()
+        .any(|u| groups.iter().any(|g| g.contains(u)))
+    {
+        return Err("random insertions must not overlap priority bands");
+    }
+    set_priority_groups(player, groups)?;
+    set_random_insertions(player, inserted)?;
+    set_discard_groups(player, discard_groups)?;
+    normalize(player);
+    Ok(())
+}
+
+/// An observed initial shuffle carries no PerfectFit priority.
+pub fn clear_priority(player: &mut PlayerCombatState) {
+    if let Some(k) = player.draw_knowledge.as_mut() {
+        k.groups.clear();
+        k.base.clear();
+        k.inserted.clear();
+        k.prepared = false;
+        k.unsupported = None;
+        k.observed = true;
+    }
+}
+
+/// Preserve an explicit root information gap instead of treating it as uniform draw.
+pub fn mark_unwitnessed_priority(player: &mut PlayerCombatState) {
+    knowledge_mut(player).unsupported = Some(UnsupportedDrawOrder::UnwitnessedPriority);
+}
+
+/// Read the belief cutoff reason; materialized game rules never consult it.
+pub fn unsupported_reason(player: &PlayerCombatState) -> Option<&'static str> {
+    player
+        .draw_knowledge
+        .as_ref()
+        .and_then(|k| k.unsupported)
+        .map(|r| r.code())
+}
+
+/// Record a public-belief limitation; materialized rules ignore the marker.
+pub fn mark_unsupported(player: &mut PlayerCombatState, reason: UnsupportedDrawOrder) {
+    let _ = knowledge_mut(player).unsupported.get_or_insert(reason);
+}
+
+/// Remove stale memberships and detect unobserved non-top base removals.
+pub fn normalize(player: &mut PlayerCombatState) {
+    let Some(k) = player.draw_knowledge.as_mut() else {
+        return;
+    };
+    // One unconstrained band covering the whole base plus uniform insertions
+    // is simply an ordinary uniform pile, not a PerfectFit ordering constraint.
+    let uniform_base = k.groups.len() == 1
+        && k.base.iter().all(|uid| player.draw.contains(uid))
+        && player
+            .draw
+            .iter()
+            .filter(|uid| {
+                !player.pinned_top.contains(uid)
+                    && !player.pinned_bottom.contains(uid)
+                    && !k.inserted.contains(uid)
+            })
+            .all(|uid| k.groups[0].contains(uid));
+    if uniform_base {
+        k.groups.clear();
+        k.base.clear();
+        k.inserted.clear();
+    }
+    if !k.inserted.is_empty() && k.base.iter().any(|uid| !player.draw.contains(uid)) {
+        let _ = k
+            .unsupported
+            .get_or_insert(UnsupportedDrawOrder::NonTopRemovalAfterInsertion);
+    }
+    k.base.retain(|uid| player.draw.contains(uid));
+    k.inserted.retain(|uid| player.draw.contains(uid));
+    for group in &mut k.groups {
+        group.retain(|uid| player.draw.contains(uid));
+    }
+    k.groups.retain(|g| !g.is_empty());
+    for group in &mut k.discard_groups {
+        group.retain(|uid| player.discard.contains(uid));
+    }
+    k.discard_groups.retain(|g| !g.is_empty());
+    if k.groups.is_empty() {
+        k.base.clear();
+        k.inserted.clear();
+    }
+}
+
+/// Forget a genuinely consumed top card without creating an unsupported removal.
+pub fn consumed_top(player: &mut PlayerCombatState, uid: CardUid) {
+    if let Some(k) = player.draw_knowledge.as_mut() {
+        k.base.retain(|u| *u != uid);
+        k.inserted.retain(|u| *u != uid);
+        for group in &mut k.groups {
+            group.retain(|u| *u != uid);
+        }
+        k.groups.retain(|g| !g.is_empty());
+    }
+}
+
+/// A directed removal is safe until random insertions introduce rank information.
+pub fn removed_from_draw(player: &mut PlayerCombatState, uid: CardUid) {
+    let unsupported = player
+        .draw_knowledge
+        .as_ref()
+        .is_some_and(|k| !k.inserted.is_empty() && k.base.contains(&uid));
+    if unsupported {
+        mark_unsupported(player, UnsupportedDrawOrder::NonTopRemovalAfterInsertion);
+    }
+    consumed_top(player, uid);
+}
+
+/// A card leaving the root's unordered discard cannot inherit that old membership.
+pub fn removed_from_discard(player: &mut PlayerCombatState, uid: CardUid) {
+    if let Some(k) = player.draw_knowledge.as_mut() {
+        for group in &mut k.discard_groups {
+            group.retain(|u| *u != uid);
+        }
+        k.discard_groups.retain(|g| !g.is_empty());
+    }
+}
+
+/// Uniform random insertion adds a free interleaving card, not another base member.
+pub fn inserted_randomly(player: &mut PlayerCombatState, uid: CardUid) {
+    if !player.pinned_top.is_empty() || !player.pinned_bottom.is_empty() {
+        // The legacy sorted-middle insert preserves pins. Do not silently
+        // reinterpret that helper's layout as a full-pile random insertion.
+        mark_unsupported(player, UnsupportedDrawOrder::ConditionalOrderQuery);
+    }
+    if let Some(k) = player.draw_knowledge.as_mut() {
+        if !k.groups.is_empty() && !k.inserted.contains(&uid) {
+            k.inserted.push(uid);
+        }
+    }
+}
+
+/// An ordered query can expose constraints this finite representation cannot retain.
+pub fn ordered_query(player: &mut PlayerCombatState) {
+    if player
+        .draw_knowledge
+        .as_ref()
+        .is_some_and(|k| !k.groups.is_empty())
+    {
+        mark_unsupported(player, UnsupportedDrawOrder::ConditionalOrderQuery);
+    }
+}
+
+/// Observable support of the next draw; this does not select or expose a hidden rank.
+pub(crate) fn possible_next(player: &PlayerCombatState) -> SmallVec<[CardUid; 32]> {
+    if let Some(uid) = player
+        .pinned_top
+        .first()
+        .filter(|u| player.draw.contains(u))
+    {
+        return smallvec::smallvec![*uid];
+    }
+    let middle: SmallVec<[CardUid; 32]> = player
+        .draw
+        .iter()
+        .copied()
+        .filter(|u| !player.pinned_top.contains(u) && !player.pinned_bottom.contains(u))
+        .collect();
+    if middle.is_empty() {
+        return player.draw.first().copied().into_iter().collect();
+    }
+    let Some(k) = player.draw_knowledge.as_ref() else {
+        return middle;
+    };
+    let priority = k
+        .groups
+        .iter()
+        .find(|g| g.iter().any(|u| middle.contains(u)));
+    if let Some(group) = priority {
+        middle
+            .into_iter()
+            .filter(|u| group.contains(u) || k.inserted.contains(u))
+            .collect()
+    } else {
+        middle
+    }
+}
+
+/// Select the next unknown position without assigning an internal order to a band.
+pub(crate) fn next_unknown_index(player: &PlayerCombatState, rng: &mut Rng) -> usize {
+    let begin = player.pinned_top.len();
+    let end = player.draw.len().saturating_sub(player.pinned_bottom.len());
+    let active = player
+        .draw_knowledge
+        .as_ref()
+        .filter(|k| !k.groups.is_empty());
+    let Some(k) = active else {
+        return if end - begin == 1 {
+            begin
+        } else {
+            begin + rng.next_int(0, (end - begin - 1) as i32) as usize
+        };
+    };
+    let indices: SmallVec<[usize; 32]> = (begin..end).collect();
+    let priority: SmallVec<[usize; 32]> = k
+        .groups
+        .iter()
+        .find_map(|group| {
+            let matches: SmallVec<[usize; 32]> = indices
+                .iter()
+                .copied()
+                .filter(|&i| group.contains(&player.draw[i]))
+                .collect();
+            (!matches.is_empty()).then_some(matches)
+        })
+        .unwrap_or_default();
+    if priority.is_empty() {
+        return choose_index(&indices, rng);
+    }
+    let inserted: SmallVec<[usize; 32]> = indices
+        .iter()
+        .copied()
+        .filter(|&i| k.inserted.contains(&player.draw[i]))
+        .collect();
+    if inserted.is_empty() {
+        return choose_index(&priority, rng);
+    }
+    // Each free card has probability 1/N; the base's first band shares
+    // the remaining base_count/N, independently of its member count.
+    let branch = rng.next_int(0, (indices.len() - 1) as i32) as usize;
+    let member = if branch < inserted.len() || priority.len() == 1 {
+        0
+    } else {
+        rng.next_int(0, (priority.len() - 1) as i32) as usize
+    };
+    interleaving_index(&priority, &inserted, branch, member)
+}
+
+/// The finite branch kernel is enumerable independently of a particular RNG seed.
+fn interleaving_index(
+    priority: &[usize],
+    inserted: &[usize],
+    branch: usize,
+    member: usize,
+) -> usize {
+    if branch < inserted.len() {
+        inserted[branch]
+    } else {
+        priority[member]
+    }
+}
+
+/// A singleton band is deterministic and consumes no random draw.
+fn choose_index(indices: &[usize], rng: &mut Rng) -> usize {
+    if indices.len() == 1 {
+        indices[0]
+    } else {
+        indices[rng.next_int(0, (indices.len() - 1) as i32) as usize]
+    }
+}
+
+/// Inspect PerfectFit membership without relying on a card's physical array index.
+fn perfect_fit(cards: &[Card], uid: CardUid) -> bool {
+    cards
+        .get((uid.get() as usize).saturating_sub(1))
+        .is_some_and(|c| c.has_enchantment(EnchantmentId::PerfectFit))
+}
+
+/// Receiver order before a real shuffle: draw then discard; later receivers place on top.
+pub(crate) fn receiver_groups(
+    player: &PlayerCombatState,
+    cards: &[Card],
+) -> Vec<SmallVec<[CardUid; 4]>> {
+    let mut groups = Vec::new();
+    {
+        let mut remaining: SmallVec<[CardUid; 32]> = player
+            .draw
+            .iter()
+            .copied()
+            .filter(|uid| perfect_fit(cards, *uid))
+            .collect();
+        for uid in &player.pinned_top {
+            if remaining.contains(uid) {
+                groups.push(smallvec::smallvec![*uid]);
+                remaining.retain(|u| u != uid);
+            }
+        }
+        if let Some(k) = player.draw_knowledge.as_ref() {
+            for band in &k.groups {
+                let group: SmallVec<[CardUid; 4]> = band
+                    .iter()
+                    .copied()
+                    .filter(|u| remaining.contains(u))
+                    .collect();
+                if !group.is_empty() {
+                    remaining.retain(|u| !group.contains(u));
+                    groups.push(group);
+                }
+            }
+        }
+        let middle: SmallVec<[CardUid; 4]> = remaining
+            .iter()
+            .copied()
+            .filter(|u| !player.pinned_bottom.contains(u))
+            .collect();
+        if !middle.is_empty() {
+            groups.push(middle);
+        }
+        for uid in &player.pinned_bottom {
+            if remaining.contains(uid) {
+                groups.push(smallvec::smallvec![*uid]);
+            }
+        }
+    }
+    let mut certified = SmallVec::<[CardUid; 32]>::new();
+    if let Some(k) = player.draw_knowledge.as_ref() {
+        for band in &k.discard_groups {
+            certified.extend(band.iter().copied());
+            let members: SmallVec<[CardUid; 4]> = band
+                .iter()
+                .copied()
+                .filter(|u| player.discard.contains(u) && perfect_fit(cards, *u))
+                .collect();
+            if !members.is_empty() {
+                groups.push(members);
+            }
+        }
+    }
+    // Cards newly appended during this rollout have observed chronological order.
+    for uid in player
+        .discard
+        .iter()
+        .copied()
+        .filter(|u| !certified.contains(u) && perfect_fit(cards, *u))
+    {
+        groups.push(smallvec::smallvec![uid]);
+    }
+    groups.reverse();
+    groups
+}
+
+/// Physical receiver order belongs only to the materialized rule application.
+pub(crate) fn native_receiver_order(player: &PlayerCombatState, cards: &[Card]) -> Vec<CardUid> {
+    player
+        .draw
+        .iter()
+        .chain(&player.discard)
+        .copied()
+        .filter(|u| perfect_fit(cards, *u))
+        .rev()
+        .collect()
+}
+
+/// Local shuffle preparation separates physical truth from public order knowledge.
+pub(crate) struct PreparedShuffle {
+    groups: Vec<SmallVec<[CardUid; 4]>>,
+    native_order: Vec<CardUid>,
+}
+
+/// Capture receiver order before piles are drained or stably sorted by the shuffle.
+pub(crate) fn prepare_shuffle(player: &mut PlayerCombatState, cards: &[Card]) -> PreparedShuffle {
+    normalize(player);
+    if player
+        .draw_knowledge
+        .as_ref()
+        .is_some_and(|k| k.inserted.iter().any(|uid| perfect_fit(cards, *uid)))
+    {
+        mark_unsupported(player, UnsupportedDrawOrder::InsertedPerfectFitReshuffle);
+    }
+    let groups = receiver_groups(player, cards);
+    let native_order = native_receiver_order(player, cards);
+    // An empty-draw refill erases the old hidden order. Its source is the
+    // public discard chronology (or the explicitly unknown root prefix).
+    let fresh_refill = player.draw.is_empty();
+    if let Some(k) = player.draw_knowledge.as_mut() {
+        if fresh_refill
+            && !player.deferred_draw_order
+            && k.unsupported != Some(UnsupportedDrawOrder::UnknownDiscardInsertion)
+        {
+            k.unsupported = None;
+        }
+        k.groups.clear();
+        k.base.clear();
+        k.inserted.clear();
+        k.discard_groups.clear();
+        k.prepared = false;
+    }
+    PreparedShuffle {
+        groups,
+        native_order,
+    }
+}
+
+/// Apply deterministic receiver moves; only an explicitly unknown band uses a prior.
+pub(crate) fn apply_shuffle(
+    player: &mut PlayerCombatState,
+    shuffled: &mut [CardUid],
+    prepared: PreparedShuffle,
+) {
+    let groups: Vec<SmallVec<[CardUid; 4]>> = prepared
+        .groups
+        .into_iter()
+        .map(|g| g.into_iter().filter(|u| shuffled.contains(u)).collect())
+        .filter(|g: &SmallVec<[CardUid; 4]>| !g.is_empty())
+        .collect();
+    if groups.is_empty() {
+        return;
+    }
+    let mut reordered: SmallVec<[CardUid; 32]> = if player.deferred_draw_order {
+        groups.iter().flatten().copied().collect()
+    } else {
+        prepared
+            .native_order
+            .into_iter()
+            .filter(|u| shuffled.contains(u))
+            .collect()
+    };
+    reordered.extend(
+        shuffled
+            .iter()
+            .copied()
+            .filter(|uid| !groups.iter().any(|g| g.contains(uid))),
+    );
+    shuffled.copy_from_slice(&reordered);
+    let k = knowledge_mut(player);
+    k.groups = groups;
+    k.base = reordered;
+    k.inserted.clear();
+    k.prepared = true;
+    k.observed = true;
+    if player.deferred_draw_order {
+        // The physical array remains canonical; the separate bands carry order knowledge.
+        shuffled.sort_unstable();
+    }
+}
+
+/// Invoke the public hook directly when no low-level shuffle has prepared it.
+pub(crate) fn apply_direct_hook(
+    player: &mut PlayerCombatState,
+    cards: &mut [CardUid],
+    store: &[Card],
+) {
+    let prepared = PreparedShuffle {
+        groups: receiver_groups(player, store),
+        native_order: native_receiver_order(player, store),
+    };
+    apply_shuffle(player, cards, prepared);
+}
