+fn parse_draw_knowledge<V: WireValue>(v: &V, draw_len: usize, discard_len: usize)
+    -> WireResult<ParsedDrawKnowledge>
+{
+    let path = "$.deck.draw_knowledge";
+    let object = as_dict(v, path)?;
+    let mut groups = Vec::new();
+    let mut seen = Vec::new();
+    if let Some(value) = extract_optional(&object, "groups") {
+        for (i, group) in as_list(&value, &format!("{path}.groups"))?.iter().enumerate() {
+            let members = parse_index_list(group, &format!("{path}.groups[{i}]"), draw_len)?;
+            if members.iter().any(|i| seen.contains(i)) {
+                return Err(schema_err(path, "priority bands must not overlap"));
+            }
+            seen.extend(members.iter().copied());
+            if !members.is_empty() { groups.push(members); }
+        }
+    }
+    let list = |key: &str, len: usize| -> WireResult<Vec<usize>> {
+        extract_optional(&object, key).map(|value| {
+            parse_index_list(&value, &format!("{path}.{key}"), len)
+        }).transpose().map(Option::unwrap_or_default)
+    };
+    let inserted = list("inserted", draw_len)?;
+    if inserted.iter().any(|i| seen.contains(i)) {
+        return Err(schema_err(path, "random insertions must not overlap priority bands"));
+    }
+    let base = match extract_optional(&object, "base") {
+        Some(value) => parse_index_list(&value, &format!("{path}.base"), draw_len)?,
+        None => (0..draw_len).filter(|i| !inserted.contains(i)).collect(),
+    };
+    if base.iter().any(|i| inserted.contains(i)) {
+        return Err(schema_err(path, "base and random insertions must not overlap"));
+    }
+    let unsupported = extract_optional(&object, "unsupported").map(|value| {
+        let code = value.as_str().ok_or_else(|| schema_err(path, "unsupported must be a code string"))?;
+        sts2_core::draw_knowledge::UnsupportedDrawOrder::from_code(&code)
+            .ok_or_else(|| schema_err(path, "unknown draw-knowledge cutoff code"))
+    }).transpose()?;
+    let mut discard_groups=Vec::new();
+    let mut discard_seen=Vec::new();
+    if let Some(value)=extract_optional(&object,"discard_groups") {
+        for (i,group) in as_list(&value,&format!("{path}.discard_groups"))?.iter().enumerate() {
+            let members=parse_index_list(group,&format!("{path}.discard_groups[{i}]"),discard_len)?;
+            if members.iter().any(|i|discard_seen.contains(i)){return Err(schema_err(path,"discard bands must not overlap"));}
+            discard_seen.extend(members.iter().copied());
+            if !members.is_empty(){discard_groups.push(members);}
+        }
+    }
+    let observed=extract_optional(&object,"observed").map(|v|v.as_bool()
+        .ok_or_else(||schema_err(path,"observed must be boolean"))).transpose()?.unwrap_or(true);
+    Ok(ParsedDrawKnowledge {observed,groups,inserted,base,discard_groups,unsupported})
+}
