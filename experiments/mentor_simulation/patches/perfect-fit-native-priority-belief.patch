+/// Public memberships only; callers aggregate anonymous members and expose only already-seen IDs.
+#[derive(Clone, Debug)]
+pub struct PublicDrawKnowledge {
+    pub available: bool,
+    pub reason: Option<&'static str>,
+    pub bands: Vec<Vec<CardUid>>,
+    pub inserted: Vec<CardUid>,
+    /// Complete PF coverage only: ordinary hidden discard insertion ranks are not exported.
+    pub discard_bands: Vec<Vec<CardUid>>,
+}
+
+/// Export rule-derived constraints, never ordinary physical draw order or hidden inserted ranks.
+pub fn export_public_knowledge(player: &PlayerCombatState, cards: &[Card]) -> PublicDrawKnowledge {
+    let has_pf = cards
+        .iter()
+        .any(|c| c.has_enchantment(EnchantmentId::PerfectFit));
+    let reason = unsupported_reason(player).or_else(|| {
+        (has_pf && !player.draw_knowledge.as_ref().is_some_and(|k| k.observed))
+            .then_some(UnsupportedDrawOrder::UnwitnessedPriority.code())
+    });
+    let unordered = |members: Vec<CardUid>| {
+        let mut members = members;
+        members.sort_unstable();
+        members.dedup();
+        members
+    };
+    if reason.is_some() {
+        let draw = unordered(player.draw.to_vec());
+        let discard = unordered(
+            player
+                .discard
+                .iter()
+                .copied()
+                .filter(|u| perfect_fit(cards, *u))
+                .collect(),
+        );
+        return PublicDrawKnowledge {
+            available: false,
+            reason,
+            bands: if draw.is_empty() { vec![] } else { vec![draw] },
+            inserted: vec![],
+            discard_bands: if discard.is_empty() {
+                vec![]
+            } else {
+                vec![discard]
+            },
+        };
+    }
+    let mut bands = Vec::new();
+    let mut used = SmallVec::<[CardUid; 32]>::new();
+    for uid in player
+        .pinned_top
+        .iter()
+        .copied()
+        .filter(|u| player.draw.contains(u))
+    {
+        bands.push(vec![uid]);
+        used.push(uid);
+    }
+    let inserted = player
+        .draw_knowledge
+        .as_ref()
+        .map(|k| {
+            unordered(
+                k.inserted
+                    .iter()
+                    .copied()
+                    .filter(|u| {
+                        player.draw.contains(u)
+                            && !used.contains(u)
+                            && !player.pinned_bottom.contains(u)
+                    })
+                    .collect(),
+            )
+        })
+        .unwrap_or_default();
+    if let Some(k) = &player.draw_knowledge {
+        for group in &k.groups {
+            let members = unordered(
+                group
+                    .iter()
+                    .copied()
+                    .filter(|u| {
+                        player.draw.contains(u)
+                            && !used.contains(u)
+                            && !inserted.contains(u)
+                            && !player.pinned_bottom.contains(u)
+                    })
+                    .collect(),
+            );
+            if !members.is_empty() {
+                used.extend(members.iter().copied());
+                bands.push(members);
+            }
+        }
+    }
+    let middle = unordered(
+        player
+            .draw
+            .iter()
+            .copied()
+            .filter(|u| {
+                !used.contains(u) && !inserted.contains(u) && !player.pinned_bottom.contains(u)
+            })
+            .collect(),
+    );
+    if !middle.is_empty() {
+        bands.push(middle);
+    }
+    for uid in player
+        .pinned_bottom
+        .iter()
+        .copied()
+        .filter(|u| player.draw.contains(u))
+    {
+        if !used.contains(&uid) {
+            bands.push(vec![uid]);
+            used.push(uid);
+        }
+    }
+    let mut discard_bands = Vec::new();
+    let mut certified = SmallVec::<[CardUid; 32]>::new();
+    if let Some(k) = &player.draw_knowledge {
+        for band in &k.discard_groups {
+            certified.extend(band.iter().copied());
+            let members = unordered(
+                band.iter()
+                    .copied()
+                    .filter(|u| player.discard.contains(u) && perfect_fit(cards, *u))
+                    .collect(),
+            );
+            if !members.is_empty() {
+                discard_bands.push(members);
+            }
+        }
+    }
+    // The real-world tracker began at combat birth. New PF discards are
+    // append events; random PF insertions with ambiguous order latch unsupported.
+    for uid in player
+        .discard
+        .iter()
+        .copied()
+        .filter(|u| !certified.contains(u) && perfect_fit(cards, *u))
+    {
+        discard_bands.push(vec![uid]);
+    }
+    PublicDrawKnowledge {
+        available: true,
+        reason: None,
+        bands,
+        inserted,
+        discard_bands,
+    }
+}
+
+/// Preserve known priority bands when blindfolding a materialized unknown pile.
+pub(crate) fn reshuffle_unknown(player: &mut PlayerCombatState, rng: &mut Rng) -> bool {
+    let Some(k) = player.draw_knowledge.as_ref() else {
+        return false;
+    };
+    if k.groups.is_empty() {
+        return false;
+    }
+    let mut middle = SmallVec::<[CardUid; 32]>::new();
+    let in_middle =
+        |u: &CardUid| !player.pinned_top.contains(u) && !player.pinned_bottom.contains(u);
+    for group in &k.groups {
+        let mut members: SmallVec<[CardUid; 32]> = group
+            .iter()
+            .copied()
+            .filter(|u| player.draw.contains(u) && in_middle(u))
+            .collect();
+        members.sort_unstable();
+        rng.shuffle(members.as_mut_slice());
+        middle.extend(members);
+    }
+    let mut ordinary: SmallVec<[CardUid; 32]> = player
+        .draw
+        .iter()
+        .copied()
+        .filter(|u| {
+            in_middle(u) && !k.inserted.contains(u) && !k.groups.iter().any(|g| g.contains(u))
+        })
+        .collect();
+    rng.shuffle(ordinary.as_mut_slice());
+    middle.extend(ordinary);
+    let mut inserted = k.inserted.clone();
+    inserted.sort_unstable();
+    for uid in inserted
+        .into_iter()
+        .filter(|u| player.draw.contains(u) && in_middle(u))
+    {
+        let at = rng.next_int(0, middle.len() as i32) as usize;
+        middle.insert(at, uid);
+    }
+    let mut result = player.pinned_top.clone();
+    result.extend(middle);
+    result.extend(player.pinned_bottom.iter().copied());
+    player.draw = result.into_iter().collect();
+    true
+}
