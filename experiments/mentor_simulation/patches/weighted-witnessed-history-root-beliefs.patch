+    /// Imported private RNG changes cannot alter posterior sampling or the first action outcome.
+    #[test]
+    fn root_beliefs_ignore_imported_rng_and_empty_beliefs_preserve_original_search() {
+        let (cheap, expensive) = hidden_cost_roots(false, 4);
+        let config = chance_cfg(903, 128);
+        let mut changed = cheap.clone();
+        changed.rng = sts2_core::dotnet_rng::Rng::new(9876);
+        changed.run_rng = sts2_core::run_rng_set::RunRngSet::new(9876);
+        let mut left = Mcts::new(cheap.clone(), config.clone())
+            .with_root_beliefs(vec![(cheap.clone(), 3.0), (expensive.clone(), 1.0)]).unwrap();
+        let mut right = Mcts::new(changed.clone(), config.clone())
+            .with_root_beliefs(vec![(changed, 3.0), (expensive, 1.0)]).unwrap();
+        assert_eq!(left.search(), right.search());
+        assert_eq!(left.root_visits(), right.root_visits());
+        let mut plain = Mcts::new(cheap.clone(), config.clone());
+        let mut empty = Mcts::new(cheap, config).with_root_beliefs(Vec::new()).unwrap();
+        assert_eq!(plain.search(), empty.search());
+        assert_eq!(plain.root_visits(), empty.root_visits());
+        assert_eq!(plain.tree.arena.len(), empty.tree.arena.len());
+    }
