+/// Condition a card picker only after its original RNG read, using its actual filtered support.
+pub fn condition_random_card_pick(
+    state: &mut CombatState,
+    sampled: CardUid,
+    support: &[CardUid],
+) -> CardUid {
+    let Some(observations) = state.replay_observations.as_mut() else {
+        return sampled;
+    };
+    if observations.error.is_some() {
+        return sampled;
+    }
+    let Some(prefix) = &observations.card_prefix else {
+        return sampled;
+    };
+    observations
+        .random_supports
+        .push(ObservedRandomSupport::Cards(support.to_vec()));
+    let Some(&card) = prefix.get(observations.cards_consumed) else {
+        observations.next_card_support = Some(support.to_vec());
+        observations.error = Some("observed_card_prefix_needs_branch");
+        return sampled;
+    };
+    if !support.contains(&card) {
+        observations.error = Some("observed_card_outside_positive_support");
+        return sampled;
+    }
+    observations.cards_consumed += 1;
+    observations.random_likelihood_bits =
+        (f64::from_bits(observations.random_likelihood_bits) / support.len() as f64).to_bits();
+    card
 }
 
