+        assert!(search.root_proven_win_action().is_none());
+        assert!(search.lost_position_override().is_none());
+        let chance = search.tree.node(search.root_child_for(&draw).unwrap());
+        assert_eq!(chance.chance_draws, chance.visits);
+        assert!(chance.chance_outcomes.len() >= 2);
+        assert!(!chance.proven_win && !chance.proven_loss && !chance.chance_closed);
+        assert!(!search.config.use_transposition_table && search.tt_hits() == 0);
+        assert!(!search.config.use_lethal_detector && !search.config.root_guards);
