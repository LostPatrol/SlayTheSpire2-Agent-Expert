+/// Sum face probabilities from the same pins, priority bands and insertion kernel as sampling.
+fn next_observation_probability(player: &PlayerCombatState, equivalents: &[CardUid]) -> f64 {
+    if let Some(uid) = player
+        .pinned_top
+        .first()
+        .filter(|uid| player.draw.contains(uid))
+    {
+        return if equivalents.contains(uid) { 1.0 } else { 0.0 };
+    }
+    let middle: SmallVec<[CardUid; 32]> = player
+        .draw
+        .iter()
+        .copied()
+        .filter(|uid| !player.pinned_top.contains(uid) && !player.pinned_bottom.contains(uid))
+        .collect();
+    if middle.is_empty() {
+        return if player
+            .draw
+            .first()
+            .is_some_and(|uid| equivalents.contains(uid))
+        {
+            1.0
+        } else {
+            0.0
+        };
+    }
+    let priority = player.draw_knowledge.as_ref().and_then(|knowledge| {
+        knowledge
+            .groups
+            .iter()
+            .find(|group| group.iter().any(|uid| middle.contains(uid)))
+    });
+    let Some(priority) = priority else {
+        return middle
+            .iter()
+            .filter(|uid| equivalents.contains(uid))
+            .count() as f64
+            / middle.len() as f64;
+    };
+    let knowledge = player
+        .draw_knowledge
+        .as_ref()
+        .expect("priority has knowledge");
+    let inserted_count = middle
+        .iter()
+        .filter(|uid| knowledge.inserted.contains(uid))
+        .count();
+    let inserted_matches = middle
+        .iter()
+        .filter(|uid| knowledge.inserted.contains(uid) && equivalents.contains(uid))
+        .count();
+    let priority_count = middle.iter().filter(|uid| priority.contains(uid)).count();
+    let priority_matches = middle
+        .iter()
+        .filter(|uid| priority.contains(uid) && equivalents.contains(uid))
+        .count();
+    // Each inserted card gets 1/N; the first band shares all remaining base probability.
+    (inserted_matches as f64
+        + (middle.len() - inserted_count) as f64 * priority_matches as f64 / priority_count as f64)
+        / middle.len() as f64
 }
 
