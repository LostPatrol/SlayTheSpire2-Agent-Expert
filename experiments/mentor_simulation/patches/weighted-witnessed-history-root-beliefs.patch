+        let action = Action::PlayCard { hand_index: 0, target: None };
+        let mut search = Mcts::new(state.clone(), chance_cfg(905, 1))
+            .with_root_beliefs(vec![(state, 1.0)]).unwrap()
+            .with_root_allowed(&[action.clone()]);
+        let _ = search.search();
+        let chance = search.root_child_for(&action).unwrap();
+        let path = [search.tree.root, chance];
+        for _ in 0..64 {
+            let _ = search.sample_root_belief_outcome(chance, &path);
+        }
+        let outcomes = &search.tree.node(chance).chance_outcomes;
+        assert!(outcomes.len() > 1, "Alchemize must retain different potion outcomes");
+        let first = search.tree.node(outcomes[0].child);
+        assert!(outcomes.iter().all(|outcome|
+            search.tree.node(outcome.child).search_hash == first.search_hash),
+            "the legacy key omits actual potion belts; this fixture must expose that alias");
+        let belts: std::collections::BTreeSet<_> = outcomes.iter().map(|outcome|
+            format!("{:?}", search.tree.node(outcome.child).realized.as_deref().unwrap().player.potions))
+            .collect();
+        assert_eq!(outcomes.len(), belts.len(), "one outcome per distinct realized belt");
