+    fn brilliant_scarf_frees_only_the_fifth_manual_play() {
+        let mut state = CombatState::default();
+        for (index, kind) in [crate::RelicKind::BrilliantScarf, crate::RelicKind::SpikedGauntlets]
+            .into_iter().enumerate()
+        {
+            state.relics.push(crate::Relic {
+                id: std::num::NonZeroU32::new(index as u32 + 1).expect("nonzero"),
+                kind,
+                counter: 0,
+                is_wax: false,
+                is_melted: false,
+            });
+        }
+        let ctx = CardCostCtx {
+            base_cost: 2,
+            card_type: Some(crate::cards::CardType::Power),
+            ..CardCostCtx::default()
+        };
+        for (played, expected) in [(0, 3), (3, 3), (4, 0), (5, 3), (9, 3)] {
+            state.player.cards_first_in_series_this_turn = played;
+            assert_eq!(dispatch_modify_card_cost(&state, &ctx), expected);
+        }
+        state.player.cards_first_in_series_this_turn = 4;
+        assert!(!brilliant_scarf_cost_zeroed(&state, 2, || true));
+        assert!(!brilliant_scarf_cost_zeroed(&state, -1, || false));
+        // Scarf was inserted first; the store API also updates derived ownership.
+        state.relics.set_melted(0, true);
+        assert_eq!(dispatch_modify_card_cost(&state, &ctx), 3);
+    }
