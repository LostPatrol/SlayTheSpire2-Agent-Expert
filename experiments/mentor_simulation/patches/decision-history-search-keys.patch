+//! Search keys must distinguish histories that change the original card or power resolver.
+//! Legacy state/run hash contracts remain outside this targeted repair.
+
+use sts2_core::cards::CardId;
+use sts2_core::{Action, CardUid, CombatPhase, CombatState, MonsterKind};
+
+/// Construct two mechanically identical arenas whose only difference will be a public history counter.
+fn fixture(id: CardId) -> CombatState {
+    sts2_content::cards::dispatch::ensure_installed();
+    let mut state = CombatState {
+        phase: CombatPhase::PlayerPlayPhase,
+        ..CombatState::default()
+    };
+    state.player.current_hp = 80;
+    state.player.max_hp = 80;
+    state.player.energy = 3;
+    state.init_player_creature();
+    let enemy = state.spawn_enemy(MonsterKind::Nibbit);
+    let creature = state
+        .creatures
+        .iter_mut()
+        .find(|c| c.id == enemy.0)
+        .unwrap();
+    creature.current_hp = 200;
+    creature.max_hp = 200;
+    let mut card = sts2_content::cards::spec_index::card_pod_from_id(id, false).unwrap();
+    card.uid = CardUid::new(1).unwrap();
+    state.player.hand.push(card.uid);
+    state.cards.push(card);
+    state
+}
+
+/// Invoke the real card handler and measure HP loss rather than duplicating its formula.
+fn damage(mut state: CombatState) -> i32 {
+    let uid = state.enemy_uids[0];
+    let before = state
+        .creatures
+        .iter()
+        .find(|c| c.id == uid.0)
+        .unwrap()
+        .current_hp;
+    sts2_core::apply(
+        &mut state,
+        Action::PlayCard {
+            hand_index: 0,
+            target: Some(0),
+        },
+    );
+    before
+        - state
+            .creatures
+            .iter()
+            .find(|c| c.id == uid.0)
+            .unwrap()
+            .current_hp
+}
+
+/// Different Helix Drill damage requires distinct search keys, while legacy hashes remain unchanged.
+#[test]
+fn history_keys_distinguish_helix_energy_spent() {
+    let zero = fixture(CardId::HelixDrill);
+    let mut one = zero.clone();
+    one.combat_log.energy_spent_this_turn = 1;
+    let keys_zero = (
+        sts2_core::tt_hash_v2(&zero),
+        sts2_core::chance_outcome_hash(&zero),
+    );
+    let keys_one = (
+        sts2_core::tt_hash_v2(&one),
+        sts2_core::chance_outcome_hash(&one),
+    );
+    assert_eq!(sts2_core::state_hash(&zero), sts2_core::state_hash(&one));
+    assert_eq!(sts2_core::search_hash(&zero), sts2_core::search_hash(&one));
+    assert_eq!(
+        keys_zero,
+        (
+            sts2_core::tt_hash_v2(&zero.clone()),
+            sts2_core::chance_outcome_hash(&zero.clone())
+        )
+    );
+    let outcomes = (damage(zero), damage(one));
+    assert_eq!(outcomes, (0, 3));
+    assert_ne!(keys_zero.0, keys_one.0);
+    assert_ne!(keys_zero.1, keys_one.1);
+}
+
+/// Generation and lost-HP history affect independent original handlers, not just Helix's hit loop.
+#[test]
+fn history_keys_distinguish_supermassive_and_spite_effects() {
+    for (id, expected) in [(CardId::Supermassive, (5, 8)), (CardId::Spite, (5, 10))] {
+        let zero = fixture(id);
+        let mut one = zero.clone();
+        if id == CardId::Supermassive {
+            one.player.generated_cards_this_combat = 1;
+        } else {
+            one.combat_log.hp_lost_this_turn = 1;
+        }
+        assert_ne!(sts2_core::tt_hash_v2(&zero), sts2_core::tt_hash_v2(&one));
+        assert_ne!(
+            sts2_core::chance_outcome_hash(&zero),
+            sts2_core::chance_outcome_hash(&one)
+        );
+        assert_eq!((damage(zero), damage(one)), expected);
+    }
+}
+
+/// Completed non-auto history changes the native Scarf free-cost window.
+#[test]
+fn history_keys_distinguish_scarf_completed_non_auto_history() {
+    let mut three = fixture(CardId::DefendIronclad);
+    three.relics.push(sts2_core::Relic {
+        id: std::num::NonZeroU32::new(1).unwrap(),
+        kind: sts2_core::RelicKind::BrilliantScarf,
+        counter: 0,
+        is_wax: false,
+        is_melted: false,
+    });
+    three.player.non_auto_card_plays_finished_this_turn = 3;
+    let mut four = three.clone();
+    four.player.non_auto_card_plays_finished_this_turn = 4;
+    let uid = three.player.hand[0];
+    assert_eq!(
+        (
+            sts2_core::hooks::effective_card_cost(&three, uid),
+            sts2_core::hooks::effective_card_cost(&four, uid)
+        ),
+        (1, 0)
+    );
+    assert_ne!(sts2_core::tt_hash_v2(&three), sts2_core::tt_hash_v2(&four));
+    assert_ne!(
+        sts2_core::chance_outcome_hash(&three),
+        sts2_core::chance_outcome_hash(&four)
+    );
+}
+
+/// Retain names a concrete card: swapping its mechanics cannot hide behind the same pile multiset.
+#[test]
+fn history_keys_bind_referenced_card_mechanics_to_uid() {
+    let mut left = fixture(CardId::DefendIronclad);
+    let mut attack =
+        sts2_content::cards::spec_index::card_pod_from_id(CardId::StrikeIronclad, false).unwrap();
+    attack.uid = CardUid::new(2).unwrap();
+    left.player.hand.push(attack.uid);
+    left.cards.push(attack);
+    left.player.retain_this_turn.push(CardUid::new(1).unwrap());
+    let mut right = left.clone();
+    right.cards.swap(0, 1);
+    right.cards[0].uid = CardUid::new(1).unwrap();
+    right.cards[1].uid = CardUid::new(2).unwrap();
+    assert_ne!(
+        sts2_core::chance_outcome_hash(&left),
+        sts2_core::chance_outcome_hash(&right)
+    );
+    for state in [&mut left, &mut right] {
+        sts2_core::combat_loop::end_player_turn_phase_one(state);
+        sts2_core::combat_loop::end_player_turn_phase_two(state);
+        assert_eq!(state.player.hand.len(), 1);
+    }
+    assert_eq!(
+        left.cards[left.player.hand[0].get() as usize - 1].card_id,
+        CardId::DefendIronclad
+    );
+    assert_eq!(
+        right.cards[right.player.hand[0].get() as usize - 1].card_id,
+        CardId::StrikeIronclad
+    );
+}
+
+/// A referenced same-face copy's replay count changes the actual retained card's later block.
+#[test]
+fn history_keys_bind_replay_count_for_referenced_copy() {
+    let mut left = fixture(CardId::DefendIronclad);
+    let mut duplicate = left.cards[0];
+    duplicate.uid = CardUid::new(2).unwrap();
+    duplicate.base_replay_count = 1;
+    left.player.hand.push(duplicate.uid);
+    left.cards.push(duplicate);
+    left.player.retain_this_turn.push(CardUid::new(1).unwrap());
+    let mut right = left.clone();
+    right.cards.swap(0, 1);
+    right.cards[0].uid = CardUid::new(1).unwrap();
+    right.cards[1].uid = CardUid::new(2).unwrap();
+    let keys_left = (
+        sts2_core::tt_hash_v2(&left),
+        sts2_core::chance_outcome_hash(&left),
+    );
+    let keys_right = (
+        sts2_core::tt_hash_v2(&right),
+        sts2_core::chance_outcome_hash(&right),
+    );
+    let mut outcomes = Vec::new();
+    for mut state in [left, right] {
+        sts2_core::apply(&mut state, Action::EndTurn);
+        assert_eq!(state.player.hand[0], CardUid::new(1).unwrap());
+        let block = state.player.block;
+        sts2_core::apply(
+            &mut state,
+            Action::PlayCard {
+                hand_index: 0,
+                target: None,
+            },
+        );
+        outcomes.push(state.player.block - block);
+    }
+    println!(
+        "referenced_copy keys_left={keys_left:?} keys_right={keys_right:?} block={outcomes:?}"
+    );
+    assert_eq!(outcomes, vec![5, 10]);
+    assert_ne!(keys_left.0, keys_right.0);
+    assert_ne!(keys_left.1, keys_right.1);
+}
+
+/// Public recording flags and replay-only scratch cannot split an otherwise identical search state.
+#[test]
+fn history_keys_ignore_recorders_and_replay_observations() {
+    let plain = fixture(CardId::HelixDrill);
+    let keys = (
+        sts2_core::tt_hash_v2(&plain),
+        sts2_core::chance_outcome_hash(&plain),
+    );
+    let mut recorded = plain.clone();
+    recorded.combat_log.event_log.set_recording(true);
+    recorded
+        .combat_log
+        .event_log
+        .set_public_history_recording(true);
+    recorded.combat_log.record_card_play_log = true;
+    assert_eq!(
+        keys,
+        (
+            sts2_core::tt_hash_v2(&recorded),
+            sts2_core::chance_outcome_hash(&recorded)
+        )
+    );
+    sts2_core::witnessed_outcomes::with_observed_outcomes(&mut recorded, &[], &[], |state| {
+        assert_eq!(
+            keys,
+            (
+                sts2_core::tt_hash_v2(state),
+                sts2_core::chance_outcome_hash(state)
+            )
+        );
+        Ok(sts2_core::StepResult::Advanced)
+    })
+    .unwrap();
+}
