+/// comparison. Also binds full card mechanics to history-referenced UIDs.
 fn card_observational_key(card: &crate::Card) -> u64 {
     let sentinel = crate::CardUid::new(1).expect("1 is a valid non-zero CardUid");
     let mut c = *card;
