+/// Domain tag for the appended history section; legacy state/search/run layouts remain unchanged.
+const DECISION_HISTORY_TAG: &str = "decision_history_v1";
+
+/// Hash real history and budgets used by card effects, powers, legal actions or the leaf evaluator.
+fn hash_decision_history<H: Hasher>(state: &CombatState, h: &mut H) {
+    DECISION_HISTORY_TAG.hash(h);
+    (state.gold, state.energy_wasted, state.cards_drawn).hash(h);
+    hash_player_history(&state.player, h);
+    hash_turn_history(&state.combat_log, h);
+    for ally in &state.allies {
+        hash_player_history(ally, h);
+    }
+    if state.coop.full {
+        for seat in &state.coop.stash {
+            seat.seat.hash(h);
+            hash_turn_history(&seat.combat_log, h);
+        }
+    }
+    hash_referenced_history_cards(state, h);
+}
+
+/// Bind every history-referenced UID to full card mechanics, including keywords and replay modifiers.
+fn hash_referenced_history_cards<H: Hasher>(state: &CombatState, h: &mut H) {
+    let mut referenced = smallvec::SmallVec::<[u32; 8]>::new();
+    append_player_history_uids(&state.player, &mut referenced);
+    append_turn_history_uids(&state.combat_log, &mut referenced);
+    for ally in &state.allies {
+        append_player_history_uids(ally, &mut referenced);
+    }
+    for seat in &state.coop.stash {
+        append_turn_history_uids(&seat.combat_log, &mut referenced);
+    }
+    referenced.sort_unstable();
+    referenced.dedup();
+    referenced.len().hash(h);
+    for uid in referenced {
+        uid.hash(h);
+        state.cards
+            .get(uid as usize - 1)
+            .filter(|card| card.uid.get() == uid)
+            .map(card_observational_key)
+            .hash(h);
+    }
+}
+
+/// Keep per-player play/generation history independent of observer flags and recording buffers.
+fn hash_player_history<H: Hasher>(p: &PlayerCombatState, h: &mut H) {
+    (
+        p.cards_played_this_turn,
+        p.card_plays_started_this_turn,
+        p.cards_first_in_series_this_turn,
+        p.manual_card_series_this_turn,
+        p.non_auto_card_plays_finished_this_turn,
+        p.shivs_played_this_turn,
+        p.stars_gained_this_turn,
+        p.generated_cards_this_combat,
+        p.powered_hits_this_turn,
+        p.request_end_turn_after_play,
+        p.pending_retain_count,
+    )
+        .hash(h);
+    hash_card_uid_set(&p.retain_this_turn, h);
+    hash_card_uid_set(&p.sly_this_turn, h);
+    hash_card_uid_set(&p.sly_this_combat, h);
+    let mut targets = p.powered_hits_by_target_this_turn.clone();
+    targets.sort_unstable_by_key(|(uid, count)| (uid.get(), *count));
+    targets.as_slice().hash(h);
+}
+
+/// Include public rule history, retaining repeated block gains while excluding diagnostic logs and scratch.
+fn hash_turn_history<H: Hasher>(log: &crate::TurnEvents, h: &mut H) {
+    (
+        log.energy_spent_this_turn,
+        log.hp_lost_this_turn,
+        log.unblocked_damage_received_this_combat,
+        log.cards_exhausted_this_turn,
+        log.cards_discarded_this_turn,
+        log.cards_drawn_by_effect_this_turn,
+        log.status_cards_drawn_this_turn,
+        log.zero_cost_attacks_played_this_turn,
+        log.card_plays_finished_this_turn,
+        log.card_plays_finished_last_player_turn,
+    )
+        .hash(h);
+    (
+        log.lightning_orbs_channeled_this_combat,
+        log.player_card_plays_this_combat,
+        log.ethereal_cards_played_this_combat,
+        log.bound_cards_afflicted_by_chains_this_turn,
+        log.exhaust_sweep_ethereal,
+        log.joss_paper_ethereal_count,
+        log.block_zero_at_turn_end,
+        log.block_before_late_turn_end,
+        log.extra_turns_taken_this_combat,
+    )
+        .hash(h);
+    hash_card_uid_set(&log.fetch_played_this_turn, h);
+    let mut targets = log.osty_powered_hits_by_target_this_turn.clone();
+    targets.sort_unstable_by_key(|(uid, count)| (uid.get(), *count));
+    targets.as_slice().hash(h);
+    log.last_attack_skill_played.hash(h);
+    log.prev_round_last_attack_skill_played.hash(h);
+    let mut blocks = log.unmovable_card_block_plays.clone();
+    blocks.sort_unstable();
+    blocks.as_slice().hash(h);
+}
+
+/// Membership-only card sets have no rule-relevant insertion order.
+fn hash_card_uid_set<H: Hasher>(uids: &[crate::CardUid], h: &mut H) {
+    let mut members: smallvec::SmallVec<[u32; 8]> = uids.iter().map(|uid| uid.get()).collect();
+    members.sort_unstable();
+    members.dedup();
+    members.as_slice().hash(h);
+}
+
+/// Add the concrete cards named by per-player history before observational chance-pile folding.
+fn append_player_history_uids(p: &PlayerCombatState, uids: &mut smallvec::SmallVec<[u32; 8]>) {
+    uids.extend(
+        p.retain_this_turn
+            .iter()
+            .chain(&p.sly_this_turn)
+            .chain(&p.sly_this_combat)
+            .map(|uid| uid.get()),
+    );
+}
+
+/// Fetch and HistoryCourse can consult the exact card instance, even after it leaves a current pile.
+fn append_turn_history_uids(log: &crate::TurnEvents, uids: &mut smallvec::SmallVec<[u32; 8]>) {
+    uids.extend(log.fetch_played_this_turn.iter().map(|uid| uid.get()));
+    uids.extend(
+        [
+            log.last_attack_skill_played,
+            log.prev_round_last_attack_skill_played,
+        ]
+        .into_iter()
+        .flatten()
+        .filter_map(|(_, _, uid)| uid.map(|uid| uid.get())),
+    );
+}
