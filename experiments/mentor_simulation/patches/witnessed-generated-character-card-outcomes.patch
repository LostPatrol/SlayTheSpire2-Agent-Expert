@@ -0,0 +1,215 @@
+//! Past generated-card observations use the original character sampler and generation effects.
+//! Factory evidence precedes listeners; raw future draws remain unconstrained.
+
+use sts2_content::{cards::dispatch, monster_dispatch::MonsterSpawnArgs};
+use sts2_core::cards::{CardId, CardType, VarKey};
+use sts2_core::runstate::{RoomType, RunState};
+use sts2_core::witnessed_outcomes::{with_observed_generated_cards, ObservedGeneratedCard};
+use sts2_core::{Action, CardUid, CharacterId, CombatState, MonsterKind, StepResult};
+
+/// Start a real Defect combat and give it one White Noise with no hidden intermediate plays.
+fn fixture() -> (CombatState, CardUid) {
+    dispatch::ensure_installed();
+    let mut run = RunState {
+        character_id: CharacterId::Defect,
+        current_hp: 80,
+        max_hp: 80,
+        ..RunState::default()
+    };
+    sts2_content::run_callbacks::populate_starter_deck(&mut run, CharacterId::Defect);
+    let mut state = sts2_content::run_bridge::enter_combat_from_roster(
+        &run,
+        &[(MonsterKind::Nibbit, MonsterSpawnArgs::None, 100)],
+        RoomType::Monster,
+    );
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.discard.clear();
+    state.player.energy = 9;
+    let source = add_white_noise(&mut state);
+    (state, source)
+}
+
+/// Add the registered source without changing its effect, cost or original dispatch path.
+fn add_white_noise(state: &mut CombatState) -> CardUid {
+    let mut card =
+        sts2_content::cards::spec_index::card_pod_from_id(CardId::WhiteNoise, false).unwrap();
+    card.uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    let uid = card.uid;
+    state.cards.push(card);
+    state.player.hand.push(uid);
+    uid
+}
+
+/// Observe the unmodified factory role; White Noise supplies temporary free cost afterward.
+fn evidence(source: CardUid, card_id: CardId) -> ObservedGeneratedCard {
+    ObservedGeneratedCard {
+        source,
+        character: CharacterId::Defect,
+        card_type: Some(CardType::Power),
+        card_id,
+        upgraded: false,
+    }
+}
+
+/// Play the actual source as a normal manual card.
+fn play(state: &mut CombatState) -> StepResult {
+    sts2_core::apply(
+        state,
+        Action::PlayCard {
+            hand_index: 0,
+            target: None,
+        },
+    )
+}
+
+/// Buffer is in the original Power pool; the original shuffle, free flag and listeners still run.
+#[test]
+fn observed_generated_cards_replay_white_noise_buffer_with_original_rng_and_effects() {
+    let (before, source) = fixture();
+    let mut raw = before.clone();
+    assert_ne!(play(&mut raw), StepResult::InvalidTarget);
+    let mut observed = before.clone();
+    with_observed_generated_cards(
+        &mut observed,
+        &[evidence(source, CardId::BufferCard)],
+        |s| Ok(play(s)),
+    )
+    .unwrap();
+    assert_eq!(observed.run_rng, raw.run_rng);
+    assert!(
+        observed.run_rng.combat_card_generation.counter()
+            > before.run_rng.combat_card_generation.counter()
+    );
+    assert_eq!(observed.player.hand.len(), 1);
+    let card = sts2_core::card_by_uid(&observed.cards, observed.player.hand[0]).unwrap();
+    assert_eq!((card.card_id, card.upgraded), (CardId::BufferCard, false));
+    assert_eq!(card.combat_var(VarKey::FreeThisTurn), 1);
+    assert_eq!(card.combat_var(VarKey::GeneratedInCombat), 1);
+    assert_eq!(
+        sts2_core::hooks::effective_card_cost(&observed, card.uid),
+        0
+    );
+    assert!(observed.player.exhaust.contains(&source));
+    assert_eq!(
+        observed.player.generated_cards_this_combat,
+        before.player.generated_cards_this_combat + 1
+    );
+    assert!(observed.replay_observations.is_none());
+}
+
+/// Bad pool, role, source, upgrade, extra or missing evidence restores the complete before-state.
+#[test]
+fn observed_generated_cards_reject_bad_or_incomplete_evidence_atomically() {
+    let (before, source) = fixture();
+    let valid = evidence(source, CardId::BufferCard);
+    let mut bad_source = valid.clone();
+    bad_source.source = CardUid::new(source.get() + 1).unwrap();
+    let mut bad_character = valid.clone();
+    bad_character.character = CharacterId::Ironclad;
+    let mut bad_type = valid.clone();
+    bad_type.card_type = Some(CardType::Skill);
+    let mut bad_upgrade = valid.clone();
+    bad_upgrade.upgraded = true;
+    for (expected, reason) in [
+        (vec![], "observed_generated_card_unwitnessed_extra_event"),
+        (
+            vec![valid.clone(), valid.clone()],
+            "observed_generated_card_queue_not_consumed",
+        ),
+        (vec![bad_source], "observed_generated_card_source_mismatch"),
+        (vec![bad_character], "observed_generated_card_role_mismatch"),
+        (vec![bad_type], "observed_generated_card_role_mismatch"),
+        (
+            vec![bad_upgrade],
+            "observed_generated_card_outside_positive_support",
+        ),
+        (
+            vec![evidence(source, CardId::BarricadeCard)],
+            "observed_generated_card_outside_positive_support",
+        ),
+        (
+            vec![evidence(source, CardId::Zap)],
+            "observed_generated_card_outside_positive_support",
+        ),
+    ] {
+        let mut state = before.clone();
+        assert_eq!(
+            with_observed_generated_cards(&mut state, &expected, |s| Ok(play(s))),
+            Err(reason)
+        );
+        assert_eq!(state, before);
+    }
+    let mut state = before.clone();
+    assert_eq!(
+        with_observed_generated_cards(&mut state, &[valid], |s| {
+            let _ = play(s);
+            Err("after_state_mismatch")
+        }),
+        Err("after_state_mismatch")
+    );
+    assert_eq!(state, before);
+}
+
+/// Natural evidence is exactly the raw world, and a later source has no past constraint left.
+#[test]
+fn observed_generated_cards_preserve_default_sampling_and_future_generation() {
+    let (before, source) = fixture();
+    let mut raw = before.clone();
+    let _ = play(&mut raw);
+    let natural = sts2_core::card_by_uid(&raw.cards, raw.player.hand[0])
+        .unwrap()
+        .card_id;
+    let mut observed = before;
+    with_observed_generated_cards(&mut observed, &[evidence(source, natural)], |s| Ok(play(s)))
+        .unwrap();
+    assert_eq!(observed, raw);
+    for state in [&mut observed, &mut raw] {
+        state.player.hand.clear();
+        add_white_noise(state);
+        let _ = play(state);
+        assert!(state.replay_observations.is_none());
+    }
+    assert_eq!(observed, raw);
+}
+
+/// Past card evidence composes with the existing complete-draw wrapper without changing its scope.
+#[test]
+fn observed_generated_cards_compose_with_draws_and_are_disarmed_by_search() {
+    let (mut state, source) = fixture();
+    with_observed_generated_cards(&mut state, &[evidence(source, CardId::BufferCard)], |s| {
+        let before_hash = sts2_core::chance_outcome_hash(s);
+        let mut search = sts2_mcts::Mcts::new(
+            s.clone(),
+            sts2_mcts::MctsConfig {
+                hidden_info: sts2_mcts::HiddenInfoMode::Clairvoyant,
+                max_simulations: 8,
+                ..sts2_mcts::MctsConfig::default()
+            },
+        );
+        assert!(search.tree.root_state.replay_observations.is_none());
+        assert_eq!(before_hash, sts2_core::chance_outcome_hash(s));
+        search.try_search_n(8).unwrap();
+        let mut committed = s.clone();
+        let _ = play(&mut committed);
+        assert!(committed.replay_observations.is_some());
+        assert!(search.reroot(
+            &Action::PlayCard {
+                hand_index: 0,
+                target: None
+            },
+            committed
+        ));
+        assert!(search.tree.root_state.replay_observations.is_none());
+        sts2_core::draw_knowledge::apply_observed_draws(
+            s,
+            Action::PlayCard {
+                hand_index: 0,
+                target: None,
+            },
+            &[],
+        )
+    })
+    .unwrap();
+    assert!(state.replay_observations.is_none());
+}
