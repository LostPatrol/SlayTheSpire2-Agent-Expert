+/// Check the actual filtered factory support after its original RNG read; never allocate a card here.
+pub fn condition_generated_character_card(
+    state: &mut CombatState,
+    source: Option<CardUid>,
+    character: CharacterId,
+    card_type: Option<CardType>,
+    sampled: (CardId, bool),
+    supported: impl FnOnce(CardId, bool) -> bool,
+) -> (CardId, bool) {
+    let Some(observations) = state.replay_observations.as_mut() else {
+        return sampled;
+    };
+    if observations.error.is_some() {
+        return sampled;
+    }
+    let Some(expected) = observations
+        .generated_cards
+        .get(observations.generated_consumed)
+    else {
+        observations.error = Some("observed_generated_card_unwitnessed_extra_event");
+        return sampled;
+    };
+    if source != Some(expected.source) {
+        observations.error = Some("observed_generated_card_source_mismatch");
+        return sampled;
+    }
+    if character != expected.character || card_type != expected.card_type {
+        observations.error = Some("observed_generated_card_role_mismatch");
+        return sampled;
+    }
+    if !supported(expected.card_id, expected.upgraded) {
+        observations.error = Some("observed_generated_card_outside_positive_support");
+        return sampled;
+    }
+    observations.generated_consumed += 1;
+    (expected.card_id, expected.upgraded)
+}
