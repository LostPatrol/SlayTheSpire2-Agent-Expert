+    /// Run the original search, using small deadline-aware batches only for explicit serving calls.
+    fn execute_combat_search(&mut self,tree:&mut Mcts<sts2_mcts::SharedPolicy>,sims:u32)->Option<Action> {
+        let Some(execution)=self.embedded_execution else {return tree.try_search_n(sims).ok();};
+        let mut completed=0;
+        let mut chosen=None;
+        while completed<sims && (completed==0 || execution.deadline.is_none_or(|deadline|std::time::Instant::now()<deadline)) {
+            let batch=execution.batch_size.max(1).min(sims-completed);
+            match tree.try_search_n(batch) {
+                Ok(action)=>{chosen=Some(action);completed+=batch;},
+                Err(error)=>{self.embedded_error=Some(format!("mcts_search:{error:?}"));break;},
+            }
+        }
+        self.embedded_simulations=completed;
+        self.sims_spent-=u64::from(sims-completed);
+        chosen
+    }
+
+    /// Reuse the complete combat wrapper with no meta substitution and return its real tree.
+    /// Forced roots keep native zero-work behavior unless explicit terminal statistics were requested.
+    pub fn search_combat(&mut self,run:&RunManager,combat:&CombatState,execution:CombatSearchExecution)
+        ->Result<CombatSearchDecision,String> {
+        self.decisions=execution.counter;
+        self.embedded_execution=Some(execution);
+        self.embedded_tree=None;
+        self.embedded_simulations=0;
+        self.embedded_error=None;
+        self.retained=None;
+        let actions:Vec<_>=sts2_core::legal_actions(combat).iter().filter_map(translate_combat_action).collect();
+        let picked=self.mcts_pick(run,combat,&actions);
+        self.embedded_execution=None;
+        if let Some(error)=self.embedded_error.take() {return Err(error);}
+        if picked.is_none() {return Err("upstream_combat_action_not_surfaceable".into());}
+        let action=self.last_combat_search.as_ref().ok_or("upstream_combat_record_missing")?.chosen.clone();
+        let tree=self.embedded_tree.take().ok_or("upstream_combat_tree_missing")?;
+        Ok(CombatSearchDecision {tree,action,simulations:self.embedded_simulations,
+            counter:execution.counter,search_seed:self.embedded_seed,forced:self.embedded_simulations==0})
+    }
+
