+/// Derive the original per-run combat decision seed from an explicit policy seed and counter.
+#[must_use]
+pub fn combat_search_seed(run_seed: i32, counter: u64) -> u64 {
+    let bits = u64::from(u32::from_ne_bytes(run_seed.to_ne_bytes()));
+    splitmix64(bits ^ counter.wrapping_add(1).wrapping_mul(0x9E37_79B9_7F4A_7C15))
+}
