+    /// Decode an externally aggregated distribution with this policy's original group/tie rules.
+    #[must_use]
+    pub fn decode_probabilities(&self, actions: &[ActionDesc], probs: &[f32]) -> Option<usize> {
+        if actions.len() != probs.len() || probs.iter().any(|p| !p.is_finite()) {
+            return None;
+        }
+        if self.group_decode {
+            grouped_argmax(actions, probs)
+        } else {
+            argmax_first(probs)
+        }
+    }
