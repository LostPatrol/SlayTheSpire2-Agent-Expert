+
+impl std::fmt::Debug for CombatSearchTransforms {
+    /// Report hook presence without formatting caller closures or addresses.
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("CombatSearchTransforms")
+    }
+}
