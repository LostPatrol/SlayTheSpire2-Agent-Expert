+    /// Apply explicit embedding controls while retaining wrapper seeds, guards, vetoes and actions.
+    /// Hooks use fresh trees; retained-tree reuse is disabled while either hook is installed.
+    pub fn with_search_transforms<S, T>(mut self, setup: S, tree: T) -> Self
+    where
+        S: Fn(&RunManager, &CombatState, CombatSearchSetup) -> CombatSearchSetup + Send + Sync + 'static,
+        T: Fn(Mcts<sts2_mcts::SharedPolicy>, &CombatState) -> Mcts<sts2_mcts::SharedPolicy> + Send + Sync + 'static,
+    {
+        self.search_transforms = Some(CombatSearchTransforms {setup: Arc::new(setup), tree: Arc::new(tree)});
+        self.retained = None;
+        self
+    }
+
+    /// Transform a fresh tree only when the embedding caller explicitly installed a hook.
+    fn transform_search_tree(&self, tree: Mcts<sts2_mcts::SharedPolicy>, combat: &CombatState)
+        -> Mcts<sts2_mcts::SharedPolicy> {
+        match self.search_transforms.as_ref() {Some(hooks) => (hooks.tree)(tree, combat), None => tree}
     }
 
