diff --git a/sts2-rs/crates/sts2-core/src/witnessed_outcomes.rs b/sts2-rs/crates/sts2-core/src/witnessed_outcomes.rs
new file mode 100644
index 0000000..cc66b1d
--- /dev/null
+++ b/sts2-rs/crates/sts2-core/src/witnessed_outcomes.rs
@@ -0,0 +1,166 @@
+//! Ephemeral public observations of already executed chance effects.
+//! Rule handlers still sample their original RNG before conditioning that result.
+
+use crate::{CombatState, CreatureUid, StepResult};
+
+/// Typed outcomes keep unrelated random effects from consuming each other's evidence.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum ObservedOutcome {
+    HatchHp { owner: CreatureUid, hp: i32 },
+}
+
+/// Replay-only scratch; absent from ordinary worlds, wire state and semantic hashes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReplayObservations {
+    expected: Vec<ObservedOutcome>,
+    consumed: usize,
+    error: Option<&'static str>,
+}
+
+/// Run one witnessed prefix atomically; nested scopes, missing evidence and extra events fail.
+pub fn with_observed_hatch_hp(
+    state: &mut CombatState,
+    expected: &[(CreatureUid, i32)],
+    apply: impl FnOnce(&mut CombatState) -> Result<StepResult, &'static str>,
+) -> Result<StepResult, &'static str> {
+    if state.replay_observations.is_some() {
+        return Err("observed_hatch_hp_nested_scope");
+    }
+    if expected
+        .iter()
+        .enumerate()
+        .any(|(index, (owner, _))| expected[..index].iter().any(|(prior, _)| prior == owner))
+    {
+        return Err("observed_hatch_hp_duplicate_owner");
+    }
+    let before = state.clone();
+    state.replay_observations = Some(Box::new(ReplayObservations {
+        expected: expected
+            .iter()
+            .map(|&(owner, hp)| ObservedOutcome::HatchHp { owner, hp })
+            .collect(),
+        consumed: 0,
+        error: None,
+    }));
+    let result = apply(state);
+    let observations = state.replay_observations.take();
+    let failure = match observations {
+        None => Some("observed_hatch_hp_scope_lost"),
+        Some(observations) => observations.error.or_else(|| {
+            (observations.consumed != observations.expected.len())
+                .then_some("observed_hatch_hp_queue_not_consumed")
+        }),
+    };
+    let result = result.and_then(|step| {
+        if step == StepResult::InvalidTarget {
+            Err("observed_hatch_hp_prefix_invalid_target")
+        } else if let Some(reason) = failure {
+            Err(reason)
+        } else {
+            Ok(step)
+        }
+    });
+    if result.is_err() {
+        *state = before;
+    }
+    result
+}
+
+/// Condition only the original Hatch HP event, after its original RNG read has occurred.
+pub fn condition_hatch_hp(
+    state: &mut CombatState,
+    owner: CreatureUid,
+    minimum: i32,
+    maximum_exclusive: i32,
+    sampled: i32,
+) -> i32 {
+    let Some(observations) = state.replay_observations.as_mut() else {
+        return sampled;
+    };
+    if observations.error.is_some() {
+        return sampled;
+    }
+    let Some(ObservedOutcome::HatchHp {
+        owner: expected_owner,
+        hp,
+    }) = observations.expected.get(observations.consumed)
+    else {
+        observations.error = Some("observed_hatch_hp_unwitnessed_extra_event");
+        return sampled;
+    };
+    if *expected_owner != owner {
+        observations.error = Some("observed_hatch_hp_owner_mismatch");
+        return sampled;
+    }
+    if !(minimum..maximum_exclusive).contains(hp) {
+        observations.error = Some("observed_hatch_hp_outside_positive_support");
+        return sampled;
+    }
+    observations.consumed += 1;
+    *hp
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A replay scope cannot affect semantic identity, nest, or retain scratch after success.
+    #[test]
+    fn hatch_observation_scope_ignores_hashes_and_cleans_up() {
+        let mut state = CombatState::default();
+        let owner = CreatureUid::new(2).unwrap();
+        let hashes = (
+            crate::state_hash(&state),
+            crate::chance_outcome_hash(&state),
+            crate::hashing::tt_hash_v2(&state),
+        );
+        with_observed_hatch_hp(&mut state, &[(owner, 20)], |state| {
+            assert_eq!(
+                hashes,
+                (
+                    crate::state_hash(state),
+                    crate::chance_outcome_hash(state),
+                    crate::hashing::tt_hash_v2(state)
+                )
+            );
+            assert_eq!(
+                with_observed_hatch_hp(state, &[], |_| Ok(StepResult::Advanced)),
+                Err("observed_hatch_hp_nested_scope")
+            );
+            assert_eq!(condition_hatch_hp(state, owner, 19, 22, 21), 20);
+            Ok(StepResult::Advanced)
+        })
+        .unwrap();
+        assert!(state.replay_observations.is_none());
+        assert_eq!(state, CombatState::default());
+    }
+
+    /// Missing events and caller failures restore all state, not merely the observation queue.
+    #[test]
+    fn hatch_observation_scope_rolls_back_missing_events_and_closure_failure() {
+        let owner = CreatureUid::new(2).unwrap();
+        for caller_fails in [false, true] {
+            let mut state = CombatState::default();
+            let before = state.clone();
+            let result = with_observed_hatch_hp(&mut state, &[(owner, 20)], |state| {
+                state.gold = 999;
+                let _ = state.run_rng.niche.next_int_exclusive(19, 22);
+                if caller_fails {
+                    Err("draw_observation_failed")
+                } else {
+                    Ok(StepResult::Advanced)
+                }
+            });
+            assert_eq!(
+                result,
+                Err(if caller_fails {
+                    "draw_observation_failed"
+                } else {
+                    "observed_hatch_hp_queue_not_consumed"
+                })
+            );
+            assert_eq!(state, before);
+            assert!(state.replay_observations.is_none());
+        }
+    }
+}
