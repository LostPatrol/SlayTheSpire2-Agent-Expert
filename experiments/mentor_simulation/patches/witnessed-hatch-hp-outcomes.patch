+/// Owner mismatches, illegal support, missing events and extra evidence cannot commit a prefix.
+#[test]
+fn observed_hatch_hp_rejects_bad_or_incomplete_evidence_atomically() {
+    let (before, draws, eggs) = observed_hatch_fixture();
+    let good: Vec<_> = eggs.iter().copied().zip([19, 20, 21]).collect();
+    let mut wrong_owner = good.clone();
+    wrong_owner.swap(0, 1);
+    let mut unsupported = good.clone();
+    unsupported[0].1 = 22;
+    let mut extra = good.clone();
+    extra.push((before.player.creature_uid.unwrap(), 20));
+    for (evidence, reason) in [
+        (wrong_owner, "observed_hatch_hp_owner_mismatch"),
+        (unsupported, "observed_hatch_hp_outside_positive_support"),
+        (
+            good[..2].to_vec(),
+            "observed_hatch_hp_unwitnessed_extra_event",
+        ),
+        (extra, "observed_hatch_hp_queue_not_consumed"),
+    ] {
+        let mut state = before.clone();
+        assert_eq!(
+            sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut state, &evidence, |state| {
+                sts2_core::draw_knowledge::apply_observed_draws(
+                    state,
+                    sts2_core::Action::EndTurn,
+                    &draws,
+                )
+            }),
+            Err(reason)
+        );
+        assert_eq!(state, before);
+        assert!(state.replay_observations.is_none());
+    }
+    let mut state = before.clone();
+    let mut duplicate = good.clone();
+    duplicate[1].0 = duplicate[0].0;
+    assert_eq!(
+        sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut state, &duplicate, |_| {
+            panic!("duplicate owners must be rejected before executing the prefix")
+        }),
+        Err("observed_hatch_hp_duplicate_owner")
+    );
+    assert_eq!(state, before);
+    let mut wrong_draws = draws.clone();
+    wrong_draws.swap(4, 5);
+    assert_eq!(
+        sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut state, &good, |state| {
+            sts2_core::draw_knowledge::apply_observed_draws(
+                state,
+                sts2_core::Action::EndTurn,
+                &wrong_draws,
+            )
+        }),
+        Err("observed_draw_outside_positive_support")
+    );
+    assert_eq!(state, before);
+}
