+/// Add real HATCH_MOVE listeners to the witnessed Tyranny cross-refill fixture.
+fn observed_hatch_fixture() -> (CombatState, Vec<CardUid>, Vec<sts2_core::CreatureUid>) {
+    let (mut state, draws) = observed_refill_fixture();
+    let mut eggs = Vec::new();
+    for _ in 0..3 {
+        let egg = state.spawn_enemy(MonsterKind::ToughEgg);
+        state.set_creature_ai(
+            egg,
+            sts2_content::monsters::act2_hive::create_tough_egg_ai(),
+        );
+        // Spawn attachment does not publish a move; this fixture starts at the witnessed HATCH telegraph.
+        state
+            .creatures
+            .iter_mut()
+            .find(|c| c.id == egg.0)
+            .unwrap()
+            .intent = Some(sts2_core::Intent::Summon);
+        sts2_core::card_effects::apply_power_to_creature(&mut state, egg, PowerKind::Hatch, 1);
+        sts2_core::card_effects::apply_power_to_creature(&mut state, egg, PowerKind::Minion, 1);
+        eggs.push(egg);
+    }
+    (state, draws, eggs)
+}
