+/// Half-open support of the original Hatch sample, distinct from shell spawn HP.
+pub fn tough_egg_hatch_hp_bounds(ascension: u8, version: sts2_core::GameVersion) -> (i32, i32) {
+    use sts2_core::ascension::{get_value_if_ascension, AscensionLevel::ToughEnemies};
+    let min = get_value_if_ascension(ascension, ToughEnemies, 20, 19);
+    let max = get_value_if_ascension(ascension, ToughEnemies, 23, 22);
+    // ToughEgg.cs:172 changed from NextInt(min,max) to NextInt(min,max+1) in v0.111.0.
+    (min, max + i32::from(version >= sts2_core::GameVersion::V0_111_0))
+}
