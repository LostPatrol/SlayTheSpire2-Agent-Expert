+/// Replay a complete publicly observed draw prefix through the real action and refill pipeline.
+/// Caller must exclude hidden intermediate draws; this is not a general posterior reconstruction.
+/// Only a public materialized prefix is conditioned; current private RNG is restored later by its owner.
+pub fn apply_observed_draws(
+    state: &mut crate::CombatState,
+    action: crate::Action,
+    expected: &[CardUid],
+) -> Result<crate::StepResult, &'static str> {
+    if state.player.deferred_draw_order {
+        return Err("observed_draw_replay_requires_materialized_public_prefix");
+    }
+    if state
+        .player
+        .draw_knowledge
+        .as_ref()
+        .is_some_and(|k| k.observed_draws.is_some())
+    {
+        return Err("observed_draw_replay_already_active");
+    }
+    if let Some(reason) = unsupported_reason(&state.player) {
+        return Err(reason);
+    }
+    let before = state.clone();
+    knowledge_mut(&mut state.player).observed_draws = Some(Box::new(ObservedDraws {
+        expected: expected.to_vec(),
+        ..ObservedDraws::default()
+    }));
+    let result = crate::apply(state, action);
+    normalize(&mut state.player);
+    let witness = state
+        .player
+        .draw_knowledge
+        .as_mut()
+        .and_then(|k| k.observed_draws.take());
+    let error = witness
+        .as_ref()
+        .and_then(|w| w.error)
+        .or_else(|| unsupported_reason(&state.player))
+        .or_else(|| {
+            witness
+                .as_ref()
+                .is_none_or(|w| w.consumed != w.expected.len())
+                .then_some("observed_draw_replay_queue_not_consumed")
+        });
+    if let Some(reason) = error {
+        *state = before;
+        return Err(reason);
+    }
+    // A temporary observation must not leave an empty allocation on an ordinary search path.
+    if before.player.draw_knowledge.is_none()
+        && !state
+            .cards
+            .iter()
+            .any(|c| c.has_enchantment(EnchantmentId::PerfectFit))
+        && state.player.draw_knowledge.as_ref().is_some_and(|k| {
+            k.groups.is_empty() && k.inserted.is_empty() && k.discard_groups.is_empty()
+        })
+    {
+        state.player.draw_knowledge = None;
+    }
+    Ok(result)
+}
