+/// Build a small real Tyranny turn: four old draw cards, then PF plus an ordinary refill draw.
+fn observed_refill_fixture() -> (CombatState, Vec<CardUid>) {
+    let mut state = fixture();
+    state.player.character = Some(CharacterId::Regent);
+    let mut add = |id, upgraded| {
+        let mut card = sts2_content::cards::spec_index::card_pod_from_id(id, upgraded).unwrap();
+        let uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+        card.uid = uid;
+        state.cards.push(card);
+        uid
+    };
+    let old_hand = add(CardId::Venerate, false);
+    let old_draw = [
+        add(CardId::SovereignBlade, false),
+        add(CardId::FallingStar, false),
+        add(CardId::RefineBlade, true),
+        add(CardId::Bulwark, true),
+    ];
+    let photon = add(CardId::PhotonCut, true);
+    let ordinary = add(CardId::DefendRegent, false);
+    let other = add(CardId::Glow, true);
+    state.cards[photon.get() as usize - 1]
+        .set_enchantment(sts2_core::cards::EnchantmentId::PerfectFit, 1);
+    state.player.hand.push(old_hand);
+    state.player.draw.extend(old_draw.iter().rev().copied());
+    state.player.discard.extend([photon, ordinary, other]);
+    sts2_core::draw_knowledge::set_root_knowledge(
+        &mut state.player,
+        vec![old_draw.to_vec()],
+        vec![],
+        vec![vec![photon]],
+    )
+    .unwrap();
+    let player = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Tyranny, 1);
+    let expected = old_draw.into_iter().chain([photon, ordinary]).collect();
+    (state, expected)
+}
+
+/// Observed draw conditioning crosses the original refill and keeps its native RNG advances.
+#[test]
+fn observed_draw_replay_crosses_refill_and_preserves_rng_work() {
+    let (mut state, expected) = observed_refill_fixture();
+    let mut unconditioned = state.clone();
+    let _ = sts2_core::apply(&mut unconditioned, sts2_core::Action::EndTurn);
+    sts2_core::draw_knowledge::apply_observed_draws(
+        &mut state,
+        sts2_core::Action::EndTurn,
+        &expected,
+    )
+    .unwrap();
+    assert_eq!(state.player.hand.as_slice(), expected.as_slice());
+    assert!(state.pending_choice.is_some());
+    assert!(state.player.discard.is_empty());
+    assert_eq!(state.player.draw.len(), 2);
+    assert_eq!(
+        state.run_rng.shuffle.counter(),
+        unconditioned.run_rng.shuffle.counter()
+    );
+    assert_eq!(
+        state.run_rng.combat_counter_fingerprint(),
+        unconditioned.run_rng.combat_counter_fingerprint()
+    );
+    assert!(state
+        .player
+        .draw_knowledge
+        .as_ref()
+        .unwrap()
+        .observed_draws
+        .is_none());
+}
+
+/// Wrong PF support and incomplete/extra evidence cannot commit any guessed prefix state.
+#[test]
+fn observed_draw_replay_rejects_bad_support_and_queue_lengths_atomically() {
+    let (before, expected) = observed_refill_fixture();
+    let mut bad_pf = expected.clone();
+    bad_pf.swap(4, 5);
+    let mut extra = expected.clone();
+    extra.push(before.player.hand[0]);
+    for (evidence, reason) in [
+        (bad_pf, "observed_draw_outside_positive_support"),
+        (
+            expected[..5].to_vec(),
+            "observed_draw_replay_unwitnessed_extra_draw",
+        ),
+        (extra, "observed_draw_replay_queue_not_consumed"),
+    ] {
+        let mut state = before.clone();
+        assert_eq!(
+            sts2_core::draw_knowledge::apply_observed_draws(
+                &mut state,
+                sts2_core::Action::EndTurn,
+                &evidence
+            ),
+            Err(reason)
+        );
+        assert_eq!(state, before);
+        assert!(state
+            .player
+            .draw_knowledge
+            .as_ref()
+            .unwrap()
+            .observed_draws
+            .is_none());
+    }
+}
