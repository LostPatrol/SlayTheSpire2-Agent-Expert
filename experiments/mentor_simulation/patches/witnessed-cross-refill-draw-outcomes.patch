+/// A no-draw observation leaves ordinary state/RNG unchanged and no recorder scratch behind.
+#[test]
+fn observed_draw_replay_cleans_an_ordinary_world_and_rejects_deferred_mode() {
+    sts2_content::potions::dispatch::ensure_installed();
+    let mut state = fixture();
+    state
+        .player
+        .potions
+        .push(sts2_core::potions::PotionKind::BlockPotion);
+    let action = sts2_core::Action::DrinkPotion {
+        potion_slot: 0,
+        target: None,
+    };
+    let mut raw = state.clone();
+    let _ = sts2_core::apply(&mut raw, action.clone());
+    sts2_core::draw_knowledge::apply_observed_draws(&mut state, action.clone(), &[]).unwrap();
+    assert_eq!(state, raw);
+    assert!(state.player.draw_knowledge.is_none());
+    state.player.deferred_draw_order = true;
+    let before = state.clone();
+    assert_eq!(
+        sts2_core::draw_knowledge::apply_observed_draws(&mut state, action, &[]),
+        Err("observed_draw_replay_requires_materialized_public_prefix")
+    );
+    assert_eq!(state, before);
+}
