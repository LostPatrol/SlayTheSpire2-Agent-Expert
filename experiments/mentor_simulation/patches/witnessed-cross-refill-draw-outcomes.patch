+/// Consume an observed top only when it has positive support in the current public draw law.
+pub(crate) fn pop_observed_next(player: &mut PlayerCombatState) -> Option<CardUid> {
+    let witness = player.draw_knowledge.as_ref()?.observed_draws.as_ref()?;
+    if witness.error.is_some() {
+        return None;
+    }
+    let next = witness.expected.get(witness.consumed).copied();
+    normalize(player);
+    let error = unsupported_reason(player)
+        .or_else(|| {
+            next.is_none()
+                .then_some("observed_draw_replay_unwitnessed_extra_draw")
+        })
+        .or_else(|| {
+            next.filter(|uid| !possible_next(player).contains(uid))
+                .map(|_| "observed_draw_outside_positive_support")
+        });
+    if let Some(reason) = error {
+        player
+            .draw_knowledge
+            .as_mut()?
+            .observed_draws
+            .as_mut()?
+            .error = Some(reason);
+        return None;
+    }
+    let uid = next?;
+    let index = player.draw.iter().position(|candidate| *candidate == uid)?;
+    player
+        .draw_knowledge
+        .as_mut()?
+        .observed_draws
+        .as_mut()?
+        .consumed += 1;
+    // This is a top observation, not a directed removal at an unknown non-top position.
+    consumed_top(player, uid);
+    player.pinned_top.retain(|pin| *pin != uid);
+    player.pinned_bottom.retain(|pin| *pin != uid);
+    Some(player.draw.remove(index))
 }
 
