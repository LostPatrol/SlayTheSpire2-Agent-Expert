+/// Include the pet once, outside co-op seat passes, unless an existing owner walk already has it.
+fn pet_listener_uid(state: &CombatState) -> Option<CreatureUid> {
+    state.player.pet_uid.filter(|uid| {
+        !state.coop.seat_pass
+            && Some(*uid) != state.player.creature_uid
+            && !state.enemy_uids.contains(uid)
+    })
 }
 
