     }
+
+    /// A live unresolved block keeps its token; identical gains are not deduplicated.
+    #[test]
+    fn public_history_pending_block_join_and_duplicate_gains_are_explicit() {
+        let mut state = crate::CombatState::default();
+        let uid = CardUid::new(1).unwrap();
+        state.cards.push(crate::cards::Card {
+            uid,
+            card_id: CardId::DefendIronclad,
+            card_type: CardType::Skill,
+            ..crate::cards::Card::pod_defaults()
+        });
+        state
+            .combat_log
+            .event_log
+            .set_public_history_recording(true);
+        assert!(
+            !state
+                .combat_log
+                .event_log
+                .public_history()
+                .unwrap()
+                .complete,
+            "late enable is incomplete"
+        );
+        state.combat_log.event_log.begin_public_history();
+        begin_public_play(&mut state, uid, false, true);
+        record_public_card_block(&mut state, None, 7);
+        record_public_card_block(&mut state, Some(uid), 5);
+        record_public_card_block(&mut state, Some(uid), 5);
+        assert!(!state
+            .combat_log
+            .event_log
+            .public_history()
+            .unwrap()
+            .blocks_complete());
+        finish_public_play(&mut state, uid, false);
+        let history = state.combat_log.event_log.public_history().unwrap();
+        assert!(history.complete && history.blocks_complete());
+        assert_eq!(history.blocks.len(), 2);
+        assert_eq!(history.blocks[0].play_token, history.plays[0].token);
+        assert_eq!(history.blocks[1].play_token, history.plays[0].token);
+        state.combat_log.event_log.disarm_for_search();
+        assert!(state.combat_log.event_log.public_history().is_none());
+        assert!(!state.combat_log.event_log.recording());
+    }
+
+    /// A refused trace row never leaves a public-history export claiming completeness.
+    #[test]
+    fn public_history_row_overflow_is_incomplete() {
+        let mut log = EventLog::default();
+        log.begin_public_history();
+        for _ in 0..=MAX_ROWS {
+            log.push(
+                1,
+                Side::Player,
+                EventLogEntry::EnergySpent { amount: 1 },
+                None,
+            );
+        }
+        assert_eq!(log.dropped(), 1);
+        assert!(!log.public_history().unwrap().complete);
+    }
 }
