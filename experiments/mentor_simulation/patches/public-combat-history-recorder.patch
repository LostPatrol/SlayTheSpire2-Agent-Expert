+/// Observe one real play iteration; replay trace rows open their own nested source frame.
+pub(crate) fn begin_public_play(
+    state: &mut crate::CombatState,
+    uid: CardUid,
+    auto: bool,
+    first: bool,
+) {
+    if !armed(state) {
+        return;
+    }
+    let Some(card) = state.cards.get(uid.get() as usize - 1) else {
+        if let Some(history) = state.combat_log.event_log.public_history.as_mut() {
+            history.complete = false;
+        }
+        return;
+    };
+    let (id, kind, upgraded, energy) = (
+        card.card_id,
+        card.card_type,
+        card.upgraded,
+        crate::cards::observational_energy_spent(card),
+    );
+    if let Some(history) = state.combat_log.event_log.public_history.as_mut() {
+        let token = history.next_token;
+        history.next_token += 1;
+        history.active.push(PublicCompletedPlay {
+            token,
+            card_uid: uid,
+            card_id: id,
+            card_type: kind,
+            auto_played: auto,
+            first_in_series: first,
+            round: state.round,
+            side: state.side,
+        });
+    }
+    if !first {
+        record(
+            state,
+            EventLogEntry::CardPlayStarted {
+                card: id,
+                upgraded,
+                energy_spent: energy,
+                auto_played: auto,
+                target: None,
+            },
+        );
+    }
+}
+
+/// Observe actual completion at the same pin as the engine's completed-play update.
+pub(crate) fn finish_public_play(state: &mut crate::CombatState, uid: CardUid, replay: bool) {
+    if !armed(state) {
+        return;
+    }
+    let card = state
+        .cards
+        .get(uid.get() as usize - 1)
+        .map(|c| (c.card_id, c.card_type, c.upgraded));
+    if let Some(history) = state.combat_log.event_log.public_history.as_mut() {
+        if let Some(index) = history.active.iter().rposition(|play| play.card_uid == uid) {
+            let mut play = history.active.remove(index);
+            play.round = state.round;
+            play.side = state.side;
+            if let Some((id, kind, _)) = card {
+                play.card_id = id;
+                play.card_type = kind;
+            } else {
+                history.complete = false;
+            }
+            history.plays.push(play);
+        } else {
+            history.complete = false;
+        }
+    }
+    if replay {
+        if let Some((card, _, upgraded)) = card {
+            record(state, EventLogEntry::CardPlayFinished { card, upgraded });
+        }
+    }
+}
+
+/// Attribute only actual positive card-sourced block, not relic/power grants during a play.
+pub(crate) fn record_public_card_block(
+    state: &mut crate::CombatState,
+    source: Option<CardUid>,
+    amount: i32,
+) {
+    let Some(uid) = source.filter(|_| amount > 0) else {
+        return;
+    };
+    let Some(history) = state.combat_log.event_log.public_history.as_mut() else {
+        return;
+    };
+    let play = history
+        .active
+        .iter()
+        .rev()
+        .find(|play| play.card_uid == uid)
+        .or_else(|| history.plays.iter().rev().find(|play| play.card_uid == uid));
+    if let Some(play) = play {
+        history.blocks.push(PublicCardBlock {
+            play_token: play.token,
+            amount,
+            round: state.round,
+            side: state.side,
+        });
+    } else {
+        history.complete = false;
+    }
+}
