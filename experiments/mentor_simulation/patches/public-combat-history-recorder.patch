+/// Public completion metadata; UID joins the current visible instance without exposing hidden order.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PublicCompletedPlay {
+    pub token: u64,
+    pub card_uid: CardUid,
+    pub card_id: CardId,
+    pub card_type: CardType,
+    pub auto_played: bool,
+    pub first_in_series: bool,
+    pub round: u16,
+    pub side: Side,
+}
+
+/// A positive card-sourced player block gain, joined to completion by its iteration token.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PublicCardBlock {
+    pub play_token: u64,
+    pub amount: i32,
+    pub round: u16,
+    pub side: Side,
+}
+
+/// Opt-in public events from combat birth; unfinished token joins remain explicitly incomplete.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct PublicHistory {
+    pub complete: bool,
+    pub plays: Vec<PublicCompletedPlay>,
+    pub blocks: Vec<PublicCardBlock>,
+    active: Vec<PublicCompletedPlay>,
+    next_token: u64,
+}
+
+impl PublicHistory {
+    /// Every exported block must refer to an actually completed iteration.
+    pub fn blocks_complete(&self) -> bool {
+        self.complete
+            && self
+                .blocks
+                .iter()
+                .all(|block| self.plays.iter().any(|play| play.token == block.play_token))
+    }
+}
