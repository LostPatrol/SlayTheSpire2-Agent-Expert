+//! Public combat-history recording through real card dispatch and the content factory.
+//! Recording is diagnostic only; metadata uses completed iteration tokens, not rule counters.
+
+use sts2_content::{cards::dispatch, monster_dispatch::MonsterSpawnArgs};
+use sts2_core::cards::{Card, CardId, CardType, TargetType};
+use sts2_core::potions::CharacterId;
+use sts2_core::runstate::{RoomType, RunState};
+use sts2_core::{CardUid, CombatState, MonsterKind, PowerKind};
+
+/// Build the same combat with recording on or off before its initial hooks and hand draw.
+fn factory(record: bool) -> CombatState {
+    dispatch::ensure_installed();
+    let mut run = RunState {
+        character_id: CharacterId::Ironclad,
+        current_hp: 80,
+        max_hp: 80,
+        record_public_combat_history: record,
+        ..RunState::default()
+    };
+    sts2_content::run_callbacks::populate_starter_deck(&mut run, CharacterId::Ironclad);
+    sts2_content::run_bridge::enter_combat_from_roster(
+        &run,
+        &[(MonsterKind::Nibbit, MonsterSpawnArgs::None, 9999)],
+        RoomType::Monster,
+    )
+}
+
+/// Keep a live opponent while controlling the actual played and auto-played instances.
+fn fixture() -> CombatState {
+    let mut state = factory(true);
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.discard.clear();
+    state.player.energy = 20;
+    state
+}
+
+/// Add one real skill instance, with replay metadata consumed by the original dispatcher.
+fn skill(state: &mut CombatState, id: CardId, replay: i32) -> CardUid {
+    let uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    state.cards.push(Card {
+        uid,
+        card_id: id,
+        cost: 0,
+        card_type: CardType::Skill,
+        target_type: TargetType::Self_,
+        base_block: 5,
+        base_replay_count: replay,
+        ..Card::pod_defaults()
+    });
+    uid
+}
+
+/// Opt-in is visible from the initial draw, and cannot change game state or RNG.
+#[test]
+fn public_history_factory_records_from_birth_without_changing_the_world() {
+    let plain = factory(false);
+    let recorded = factory(true);
+    assert_eq!(plain, recorded);
+    assert!(plain.combat_log.event_log.public_history().is_none());
+    let history = recorded.combat_log.event_log.public_history().unwrap();
+    assert!(history.complete && history.blocks_complete());
+    assert!(recorded
+        .combat_log
+        .event_log
+        .rows()
+        .iter()
+        .any(|row| matches!(
+            row.entry,
+            sts2_core::event_log::EventLogEntry::CardDrawn { .. }
+        )));
+}
+
+/// Initial turn-start auto-plays are captured before the first externally chosen action.
+#[test]
+fn public_history_initial_turn_auto_play_is_not_lost() {
+    let mut state = fixture();
+    for _ in 0..6 {
+        let uid = skill(&mut state, CardId::DefendIronclad, 0);
+        state.player.draw.push(uid);
+    }
+    let player = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Mayhem, 1);
+    state.phase = sts2_core::CombatPhase::Setup;
+    let _ = sts2_core::combat_loop::start_combat(&mut state);
+    let _ = sts2_core::combat_loop::start_player_turn(&mut state);
+    let history = state.combat_log.event_log.public_history().unwrap();
+    assert!(history.complete && history.blocks_complete());
+    assert!(history
+        .plays
+        .iter()
+        .any(|play| play.auto_played && play.first_in_series));
+}
+
+/// Base and Echo replays have separate finished entries and separate block iteration tokens.
+#[test]
+fn public_history_manual_base_and_echo_replays_have_independent_finished_tokens() {
+    let mut state = fixture();
+    let player = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::EchoForm, 1);
+    let uid = skill(&mut state, CardId::DefendIronclad, 1);
+    state.player.hand.push(uid);
+    let _ = sts2_core::combat_loop::play_card(&mut state, 0, None);
+    let history = state.combat_log.event_log.public_history().unwrap();
+    assert!(history.complete && history.blocks_complete());
+    assert_eq!(history.plays.len(), 3);
+    assert_eq!(history.blocks.len(), 3);
+    assert_eq!(
+        history
+            .plays
+            .iter()
+            .map(|p| p.first_in_series)
+            .collect::<Vec<_>>(),
+        vec![true, false, false]
+    );
+    for (play, block) in history.plays.iter().zip(&history.blocks) {
+        assert!(!play.auto_played);
+        assert_eq!(play.card_uid, uid);
+        assert_eq!(play.token, block.play_token);
+        assert_eq!(block.amount, 5);
+    }
+    assert_eq!(
+        state
+            .combat_log
+            .event_log
+            .rows()
+            .iter()
+            .filter(|row| matches!(
+                row.entry,
+                sts2_core::event_log::EventLogEntry::CardPlayFinished { .. }
+            ))
+            .count(),
+        3
+    );
+}
+
+/// Havoc finishes after its child; FeelNoPain's unpowered block is never card-attributed.
+#[test]
+fn public_history_nested_havoc_and_auto_replay_preserve_completion_order_and_block_props() {
+    let mut state = fixture();
+    let player = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::FeelNoPain, 3);
+    let parent = skill(&mut state, CardId::Havoc, 0);
+    let child = skill(&mut state, CardId::DefendIronclad, 1);
+    state.player.hand.push(parent);
+    state.player.draw.push(child);
+    let _ = sts2_core::combat_loop::play_card(&mut state, 0, None);
+    let history = state.combat_log.event_log.public_history().unwrap();
+    assert!(history.complete && history.blocks_complete());
+    assert_eq!(
+        history.plays.iter().map(|p| p.card_uid).collect::<Vec<_>>(),
+        vec![child, child, parent]
+    );
+    assert_eq!(
+        history
+            .plays
+            .iter()
+            .map(|p| p.auto_played)
+            .collect::<Vec<_>>(),
+        vec![true, true, false]
+    );
+    assert_eq!(
+        history
+            .plays
+            .iter()
+            .map(|p| p.first_in_series)
+            .collect::<Vec<_>>(),
+        vec![true, false, true]
+    );
+    assert_eq!(history.blocks.len(), 2);
+    assert_eq!(state.player.block, 13);
+    assert_eq!(history.blocks[0].play_token, history.plays[0].token);
+    assert_eq!(history.blocks[1].play_token, history.plays[1].token);
+}
