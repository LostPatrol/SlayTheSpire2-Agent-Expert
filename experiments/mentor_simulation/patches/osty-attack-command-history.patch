+
+/// Execute one Osty AttackCommand with multiple damage results; each command counts once.
+pub fn deal_damage_from_osty_to_enemy_with_hits(
+    state: &mut CombatState,
+    target_uid: CreatureUid,
+    base: i32,
+    hits: i32,
+) -> i32 {
     let card = originating_card_id(state);
-    damage::apply_damage(state, dealer, target_uid, base, ValueProps::MOVE, card)
+    let mut total = 0_i32;
+    let mut executed = false;
+    for _ in 0..hits.max(0) {
+        let Some(dealer) = osty_dealer_ref(state) else {
+            break;
+        };
+        if !state.creatures.iter().any(|c| c.id == target_uid.0 && c.current_hp > 0) {
+            break;
+        }
+        executed = true;
+        total = total.saturating_add(damage::apply_damage(
+            state, dealer, target_uid, base, ValueProps::MOVE, card,
+        ));
+    }
+    if executed {
+        // Fully blocked results still belong to the completed CreatureAttackedEntry.
+        state.combat_log.osty_attacks_this_turn =
+            state.combat_log.osty_attacks_this_turn.saturating_add(1);
+    }
+    total
 }
 
