diff --git a/sts2-rs/crates/sts2-content/tests/osty_attack_commands.rs b/sts2-rs/crates/sts2-content/tests/osty_attack_commands.rs
new file mode 100644
index 0000000..47a05d8
--- /dev/null
+++ b/sts2-rs/crates/sts2-content/tests/osty_attack_commands.rs
@@ -0,0 +1,212 @@
+//! Osty AttackCommand counts are distinct from per-target powered DamageResults.
+//! Real Rattle replays exercise the same command boundary as single-hit and AoE callers.
+
+use sts2_content::monster_dispatch::MonsterSpawnArgs;
+use sts2_core::cards::{CardId, PileKind};
+use sts2_core::potions::CharacterId;
+use sts2_core::runstate::{RoomType, RunState};
+use sts2_core::{Action, CardUid, CombatState, CreatureUid, MonsterKind, PowerKind};
+
+/// Keep one durable opponent and a live Osty while removing incidental starter cards.
+fn fixture() -> CombatState {
+    sts2_content::cards::dispatch::ensure_installed();
+    let mut run = RunState {
+        character_id: CharacterId::Necrobinder,
+        current_hp: 80,
+        max_hp: 80,
+        ..RunState::default()
+    };
+    sts2_content::run_callbacks::populate_starter_deck(&mut run, CharacterId::Necrobinder);
+    let mut state = sts2_content::run_bridge::enter_combat_from_roster(
+        &run,
+        &[(MonsterKind::Nibbit, MonsterSpawnArgs::None, 9999)],
+        RoomType::Monster,
+    );
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.discard.clear();
+    state.player.energy = 20;
+    state.restore_osty(20, 20, 0);
+    state
+}
+
+/// Add a real card instance without simulating its play or attacks.
+fn card(state: &mut CombatState, id: CardId, pile: PileKind) -> CardUid {
+    let mut card = sts2_content::cards::spec_index::card_pod_from_id(id, false).unwrap();
+    card.uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    let uid = card.uid;
+    state.cards.push(card);
+    match pile {
+        PileKind::Hand => state.player.hand.push(uid),
+        PileKind::Draw => state.player.draw.push(uid),
+        _ => panic!("fixture supports Hand and Draw only"),
+    }
+    uid
+}
+
+/// Return the independently retained GangUp hit count for this target.
+fn hits(state: &CombatState, target: CreatureUid) -> u32 {
+    state
+        .combat_log
+        .osty_powered_hits_by_target_this_turn
+        .iter()
+        .find(|(uid, _)| *uid == target)
+        .map_or(0, |(_, n)| *n)
+}
+
+/// Native Bodyguard then two Rattles gives commands 0/1/2 and powered results 0/1/3.
+#[test]
+fn osty_commands_rattle_counts_once_per_command_not_each_hit() {
+    let mut state = fixture();
+    let target = state.enemy_uids[0];
+    for id in [
+        CardId::Bodyguard,
+        CardId::Rattle,
+        CardId::Rattle,
+        CardId::Rattle,
+    ] {
+        card(&mut state, id, PileKind::Hand);
+    }
+    sts2_core::apply(
+        &mut state,
+        Action::PlayCard {
+            hand_index: 0,
+            target: None,
+        },
+    );
+    assert_eq!(
+        (
+            state.combat_log.osty_attacks_this_turn,
+            hits(&state, target)
+        ),
+        (0, 0)
+    );
+    for (commands, results, damage) in [(1, 1, 7), (2, 3, 14), (3, 6, 21)] {
+        let hp = state
+            .creatures
+            .iter()
+            .find(|c| c.id == target.0)
+            .unwrap()
+            .current_hp;
+        sts2_core::apply(
+            &mut state,
+            Action::PlayCard {
+                hand_index: 0,
+                target: Some(0),
+            },
+        );
+        assert_eq!(
+            (
+                state.combat_log.osty_attacks_this_turn,
+                hits(&state, target)
+            ),
+            (commands, results)
+        );
+        assert_eq!(
+            hp - state
+                .creatures
+                .iter()
+                .find(|c| c.id == target.0)
+                .unwrap()
+                .current_hp,
+            damage
+        );
+    }
+}
+
+/// Fully blocked AoE remains one command, with one powered result per target; a missing pet cannot attack.
+#[test]
+fn osty_commands_aoe_and_missing_pet_keep_distinct_counts() {
+    let mut state = fixture();
+    let second = state.spawn_enemy(MonsterKind::Nibbit);
+    for enemy in state.enemy_uids.clone() {
+        state
+            .creatures
+            .iter_mut()
+            .find(|c| c.id == enemy.0)
+            .unwrap()
+            .block = 100;
+    }
+    assert_eq!(
+        sts2_core::card_effects::deal_damage_from_osty_to_all_alive_enemies(&mut state, 7),
+        0
+    );
+    assert_eq!(state.combat_log.osty_attacks_this_turn, 1);
+    assert_eq!(hits(&state, state.enemy_uids[0]), 1);
+    assert_eq!(hits(&state, second), 1);
+    state.kill_osty();
+    let target = state.enemy_uids[0];
+    assert_eq!(
+        sts2_core::card_effects::deal_damage_from_osty_to_enemy(&mut state, target, 7),
+        0
+    );
+    assert_eq!(
+        sts2_core::card_effects::deal_damage_from_osty_to_all_alive_enemies(&mut state, 7),
+        0
+    );
+    assert_eq!(state.combat_log.osty_attacks_this_turn, 1);
+}
+
+/// Multiple commands from the same card stay distinct; one multi-hit command stays singular.
+#[test]
+fn osty_commands_do_not_deduplicate_by_card_identity() {
+    let mut state = fixture();
+    let target = state.enemy_uids[0];
+    let source = card(&mut state, CardId::Rattle, PileKind::Hand);
+    state.player.hand.clear();
+    state.player.play.push(source);
+    sts2_core::card_effects::deal_damage_from_osty_to_enemy_with_hits(&mut state, target, 7, 2);
+    assert_eq!(
+        (
+            state.combat_log.osty_attacks_this_turn,
+            hits(&state, target)
+        ),
+        (1, 2)
+    );
+    sts2_core::card_effects::deal_damage_from_osty_to_enemy(&mut state, target, 7);
+    assert_eq!(
+        (
+            state.combat_log.osty_attacks_this_turn,
+            hits(&state, target)
+        ),
+        (2, 3)
+    );
+}
+
+/// Echo and automatic replay iterations each execute a new command through the original card handler.
+#[test]
+fn osty_commands_echo_and_automatic_replays_are_new_commands() {
+    for automatic in [false, true] {
+        let mut state = fixture();
+        let target = state.enemy_uids[0];
+        if automatic {
+            card(&mut state, CardId::Havoc, PileKind::Hand);
+            let rattle = card(&mut state, CardId::Rattle, PileKind::Draw);
+            state.cards[rattle.get() as usize - 1].base_replay_count = 1;
+        } else {
+            let owner = state.player.creature_uid.unwrap();
+            sts2_core::card_effects::apply_power_to_creature(
+                &mut state,
+                owner,
+                PowerKind::EchoForm,
+                1,
+            );
+            card(&mut state, CardId::Rattle, PileKind::Hand);
+        }
+        sts2_core::apply(
+            &mut state,
+            Action::PlayCard {
+                hand_index: 0,
+                target: if automatic { None } else { Some(0) },
+            },
+        );
+        assert_eq!(
+            (
+                state.combat_log.osty_attacks_this_turn,
+                hits(&state, target)
+            ),
+            (2, 3),
+            "automatic={automatic}"
+        );
+    }
+}
