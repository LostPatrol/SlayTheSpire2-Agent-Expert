+//! Past random-orb observations through real Boost Away, Echo Form and Trash to Treasure.
+//! The original channel and overflow-evoke effects remain responsible for all state changes.
+
+use sts2_content::{cards::dispatch, monster_dispatch::MonsterSpawnArgs};
+use sts2_core::cards::CardId;
+use sts2_core::orbs::{Orb, OrbKind, OrbSlots};
+use sts2_core::potions::CharacterId;
+use sts2_core::runstate::{RoomType, RunState};
+use sts2_core::{Action, CardUid, CombatState, MonsterKind, PowerKind};
+
+/// Build the actual two-generation card chain with six full slots and one live target.
+fn fixture() -> CombatState {
+    dispatch::ensure_installed();
+    let mut run = RunState {
+        character_id: CharacterId::Defect,
+        current_hp: 80,
+        max_hp: 80,
+        ..RunState::default()
+    };
+    sts2_content::run_callbacks::populate_starter_deck(&mut run, CharacterId::Defect);
+    let mut state = sts2_content::run_bridge::enter_combat_from_roster(
+        &run,
+        &[(MonsterKind::Nibbit, MonsterSpawnArgs::None, 64)],
+        RoomType::Monster,
+    );
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.discard.clear();
+    let mut card =
+        sts2_content::cards::spec_index::card_pod_from_id(CardId::BoostAway, false).unwrap();
+    card.uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    state.player.hand.push(card.uid);
+    state.cards.push(card);
+    state.player.orbs = OrbSlots::with_capacity(6);
+    state.player.orbs.slots = [
+        Orb::lightning(),
+        Orb::lightning(),
+        Orb::glass(),
+        Orb::glass(),
+        Orb::glass(),
+        Orb::lightning(),
+    ]
+    .into_iter()
+    .collect();
+    let owner = state.player.creature_uid.unwrap();
+    for (kind, amount) in [
+        (PowerKind::Focus, 1),
+        (PowerKind::EchoForm, 1),
+        (PowerKind::TrashToTreasure, 1),
+    ] {
+        sts2_core::card_effects::apply_power_to_creature(&mut state, owner, kind, amount);
+    }
+    let enemy = state.enemy_uids[0];
+    let creature = state
+        .creatures
+        .iter_mut()
+        .find(|c| c.id == enemy.0)
+        .unwrap();
+    creature.block = 6;
+    creature.current_hp = 64;
+    creature.max_hp = 64;
+    state
+}
+
+/// Each generation consumes one original roll and keeps the real FIFO evoke damage and fresh payloads.
+#[test]
+fn observed_random_orbs_drive_original_boost_echo_generation_and_overflow() {
+    let mut state = fixture();
+    let before = state.clone();
+    sts2_core::witnessed_outcomes::with_observed_random_orbs(
+        &mut state,
+        &[OrbKind::Plasma, OrbKind::Glass],
+        |state| {
+            Ok(sts2_core::apply(
+                state,
+                Action::PlayCard {
+                    hand_index: 0,
+                    target: None,
+                },
+            ))
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        state.run_rng.combat_orbs.counter() - before.run_rng.combat_orbs.counter(),
+        2
+    );
+    assert_eq!(
+        state.player.orbs.slots.as_slice(),
+        &[
+            Orb::glass(),
+            Orb::glass(),
+            Orb::glass(),
+            Orb::lightning(),
+            Orb::plasma(),
+            Orb::glass()
+        ]
+    );
+    let enemy = state
+        .creatures
+        .iter()
+        .find(|c| c.id == state.enemy_uids[0].0)
+        .unwrap();
+    assert_eq!(
+        (enemy.current_hp, enemy.block),
+        (52, 0),
+        "two original Lightning evokes deal 18 through six block"
+    );
+    assert_eq!(
+        state
+            .player
+            .discard
+            .iter()
+            .filter(|uid| state.cards[uid.get() as usize - 1].card_id == CardId::Dazed)
+            .count(),
+        2
+    );
+    assert_eq!(
+        state.combat_log.player_card_plays_this_combat
+            - before.combat_log.player_card_plays_this_combat,
+        2
+    );
+    assert!(state.replay_observations.is_none());
+}
+
+/// Empty, extra and incomplete evidence restore belt, generated cards, damage and every RNG cursor.
+#[test]
+fn observed_random_orbs_reject_bad_or_incomplete_evidence_atomically() {
+    for (evidence, reason) in [
+        (
+            vec![OrbKind::Empty, OrbKind::Glass],
+            "observed_random_orb_outside_positive_support",
+        ),
+        (
+            vec![OrbKind::Plasma],
+            "observed_random_orb_unwitnessed_extra_event",
+        ),
+        (
+            vec![OrbKind::Plasma, OrbKind::Glass, OrbKind::Frost],
+            "observed_random_orb_queue_not_consumed",
+        ),
+    ] {
+        let mut state = fixture();
+        let before = state.clone();
+        assert_eq!(
+            sts2_core::witnessed_outcomes::with_observed_random_orbs(
+                &mut state,
+                &evidence,
+                |state| {
+                    Ok(sts2_core::apply(
+                        state,
+                        Action::PlayCard {
+                            hand_index: 0,
+                            target: None,
+                        },
+                    ))
+                }
+            ),
+            Err(reason)
+        );
+        assert_eq!(state, before);
+        assert!(state.replay_observations.is_none());
+    }
+}
+
+/// Conditioning on the original rolls is exactly the unarmed world, including RNG and all five kinds.
+#[test]
+fn observed_random_orbs_preserve_unarmed_sampling_and_original_support() {
+    let before = fixture();
+    let mut stream = before.run_rng.combat_orbs.clone();
+    let natural: Vec<_> = (0..2)
+        .map(|_| sts2_core::orbs::RANDOM_COMBAT_ORB_KINDS[stream.next_int_exclusive(0, 5) as usize])
+        .collect();
+    let mut raw = before.clone();
+    let _ = sts2_core::apply(
+        &mut raw,
+        Action::PlayCard {
+            hand_index: 0,
+            target: None,
+        },
+    );
+    let mut observed = before.clone();
+    sts2_core::witnessed_outcomes::with_observed_random_orbs(&mut observed, &natural, |state| {
+        Ok(sts2_core::apply(
+            state,
+            Action::PlayCard {
+                hand_index: 0,
+                target: None,
+            },
+        ))
+    })
+    .unwrap();
+    assert_eq!(observed, raw);
+    for kind in sts2_core::orbs::RANDOM_COMBAT_ORB_KINDS {
+        let mut state = before.clone();
+        sts2_core::witnessed_outcomes::with_observed_random_orbs(
+            &mut state,
+            &[kind, kind],
+            |state| {
+                Ok(sts2_core::apply(
+                    state,
+                    Action::PlayCard {
+                        hand_index: 0,
+                        target: None,
+                    },
+                ))
+            },
+        )
+        .unwrap();
+        assert_eq!(OrbKind::of(state.player.orbs.slots.last().unwrap()), kind);
+    }
+}
