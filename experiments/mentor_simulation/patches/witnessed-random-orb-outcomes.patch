+/// Condition only the original random-orb kind draw, after its original RNG read.
+pub fn condition_random_orb_kind(
+    state: &mut CombatState,
+    sampled: OrbKind,
+    support: &[OrbKind],
+) -> OrbKind {
+    let Some(observations) = state.replay_observations.as_mut() else {
+        return sampled;
+    };
+    if observations.error.is_some() {
+        return sampled;
+    }
+    let Some(&kind) = observations.random_orbs.get(observations.orbs_consumed) else {
+        observations.error = Some("observed_random_orb_unwitnessed_extra_event");
+        return sampled;
+    };
+    if !support.contains(&kind) {
+        observations.error = Some("observed_random_orb_outside_positive_support");
+        return sampled;
+    }
+    observations.orbs_consumed += 1;
+    kind
+}
