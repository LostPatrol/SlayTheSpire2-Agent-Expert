+    /// Resolve a latent selected move through the chance-detected combat AI stream.
+    pub fn resolve_current_move_belief(&mut self, rng: &mut DotNetRng) -> bool {
+        let Some(alternatives) = self.current_ai_belief.take() else {
+            return false;
+        };
+        self.current_move_belief = None;
+        let total: f64 = alternatives.iter().map(|(_, weight)| weight).sum();
+        let roll = rng.next_float(total);
+        let mut cumulative = 0.0;
+        let mut selected = alternatives.last().expect("nonempty move belief").0.clone();
+        for (instance, weight) in alternatives {
+            cumulative += weight;
+            if roll < cumulative {
+                selected = instance;
+                break;
+            }
+        }
+        self.restore_instance_state(&selected);
+        true
+    }
