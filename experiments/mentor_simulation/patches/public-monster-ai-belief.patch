+    /// Attach conditional public probabilities without revealing a sampled current move.
+    pub fn set_current_move_belief(&mut self, alternatives: Vec<(StateId, f64)>) -> bool {
+        let alternatives = alternatives.into_iter().map(|(id, weight)| {
+            let mut ai = self.clone();
+            ai.current_move_belief = None;
+            ai.current_ai_belief = None;
+            ai.resume_ai_belief = None;
+            ai.set_current(id);
