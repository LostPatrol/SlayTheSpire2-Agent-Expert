+    /// Restore the concrete history sampled at a chance edge without firing move effects.
+    fn restore_instance_state(&mut self, instance: &MonsterAiInstanceState) {
+        self.set_current(instance.current);
+        self.state_log.clone_from(&instance.state_log);
+        self.performed_first_move = instance.performed_first_move;
+        self.initial_resolved = instance.initial_resolved;
+        self.performed_at_least_once = instance.performed_at_least_once;
+        self.owner_uid = instance.owner_uid;
+        self.counter = instance.counter;
+        self.forced_next_state = instance.forced_next_state;
+        self.slot = instance.slot;
+    }
