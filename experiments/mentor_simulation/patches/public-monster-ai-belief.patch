@@ -0,0 +1,163 @@
+//! Publicly indistinguishable enemy moves remain weighted chance until execution.
+use smallvec::smallvec;
+use std::collections::BTreeMap;
+use sts2_core::monster_ai::{MonsterAi, MonsterState, MoveState};
+use sts2_core::{CombatPhase, CombatState, CreatureUid, DotNetRng, Intent, MonsterKind};
+
+/// Give the two indistinguishable moves observably different settlement effects.
+fn heal_one(state: &mut CombatState, _: CreatureUid) {
+    state.player.current_hp += 1;
+}
+
+/// Give the second move a distinct settlement effect without changing its telegraph.
+fn heal_three(state: &mut CombatState, _: CreatureUid) {
+    state.player.current_hp += 3;
+}
+
+/// Build an ambiguous telegraph with unequal public probabilities.
+fn ambiguous_ai() -> MonsterAi {
+    let mut states = BTreeMap::new();
+    for (id, effect) in [
+        ("A", heal_one as fn(&mut CombatState, CreatureUid)),
+        ("B", heal_three as fn(&mut CombatState, CreatureUid)),
+    ] {
+        states.insert(id, MonsterState::Move(MoveState {
+            id, effect, intents: smallvec![Intent::Heal],
+            follow_up: Some(id), must_perform_once: false,
+        }));
+    }
+    let mut ai = MonsterAi::new(states, "A");
+    assert!(ai.set_current_move_belief(vec![("A", 1.0), ("B", 3.0)]));
+    ai
+}
+
+/// Selection consumes exactly one chance-visible AI draw and preserves unequal weights.
+#[test]
+fn latent_moves_follow_public_weights_and_resolve_once() {
+    let root = ambiguous_ai();
+    let mut selected_b = 0;
+    // A broad finite seed panel catches uniform selection without asserting exact frequencies.
+    for seed in 0..4096 {
+        let mut ai = root.clone();
+        let mut rng = DotNetRng::new(seed);
+        assert_eq!(rng.counter(), 0);
+        assert!(ai.resolve_current_move_belief(&mut rng));
+        assert_eq!(rng.counter(), 1);
+        selected_b += usize::from(ai.current_state_id() == "B");
+        assert!(ai.current_move_belief().is_none());
+        assert!(!ai.resolve_current_move_belief(&mut rng));
+        assert_eq!(rng.counter(), 1);
+    }
+    assert!((2800..3350).contains(&selected_b), "weighted B count: {selected_b}");
+    assert!(root.current_move_belief().is_some());
+}
+
+/// A public phase override replaces the latent move rather than resurrecting it later.
+#[test]
+fn explicit_move_override_clears_latent_moves_without_rng() {
+    let mut ai = ambiguous_ai();
+    ai.force_current_state("A");
+    let mut rng = DotNetRng::new(0);
+    assert!(!ai.resolve_current_move_belief(&mut rng));
+    assert_eq!(rng.counter(), 0);
+    assert_eq!(ai.current_state_id(), "A");
+}
+
+/// Equal current moves must not collapse distinct repeat histories or private counters.
+#[test]
+fn latent_histories_restore_the_sampled_instance_state() {
+    let mut first = ambiguous_ai();
+    first.force_current_state("A");
+    assert!(first.restore_move_history(&["A".into()]));
+    first.set_counter(7);
+    let mut second = first.clone();
+    assert!(second.restore_move_history(&["B".into(), "B".into()]));
+    second.set_counter(19);
+    let mut root = first.clone();
+    assert!(root.set_current_ai_belief(vec![(first, 1.0), (second, 1.0)]));
+    assert_eq!(root.current_ai_belief().unwrap().len(), 2);
+    let mut seen = std::collections::BTreeSet::new();
+    for seed in 0..32 {
+        let mut ai = root.clone();
+        ai.resolve_current_move_belief(&mut DotNetRng::new(seed));
+        seen.insert((ai.counter(), ai.move_history().to_vec()));
+    }
+    assert_eq!(seen, [(7, vec!["A"]), (19, vec!["B", "B"])].into_iter().collect());
+}
+
+/// A stun postpones the original uncertain move without choosing a history at import time.
+#[test]
+fn stun_resumes_the_original_latent_move() {
+    let mut ai = ambiguous_ai();
+    std::sync::Arc::make_mut(&mut ai.states).insert("S", MonsterState::Move(MoveState {
+        id:"S", effect:heal_one, intents:smallvec![Intent::Stun],
+        follow_up:Some("A"), must_perform_once:true,
+    }));
+    assert!(ai.stun_immediate("S", None));
+    assert_eq!(ai.current_state_id(), "S");
+    assert!(ai.current_ai_belief().is_none());
+    let mut rng = DotNetRng::new(0);
+    ai.on_move_performed();
+    ai.roll_move(&mut rng);
+    assert_eq!(rng.counter(), 0);
+    assert_eq!(ai.current_ai_belief().unwrap().len(), 2);
+    assert!(ai.resolve_current_move_belief(&mut rng));
+    assert_eq!(rng.counter(), 1);
+    assert_eq!(ai.move_history(), &["S"]);
+}
+
+/// Every search hash separates equal telegraphs with distinct histories and branch weights.
+#[test]
+fn semantic_hashes_include_history_counter_and_belief_weights() {
+    let mut state = CombatState::default();
+    let uid = state.spawn_enemy(MonsterKind::Nibbit);
+    let mut first = ambiguous_ai();
+    first.force_current_state("A");
+    first.set_owner(uid);
+    assert!(first.restore_move_history(&["A".into()]));
+    let mut second = first.clone();
+    assert!(second.restore_move_history(&["B".into()]));
+    second.set_counter(2);
+    let hashes = |ai: MonsterAi| {
+        let mut world = state.clone();
+        world.set_creature_ai(uid, ai);
+        (sts2_core::hashing::state_hash(&world),
+            sts2_core::hashing::search_hash(&world),
+            sts2_core::hashing::chance_outcome_hash(&world))
+    };
+    assert_ne!(hashes(first.clone()), hashes(second.clone()));
+    let mut left = first.clone();
+    assert!(left.set_current_ai_belief(vec![(first.clone(), 1.0), (second.clone(), 3.0)]));
+    let mut right = first.clone();
+    assert!(right.set_current_ai_belief(vec![(first, 3.0), (second, 1.0)]));
+    assert_ne!(hashes(left), hashes(right));
+}
+
+/// The actual enemy walk, rather than a standalone sampler, executes both latent bodies.
+#[test]
+fn enemy_execution_resolves_the_current_move_belief() {
+    let mut root = CombatState::default();
+    root.player.current_hp = 10;
+    root.player.max_hp = 50;
+    root.init_player_creature();
+    let uid = root.spawn_enemy(MonsterKind::Nibbit);
+    let mut ai = ambiguous_ai();
+    ai.set_owner(uid);
+    root.set_creature_ai(uid, ai);
+    let enemy = root.creatures.iter_mut().find(|c| c.id == uid.0).unwrap();
+    enemy.current_hp = 30;
+    enemy.max_hp = 30;
+    enemy.intent = Some(Intent::Heal);
+    root.phase = CombatPhase::EnemyTurnExec;
+    let mut observed = std::collections::BTreeSet::new();
+    for seed in 0..32 {
+        let mut state = root.clone();
+        state.run_rng.monster_ai = DotNetRng::new(seed);
+        sts2_core::combat_loop::enemy_turn_exec(&mut state);
+        observed.insert(state.player.current_hp);
+        assert_eq!(state.run_rng.monster_ai.counter(), 1);
+        assert!(state.creatures.iter().find(|c| c.id == uid.0).unwrap()
+            .ai.as_ref().unwrap().current_move_belief().is_none());
+    }
+    assert_eq!(observed, [11, 13].into_iter().collect());
+}
