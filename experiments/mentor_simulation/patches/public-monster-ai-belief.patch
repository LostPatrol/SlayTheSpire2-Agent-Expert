+            performed_first_move:self.performed_first_move, initial_resolved:self.initial_resolved,
+            performed_at_least_once:self.performed_at_least_once, owner_uid:self.owner_uid,
+            counter:self.counter, forced_next_state:self.forced_next_state, slot:self.slot }
+    }
