+    /// Hash runtime semantics without unstable code addresses or cached lookup indices.
+    pub fn hash_runtime_state<H: std::hash::Hasher>(&self, hasher: &mut H) {
+        self.initial.hash(hasher);
+        self.instance_state().hash(hasher);
+        for belief in [&self.current_ai_belief, &self.resume_ai_belief] {
+            belief.is_some().hash(hasher);
+            if let Some(alternatives) = belief {
+                alternatives.len().hash(hasher);
+                for (instance, weight) in alternatives {
+                    instance.hash(hasher);
+                    weight.to_bits().hash(hasher);
+                }
+            }
+        }
+        for (id, state) in self.states.iter() {
+            id.hash(hasher);
+            match state {
+                MonsterState::Move(movement) => {
+                    0_u8.hash(hasher);
+                    movement.intents.hash(hasher);
+                    movement.follow_up.hash(hasher);
+                    movement.must_perform_once.hash(hasher);
+                },
+                MonsterState::RandomBranch(branch) => {
+                    1_u8.hash(hasher);
+                    for entry in &branch.branches {
+                        entry.state_id.hash(hasher);
+                        entry.repeat_type.hash(hasher);
+                        entry.max_times.hash(hasher);
+                        entry.weight.to_bits().hash(hasher);
+                        entry.cooldown.hash(hasher);
+                    }
+                },
+                MonsterState::ConditionalBranch(branch) => {
+                    2_u8.hash(hasher);
+                    for entry in &branch.branches {
+                        std::mem::discriminant(&entry.condition).hash(hasher);
+                        entry.state_id.hash(hasher);
+                    }
+                },
+            }
+        }
     }
 
