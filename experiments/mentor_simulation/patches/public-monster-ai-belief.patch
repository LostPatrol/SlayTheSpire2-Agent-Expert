+    /// Reattach a postponed latent move when the stun's follow-up resumes it.
+    fn restore_resumed_belief(&mut self) {
+        if let Some(alternatives) = self.resume_ai_belief.take() {
+            self.restore_instance_state(&alternatives[0].0);
+            self.current_move_belief = Some(alternatives.iter()
+                .map(|(instance, weight)| (instance.current, *weight)).collect());
+            self.current_ai_belief = Some(alternatives);
