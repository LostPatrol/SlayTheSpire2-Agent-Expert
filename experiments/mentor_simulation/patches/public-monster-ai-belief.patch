+        }).collect();
+        self.set_current_ai_belief(alternatives)
+    }
+
+    /// Preserve weighted current moves and distinct histories without sampling at import time.
+    pub fn set_current_ai_belief(&mut self, alternatives: Vec<(Self, f64)>) -> bool {
+        let mut merged: Vec<(MonsterAiInstanceState, f64)> = Vec::new();
+        for (ai, weight) in alternatives {
+            if !weight.is_finite() || weight <= 0.0 || ai.current_ai_belief.is_some()
+                || ai.resume_ai_belief.is_some()
+                || !self.states.get(ai.current).is_some_and(MonsterState::is_move)
+            {
+                return false;
+            }
+            let instance = ai.instance_state();
+            if let Some((_, previous)) = merged.iter_mut().find(|(saved, _)| *saved == instance) {
+                *previous += weight;
+            } else {
+                merged.push((instance, weight));
+            }
+        }
+        let total: f64 = merged.iter().map(|(_, weight)| weight).sum();
+        if merged.is_empty() || !total.is_finite() || total <= 0.0 { return false; }
+        merged.sort_by_cached_key(|(instance, _)| format!("{instance:?}"));
+        for (_, weight) in &mut merged { *weight /= total; }
+        self.restore_instance_state(&merged[0].0);
+        self.resume_ai_belief = None;
+        self.current_move_belief = (merged.len() > 1).then(|| merged.iter()
+            .map(|(instance, weight)| (instance.current, *weight)).collect());
+        self.current_ai_belief = (merged.len() > 1).then_some(merged);
+        true
+    }
+
