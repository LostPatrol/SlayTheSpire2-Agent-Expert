+//! Public combat-history recording through real card dispatch and the content factory.
+//! Recording is diagnostic only; metadata uses completed iteration tokens, not rule counters.
+
+use sts2_content::{cards::dispatch, monster_dispatch::MonsterSpawnArgs};
+use sts2_core::cards::{Card, CardId, CardType, TargetType};
+use sts2_core::potions::CharacterId;
+use sts2_core::runstate::{RoomType, RunState};
+use sts2_core::{CardUid, CombatState, MonsterKind, PowerKind};
+
+/// Build the same combat with recording on or off before its initial hooks and hand draw.
+fn factory(record: bool) -> CombatState {
+    dispatch::ensure_installed();
+    let mut run = RunState {
+        character_id: CharacterId::Ironclad,
+        current_hp: 80,
+        max_hp: 80,
+        record_public_combat_history: record,
+        ..RunState::default()
+    };
+    sts2_content::run_callbacks::populate_starter_deck(&mut run, CharacterId::Ironclad);
+    sts2_content::run_bridge::enter_combat_from_roster(
+        &run,
+        &[(MonsterKind::Nibbit, MonsterSpawnArgs::None, 9999)],
+        RoomType::Monster,
+    )
+}
+
+/// Keep a live opponent while controlling the actual played and auto-played instances.
+fn fixture() -> CombatState {
+    let mut state = factory(true);
+    state.player.hand.clear();
+    state.player.draw.clear();
+    state.player.discard.clear();
+    state.player.energy = 20;
+    state
+}
+
+/// Add one real skill instance, with replay metadata consumed by the original dispatcher.
+fn skill(state: &mut CombatState, id: CardId, replay: i32) -> CardUid {
+    let uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    state.cards.push(Card {
+        uid,
+        card_id: id,
+        cost: 0,
+        card_type: CardType::Skill,
+        target_type: TargetType::Self_,
+        base_block: 5,
+        base_replay_count: replay,
+        ..Card::pod_defaults()
+    });
+    uid
+}
+
+/// Insert a registered card without replacing its actual resource rules.
+fn real_card(state: &mut CombatState, id: CardId, pile: sts2_core::cards::PileKind) -> CardUid {
+    let mut card = sts2_content::cards::spec_index::card_pod_from_id(id, false).unwrap();
+    card.uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+    let uid = card.uid;
+    state.cards.push(card);
+    match pile {
+        sts2_core::cards::PileKind::Hand => state.player.hand.push(uid),
+        sts2_core::cards::PileKind::Draw => state.player.draw.push(uid),
+        _ => panic!("fixture uses only Hand or Draw"),
+    }
+    uid
+}
+
+/// Finished replays retain ResourceInfo quotes, while the real energy-spent history records one payment.
+#[test]
+fn public_history_resources_manual_echo_are_immutable_quotes_not_repeated_payments() {
+    let mut state = fixture();
+    let owner = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, owner, PowerKind::EchoForm, 1);
+    let uid = real_card(
+        &mut state,
+        CardId::DefendIronclad,
+        sts2_core::cards::PileKind::Hand,
+    );
+    let mut unrecorded = state.clone();
+    unrecorded.combat_log.event_log.disarm_for_search();
+    let energy = state.player.energy;
+    let action = sts2_core::Action::PlayCard {
+        hand_index: 0,
+        target: None,
+    };
+    sts2_core::apply(&mut state, action.clone());
+    sts2_core::apply(&mut unrecorded, action);
+    assert_eq!(state, unrecorded);
+    assert_eq!(state.player.energy, energy - 1);
+    assert_eq!(state.combat_log.energy_spent_this_turn, 1);
+    let history = state.combat_log.event_log.public_history().unwrap();
+    assert_eq!(history.plays.len(), 2);
+    for play in &history.plays {
+        assert_eq!(
+            (
+                play.was_ethereal,
+                play.energy_value,
+                play.energy_spent,
+                play.stars_spent
+            ),
+            (Some(false), Some(1), Some(1), Some(0))
+        );
+    }
+    let saved = history.plays.clone();
+    state.cards[uid.get() as usize - 1].cost = 9;
