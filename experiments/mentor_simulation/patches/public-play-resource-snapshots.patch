+/// Build a small real Tyranny turn: four old draw cards, then PF plus an ordinary refill draw.
+fn observed_refill_fixture() -> (CombatState, Vec<CardUid>) {
+    let mut state = fixture();
+    state.player.character = Some(CharacterId::Regent);
+    let mut add = |id, upgraded| {
+        let mut card = sts2_content::cards::spec_index::card_pod_from_id(id, upgraded).unwrap();
+        let uid = CardUid::new(state.cards.len() as u32 + 1).unwrap();
+        card.uid = uid;
+        state.cards.push(card);
+        uid
+    };
+    let old_hand = add(CardId::Venerate, false);
+    let old_draw = [
+        add(CardId::SovereignBlade, false),
+        add(CardId::FallingStar, false),
+        add(CardId::RefineBlade, true),
+        add(CardId::Bulwark, true),
+    ];
+    let photon = add(CardId::PhotonCut, true);
+    let ordinary = add(CardId::DefendRegent, false);
+    let other = add(CardId::Glow, true);
+    state.cards[photon.get() as usize - 1]
+        .set_enchantment(sts2_core::cards::EnchantmentId::PerfectFit, 1);
+    state.player.hand.push(old_hand);
+    state.player.draw.extend(old_draw.iter().rev().copied());
+    state.player.discard.extend([photon, ordinary, other]);
+    sts2_core::draw_knowledge::set_root_knowledge(
+        &mut state.player,
+        vec![old_draw.to_vec()],
+        vec![],
+        vec![vec![photon]],
+    )
+    .unwrap();
+    let player = state.player.creature_uid.unwrap();
+    sts2_core::card_effects::apply_power_to_creature(&mut state, player, PowerKind::Tyranny, 1);
+    let expected = old_draw.into_iter().chain([photon, ordinary]).collect();
+    (state, expected)
+}
