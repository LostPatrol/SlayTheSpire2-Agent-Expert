+/// Capture the play's resource quote and Ethereal snapshot before its effect can mutate the card.
+pub(crate) fn set_public_play_resources(
+    state: &mut crate::CombatState,
+    uid: CardUid,
+    was_ethereal: bool,
+    energy_value: i32,
+    energy_spent: i32,
+    stars_spent: i32,
+) {
+    let Some(history) = state.combat_log.event_log.public_history.as_mut() else {
+        return;
+    };
+    if let Some(play) = history.active.iter_mut().rfind(|play| play.card_uid == uid) {
+        play.was_ethereal = Some(was_ethereal);
+        play.energy_value = Some(energy_value);
+        play.energy_spent = Some(energy_spent);
+        play.stars_spent = Some(stars_spent);
+    } else {
+        history.complete = false;
+    }
+}
