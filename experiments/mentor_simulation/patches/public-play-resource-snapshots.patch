+/// Past Hatch results and observed card draws share one original EndTurn and unchanged RNG calls.
+#[test]
+fn observed_hatch_hp_composes_with_cross_refill_draws_and_preserves_other_state() {
+    let (before, draws, eggs) = observed_hatch_fixture();
+    let mut raw = before.clone();
+    sts2_core::draw_knowledge::apply_observed_draws(&mut raw, sts2_core::Action::EndTurn, &draws)
+        .unwrap();
+    assert_eq!(
+        raw.run_rng.niche.counter() - before.run_rng.niche.counter(),
+        3
+    );
+    let evidence: Vec<_> = eggs.iter().copied().zip([19, 20, 21]).collect();
+    let mut witnessed = before.clone();
+    sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut witnessed, &evidence, |state| {
+        sts2_core::draw_knowledge::apply_observed_draws(state, sts2_core::Action::EndTurn, &draws)
+    })
+    .unwrap();
+    for &(owner, hp) in &evidence {
+        let creature = raw.creatures.iter_mut().find(|c| c.id == owner.0).unwrap();
+        creature.current_hp = hp;
+        creature.max_hp = hp;
+    }
+    assert_eq!(
+        witnessed, raw,
+        "only the observed Hatch results may differ from ordinary sampling"
+    );
+    assert!(witnessed.replay_observations.is_none());
+    assert!(witnessed
+        .player
+        .draw_knowledge
+        .as_ref()
+        .unwrap()
+        .observed_draws
+        .is_none());
+}
