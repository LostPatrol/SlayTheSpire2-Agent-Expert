+    let mut rng = before.run_rng.niche.clone();
+    let natural: Vec<_> = eggs
+        .iter()
+        .copied()
+        .map(|owner| (owner, rng.next_int_exclusive(19, 22)))
+        .collect();
+    let mut raw = before.clone();
+    sts2_core::draw_knowledge::apply_observed_draws(&mut raw, sts2_core::Action::EndTurn, &draws)
+        .unwrap();
+    for &(owner, hp) in &natural {
+        let creature = raw.creatures.iter().find(|c| c.id == owner.0).unwrap();
+        assert_eq!((creature.current_hp, creature.max_hp), (hp, hp));
+    }
+    let mut observed = before.clone();
+    sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut observed, &natural, |state| {
+        sts2_core::draw_knowledge::apply_observed_draws(state, sts2_core::Action::EndTurn, &draws)
+    })
+    .unwrap();
+    assert_eq!(observed, raw);
+    before.game_version = V0_111_0;
+    let evidence: Vec<_> = eggs.into_iter().map(|owner| (owner, 22)).collect();
+    sts2_core::witnessed_outcomes::with_observed_hatch_hp(&mut before, &evidence, |state| {
+        sts2_core::draw_knowledge::apply_observed_draws(state, sts2_core::Action::EndTurn, &draws)
+    })
+    .unwrap();
+    assert!(before.replay_observations.is_none());
+}
